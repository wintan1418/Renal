<% content_for(:title) { "Dr. #{@doctor.full_name}" } %>
<% content_for(:meta_description) { "Dr. #{@doctor.full_name} - #{@profile&.specialization || 'Nephrologist'} at Healthroom Renal Centre." } %>

<%
  doctor_photos = [
    "https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=400&h=500&fit=crop&q=80",
    "https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=400&h=500&fit=crop&q=80",
    "https://images.unsplash.com/photo-1622253694242-abeb37a33e97?w=400&h=500&fit=crop&q=80",
    "https://images.unsplash.com/photo-1594824476967-48c8b964ac31?w=400&h=500&fit=crop&q=80"
  ]
  photo_index = @doctor.id.to_i % doctor_photos.length
%>

<!-- Page Header -->
<section class="hr-page-header" style="padding: 5rem 0 4rem">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="breadcrumbs-text mb-6">
      <%= link_to "Home", root_path %> &nbsp;/&nbsp; <%= link_to "Our Doctors", doctors_path %> &nbsp;/&nbsp; <span class="text-white font-medium">Dr. <%= @doctor.full_name %></span>
    </div>

    <div class="flex flex-col md:flex-row gap-8 items-center">
      <!-- Photo -->
      <div class="shrink-0">
        <div class="w-36 h-36 rounded-2xl overflow-hidden shadow-2xl" style="border: 3px solid rgba(43,139,117,0.4)">
          <% if @doctor.avatar.attached? %>
            <%= image_tag @doctor.avatar.variant(resize_to_limit: [200, 200]), class: "w-full h-full object-cover", alt: @doctor.full_name %>
          <% else %>
            <img src="<%= doctor_photos[photo_index] %>" alt="Dr. <%= @doctor.full_name %>" class="w-full h-full object-cover" />
          <% end %>
        </div>
      </div>

      <!-- Doctor Info -->
      <div class="flex-1 text-center md:text-left">
        <h1>Dr. <%= @doctor.full_name %></h1>

        <% if @profile %>
          <% if @profile.specialization.present? %>
            <p class="text-xl font-medium mt-3" style="color: var(--hr-teal-light)"><%= @profile.specialization %></p>
          <% end %>

          <div class="flex flex-wrap gap-3 mt-5 justify-center md:justify-start">
            <% if @profile.department %>
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm text-white" style="background: rgba(255,255,255,0.1)">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                <%= @profile.department.name %>
              </div>
            <% end %>
            <% if @profile.years_of_experience %>
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm text-white" style="background: rgba(255,255,255,0.1)">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <%= @profile.years_of_experience %> years experience
              </div>
            <% end %>
            <% if @profile.available_for_telemedicine? %>
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm" style="background: rgba(34,197,94,0.15); color: #86efac">
                <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                Telemedicine Available
              </div>
            <% end %>
            <% if @profile.license_number.present? %>
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm text-white" style="background: rgba(255,255,255,0.1)">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                Licensed
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Doctor Details -->
<section class="py-16 lg:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-10">
        <% if @profile&.bio.present? %>
          <div>
            <span class="hr-section-label">— Biography</span>
            <h2 class="text-2xl hr-section-title mt-2 mb-4">About Dr. <%= @doctor.full_name %></h2>
            <div class="prose prose-lg max-w-none text-gray-500 leading-relaxed">
              <%= simple_format(@profile.bio) %>
            </div>
          </div>
        <% else %>
          <div>
            <span class="hr-section-label">— Biography</span>
            <h2 class="text-2xl hr-section-title mt-2 mb-4">About Dr. <%= @doctor.full_name %></h2>
            <p class="text-gray-500 text-lg leading-relaxed">
              Dr. <%= @doctor.full_name %> is a dedicated medical professional at Healthroom Renal Centre,
              committed to providing excellent kidney care to patients. With extensive training and
              experience in nephrology, Dr. <%= @doctor.last_name %> brings both expertise and compassion
              to every patient interaction.
            </p>
          </div>
        <% end %>

        <% if @profile&.qualification.present? %>
          <div>
            <span class="hr-section-label">— Education</span>
            <h2 class="text-2xl hr-section-title mt-2 mb-4">Qualifications</h2>
            <div class="rounded-2xl p-8" style="background-color: var(--hr-cream)">
              <div class="prose prose-lg max-w-none text-gray-500">
                <%= simple_format(@profile.qualification) %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Consultation Fee Card -->
        <div class="hr-card">
          <h3 class="font-bold text-lg mb-4" style="color: var(--hr-navy)">Consultation Details</h3>
          <div style="border-top: 1px solid #f0f0f0" class="mb-3"></div>

          <% if @profile&.consultation_fee_cents && @profile.consultation_fee_cents > 0 %>
            <div class="flex justify-between items-center py-3">
              <span class="text-gray-500">Consultation Fee</span>
              <span class="font-extrabold text-xl" style="color: var(--hr-teal)"><%= format_naira(@profile.consultation_fee_cents) %></span>
            </div>
          <% end %>

          <% if @profile&.department %>
            <div class="flex justify-between items-center py-3">
              <span class="text-gray-500">Department</span>
              <span class="font-medium" style="color: var(--hr-navy)"><%= @profile.department.name %></span>
            </div>
          <% end %>

          <% if @profile&.specialization.present? %>
            <div class="flex justify-between items-center py-3">
              <span class="text-gray-500">Specialization</span>
              <span class="font-medium" style="color: var(--hr-navy)"><%= @profile.specialization %></span>
            </div>
          <% end %>

          <% if @profile&.years_of_experience %>
            <div class="flex justify-between items-center py-3">
              <span class="text-gray-500">Experience</span>
              <span class="font-medium" style="color: var(--hr-navy)"><%= @profile.years_of_experience %> years</span>
            </div>
          <% end %>

          <div class="mt-6">
            <%= link_to contact_path, class: "btn btn-lg btn-block hr-btn-orange rounded-xl font-semibold gap-2 shadow-lg" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              Book Appointment
            <% end %>
          </div>
        </div>

        <!-- Contact Card -->
        <div class="hr-card">
          <h3 class="font-bold text-lg mb-2" style="color: var(--hr-navy)">Need Help?</h3>
          <p class="text-gray-500 text-sm">
            Contact us to schedule an appointment with Dr. <%= @doctor.last_name %>.
          </p>
          <div class="space-y-3 mt-5">
            <a href="tel:<%= current_hospital.phone.presence || '+2348000000000' %>" class="btn btn-block hr-btn-outline-teal rounded-xl gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              Call Us
            </a>
            <%= link_to contact_path, class: "btn btn-block rounded-xl gap-2 border-gray-200 bg-transparent text-gray-600 hover:bg-gray-50" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              Send a Message
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Back link -->
    <div class="mt-12">
      <%= link_to doctors_path, class: "inline-flex items-center gap-2 text-sm font-semibold transition-all hover:gap-3", style: "color: var(--hr-teal)" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Back to All Doctors
      <% end %>
    </div>
  </div>
</section>
