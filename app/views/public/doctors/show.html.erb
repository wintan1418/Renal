<% content_for(:title) { "Dr. #{@doctor.full_name}" } %>
<% content_for(:meta_description) { "Dr. #{@doctor.full_name} - #{@profile&.specialization || 'Nephrologist'} at Healthroom Renal Centre." } %>

<div class="mk-pg">
  <section class="mk-section--cream" style="border-top:none;padding:48px 0 56px">
    <div class="mk-wrap">
      <div style="font-size:13px;color:var(--mk-muted-2);margin-bottom:24px">
        <%= link_to "Home", root_path, style: "color:var(--mk-muted-2);text-decoration:none" %> &nbsp;/&nbsp;
        <%= link_to "Our Doctors", doctors_path, style: "color:var(--mk-muted-2);text-decoration:none" %> &nbsp;/&nbsp;
        <span style="color:var(--mk-ink);font-weight:600">Dr. <%= @doctor.full_name %></span>
      </div>
      <div class="mk-two-col" style="display:grid;grid-template-columns:280px 1fr;gap:36px;align-items:center">
        <%= image_tag doctor_photo_for(@doctor), alt: @doctor.full_name, style: "width:100%;height:320px;object-fit:cover;border-radius:22px" %>
        <div>
          <h1 class="mk-h2">Dr. <%= @doctor.full_name %></h1>
          <p style="font-size:17px;color:var(--mk-teal);font-weight:600;margin-top:6px"><%= doctor_specialty(@doctor) %></p>
          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:18px">
            <% if @profile&.department %><span class="mk-chip" style="cursor:default"><%= @profile.department.name %></span><% end %>
            <% if @profile&.years_of_experience %><span class="mk-chip" style="cursor:default"><%= @profile.years_of_experience %> years experience</span><% end %>
            <% if @profile&.available_for_telemedicine? %><span class="mk-chip" style="cursor:default;border-color:var(--mk-teal);color:var(--mk-teal-ink)">● Telemedicine available</span><% end %>
          </div>
          <button class="mk-btn mk-btn--cta mk-btn--lg" style="margin-top:24px" data-action="marketing-booking#open">Book with Dr. <%= @doctor.last_name %></button>
        </div>
      </div>
    </div>
  </section>

  <section class="mk-section" style="padding:64px 0">
    <div class="mk-wrap mk-two-col" style="display:grid;grid-template-columns:1.6fr 1fr;gap:40px;align-items:start">
      <div>
        <div class="mk-eyebrow">— Biography</div>
        <h2 class="mk-h3" style="font-size:24px;margin-bottom:12px">About Dr. <%= @doctor.full_name %></h2>
        <div style="font-size:16px;line-height:1.75;color:var(--mk-muted)">
          <% if @profile&.bio.present? %>
            <%= simple_format(@profile.bio) %>
          <% else %>
            <p>Dr. <%= @doctor.full_name %> is a dedicated specialist at Healthroom Renal Centre, committed to providing excellent kidney care. With extensive training and experience in nephrology, Dr. <%= @doctor.last_name %> brings both expertise and compassion to every patient interaction.</p>
          <% end %>
        </div>
        <% if @profile&.qualification.present? %>
          <div class="mk-eyebrow" style="margin-top:36px">— Education</div>
          <h2 class="mk-h3" style="font-size:24px;margin-bottom:12px">Qualifications</h2>
          <div class="mk-card mk-card--pad" style="background:var(--mk-cream);border:none">
            <div style="font-size:15px;line-height:1.7;color:var(--mk-muted)"><%= simple_format(@profile.qualification) %></div>
          </div>
        <% end %>
      </div>

      <div class="mk-card mk-card--pad" style="position:sticky;top:96px">
        <h3 class="mk-h3" style="font-size:18px;margin-bottom:16px">Consultation details</h3>
        <% if @profile&.consultation_fee_cents.to_i.positive? %>
          <div style="display:flex;justify-content:space-between;padding:11px 0;border-top:1px solid var(--mk-line)"><span style="color:var(--mk-muted)">Consultation fee</span><span style="font-weight:800;color:var(--mk-teal);font-family:var(--mk-display)"><%= format_naira(@profile.consultation_fee_cents) %></span></div>
        <% end %>
        <% if @profile&.department %><div style="display:flex;justify-content:space-between;padding:11px 0;border-top:1px solid var(--mk-line)"><span style="color:var(--mk-muted)">Department</span><span style="font-weight:600;color:var(--mk-ink)"><%= @profile.department.name %></span></div><% end %>
        <% if @profile&.years_of_experience %><div style="display:flex;justify-content:space-between;padding:11px 0;border-top:1px solid var(--mk-line)"><span style="color:var(--mk-muted)">Experience</span><span style="font-weight:600;color:var(--mk-ink)"><%= @profile.years_of_experience %> years</span></div><% end %>
        <button class="mk-btn mk-btn--cta mk-btn--block" style="margin-top:18px" data-action="marketing-booking#open">Book appointment</button>
        <%= link_to "Call us now", contact_path, class: "mk-btn mk-btn--outline mk-btn--block", style: "margin-top:10px" %>
      </div>
    </div>
    <div class="mk-wrap" style="margin-top:24px">
      <%= link_to "← Back to all doctors", doctors_path, style: "color:var(--mk-teal);font-weight:600;text-decoration:none;font-size:14px" %>
    </div>
  </section>
</div>
