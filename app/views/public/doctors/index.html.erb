<% content_for(:title) { "Our Doctors" } %>
<% content_for(:meta_description) { "Meet the expert nephrologists and specialists at Healthroom Renal Centre dedicated to your kidney health." } %>

<div class="mk-pg" data-controller="marketing-filter">
  <section class="mk-section--cream" style="border-top:none;padding:72px 0 64px">
    <div class="mk-wrap" style="text-align:center">
      <div class="mk-eyebrow">— Our team</div>
      <h1 class="mk-h1">Meet your specialists</h1>
      <p class="mk-lead" style="margin:18px auto 0;max-width:560px">A multidisciplinary team of nephrologists, dialysis experts and renal dietitians.</p>
    </div>
  </section>

  <section class="mk-section" style="padding-top:40px">
    <div class="mk-wrap">
      <% specs = ["All"] + @doctors.map { |d| doctor_specialty(d) }.uniq %>
      <div class="mk-chips" style="margin-bottom:44px">
        <% specs.each_with_index do |c, i| %>
          <button class="mk-chip <%= 'is-active' if i.zero? %>" data-filter="<%= c %>" data-action="marketing-filter#filter" data-marketing-filter-target="chip"><%= c %></button>
        <% end %>
      </div>

      <div class="mk-grid mk-grid--3" style="gap:24px">
        <% @doctors.each_with_index do |d, i| %>
          <div class="mk-card mk-card--hover" data-category="<%= doctor_specialty(d) %>" data-marketing-filter-target="item" style="overflow:hidden">
            <%= link_to doctor_path(d), style: "text-decoration:none;display:block" do %>
              <%= image_tag doctor_photo(i), alt: d.full_name, loading: "lazy", class: "mk-card__media", style: "height:280px" %>
            <% end %>
            <div style="padding:22px 22px 24px">
              <%= link_to doctor_path(d), style: "text-decoration:none" do %>
                <div class="mk-h3" style="font-size:19px">Dr. <%= d.full_name %></div>
              <% end %>
              <div style="font-size:14px;color:var(--mk-teal);font-weight:600;margin-top:3px"><%= doctor_specialty(d) %></div>
              <div style="display:flex;align-items:center;gap:6px;margin-top:10px"><span class="mk-stars">★★★★★</span><span style="font-size:12.5px;color:var(--mk-muted-2);font-weight:600"><%= doctor_rating(d) %></span></div>
              <p style="font-size:13.5px;line-height:1.55;color:var(--mk-muted);margin-top:14px"><%= d.staff_profile&.bio.presence&.truncate(110) || "Dedicated specialist providing expert, compassionate renal care at Healthroom." %></p>
              <button class="mk-btn mk-btn--teal mk-btn--block" style="margin-top:18px" data-action="marketing-booking#open">Book with Dr. <%= d.last_name %></button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</div>
