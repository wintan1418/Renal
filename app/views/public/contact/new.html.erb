<% content_for(:title) { "Contact Us" } %>
<% content_for(:meta_description) { "Get in touch with Healthroom Renal Centre. Book an appointment, ask a question, or find our location in Nigeria." } %>

<div class="mk-pg">
  <section class="mk-section" style="padding:72px 0 56px">
    <div class="mk-wrap" style="text-align:center;margin-bottom:8px">
      <div class="mk-eyebrow">— Contact</div>
      <h1 class="mk-h1">Get in touch</h1>
      <p class="mk-lead" style="margin:18px auto 0;max-width:520px">Have a question or want to book? Reach out — our team responds within one working day.</p>
    </div>
  </section>

  <section style="padding:0 0 96px">
    <div class="mk-wrap mk-two-col" style="display:grid;grid-template-columns:0.85fr 1.15fr;gap:40px;align-items:start">
      <!-- info -->
      <div style="display:flex;flex-direction:column;gap:14px">
        <% [
          { icon: :pin, label: "Visit Us", value: (current_hospital.address.presence || "15 Medical Drive, Victoria Island") },
          { icon: :phone, label: "Call Us", value: (current_hospital.phone.presence || "+234 800 HEALTH") },
          { icon: :mail, label: "Email Us", value: (current_hospital.email.presence || "info@healthroom.ng") },
          { icon: :clock, label: "Hours", value: "Mon – Sat: 8:00 AM – 6:00 PM" }
        ].each do |c| %>
          <div style="display:flex;align-items:center;gap:16px;background:var(--mk-cream);border:1px solid var(--mk-cream-line);border-radius:16px;padding:20px 22px">
            <span style="width:48px;height:48px;border-radius:13px;background:#fff;border:1px solid var(--mk-line);display:flex;align-items:center;justify-content:center;flex-shrink:0"><%= mk_icon c[:icon], size: 22, stroke: "var(--mk-teal)", width: 2 %></span>
            <div><div style="font-size:12.5px;color:var(--mk-muted-2)"><%= c[:label] %></div><div style="font-size:16px;font-weight:600;color:var(--mk-ink);margin-top:2px"><%= c[:value] %></div></div>
          </div>
        <% end %>
        <div style="width:100%;height:180px;border-radius:16px;background:linear-gradient(135deg, oklch(0.42 0.09 162), var(--mk-navy));display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.85);font-weight:600;gap:8px">
          <%= mk_icon :pin, size: 22, stroke: "#fff", width: 2 %> Victoria Island, Lagos
        </div>
      </div>

      <!-- form -->
      <div class="mk-card" style="padding:32px;box-shadow:0 18px 50px -28px rgba(20,40,30,.25)">
        <div style="font-family:var(--mk-display);font-weight:700;font-size:20px;color:var(--mk-ink);margin-bottom:20px">Send us a message</div>
        <%= form_with model: @contact, url: contact_path do |f| %>
          <% if @contact.errors.any? %>
            <div style="background:oklch(0.97 0.04 25);border:1px solid oklch(0.85 0.08 25);border-radius:12px;padding:14px 16px;margin-bottom:16px">
              <p style="font-weight:600;font-size:14px;color:var(--mk-error,#DC2626)">Please correct the following:</p>
              <ul style="list-style:disc;margin:6px 0 0 18px;font-size:13px;color:#b91c1c"><% @contact.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
            </div>
          <% end %>
          <div style="display:grid;gap:16px">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <div><label class="mk-label">Name *</label><%= f.text_field :name, class: "mk-input", placeholder: "Your name", required: true %></div>
              <div><label class="mk-label">Phone</label><%= f.telephone_field :phone, class: "mk-input", placeholder: "+234 ..." %></div>
            </div>
            <div><label class="mk-label">Email *</label><%= f.email_field :email, class: "mk-input", placeholder: "you@email.com", required: true %></div>
            <div><label class="mk-label">Subject</label><%= f.text_field :subject, class: "mk-input", placeholder: "How can we help?" %></div>
            <div><label class="mk-label">Message *</label><%= f.text_area :message, class: "mk-textarea", placeholder: "How can we help?", required: true %></div>
            <%= f.submit "Send message", class: "mk-btn mk-btn--cta mk-btn--block mk-btn--lg" %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</div>
