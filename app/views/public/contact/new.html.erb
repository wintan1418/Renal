<% content_for(:title) { "Contact Us" } %>
<% content_for(:meta_description) { "Get in touch with Healthroom Renal Centre. Book an appointment, ask a question, or find our location in Nigeria." } %>

<!-- Page Header -->
<section class="hr-page-header">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl">
      <div class="breadcrumbs-text mb-4">
        <%= link_to "Home", root_path %> &nbsp;/&nbsp; <span class="text-white font-medium">Contact Us</span>
      </div>
      <h1>Contact Us</h1>
      <p class="text-lg mt-4 leading-relaxed max-w-xl">
        Have a question or ready to book an appointment? We are here to help.
        Reach out to us through any of the channels below.
      </p>
    </div>
  </div>
</section>

<!-- Contact Content -->
<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">

      <!-- Contact Form -->
      <div class="lg:col-span-2">
        <div class="hr-card" style="padding: 2rem">
          <h2 class="text-xl font-bold mb-1" style="color: var(--hr-navy)">Send Us a Message</h2>
          <p class="text-sm text-gray-400 mb-6">Fill in the form below and we will get back to you as soon as possible.</p>

          <%= form_with model: @contact, url: contact_path, class: "space-y-5" do |f| %>
            <% if @contact.errors.any? %>
              <div class="rounded-xl p-4" style="background: rgba(220,38,38,0.06); border: 1px solid rgba(220,38,38,0.15)">
                <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mt-0.5 shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <div>
                    <p class="font-semibold text-sm text-red-600">Please correct the following errors:</p>
                    <ul class="list-disc list-inside text-sm mt-1 text-red-500">
                      <% @contact.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            <% end %>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Name -->
              <div>
                <label class="block text-sm font-medium mb-1.5" style="color: var(--hr-navy)">Full Name <span class="text-red-500">*</span></label>
                <%= f.text_field :name, class: "hr-input w-full #{@contact.errors[:name].any? ? 'border-red-400' : ''}", placeholder: "Your full name", required: true %>
                <% if @contact.errors[:name].any? %>
                  <p class="text-xs text-red-500 mt-1"><%= @contact.errors[:name].first %></p>
                <% end %>
              </div>

              <!-- Email -->
              <div>
                <label class="block text-sm font-medium mb-1.5" style="color: var(--hr-navy)">Email Address <span class="text-red-500">*</span></label>
                <%= f.email_field :email, class: "hr-input w-full #{@contact.errors[:email].any? ? 'border-red-400' : ''}", placeholder: "your@email.com", required: true %>
                <% if @contact.errors[:email].any? %>
                  <p class="text-xs text-red-500 mt-1"><%= @contact.errors[:email].first %></p>
                <% end %>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Phone -->
              <div>
                <label class="block text-sm font-medium mb-1.5" style="color: var(--hr-navy)">Phone Number</label>
                <%= f.telephone_field :phone, class: "hr-input w-full", placeholder: "+234 800 000 0000" %>
              </div>

              <!-- Subject -->
              <div>
                <label class="block text-sm font-medium mb-1.5" style="color: var(--hr-navy)">Subject</label>
                <%= f.text_field :subject, class: "hr-input w-full", placeholder: "How can we help?" %>
              </div>
            </div>

            <!-- Message -->
            <div>
              <label class="block text-sm font-medium mb-1.5" style="color: var(--hr-navy)">Message <span class="text-red-500">*</span></label>
              <%= f.text_area :message, class: "hr-input w-full h-36 resize-none #{@contact.errors[:message].any? ? 'border-red-400' : ''}", placeholder: "Tell us about your inquiry, symptoms, or questions...", required: true %>
              <% if @contact.errors[:message].any? %>
                <p class="text-xs text-red-500 mt-1"><%= @contact.errors[:message].first %></p>
              <% end %>
            </div>

            <!-- Submit -->
            <div class="flex items-center justify-between pt-2">
              <p class="text-xs text-gray-400">
                <span class="text-red-500">*</span> Required fields
              </p>
              <%= f.submit "Send Message", class: "btn hr-btn-teal rounded-xl font-semibold gap-2" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Contact Info Sidebar -->
      <div class="space-y-6">
        <!-- Address Card -->
        <div class="hr-card">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(43,139,117,0.1)">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--hr-teal)">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="font-bold" style="color: var(--hr-navy)">Our Address</h3>
          </div>
          <p class="text-sm text-gray-500 leading-relaxed">
            <%= current_hospital.address.presence || "Lagos, Nigeria" %>
            <% if current_hospital.city.present? || current_hospital.state.present? %>
              <br><%= [current_hospital.city, current_hospital.state].compact.join(", ") %>
            <% end %>
          </p>
        </div>

        <!-- Phone Card -->
        <div class="hr-card">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(43,139,117,0.1)">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--hr-teal)">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h3 class="font-bold" style="color: var(--hr-navy)">Phone</h3>
          </div>
          <p class="text-sm text-gray-500">
            <a href="tel:<%= current_hospital.phone.presence || '+2348000000000' %>" class="transition-colors" style="color: var(--hr-teal)">
              <%= current_hospital.phone.presence || "+234 800 000 0000" %>
            </a>
          </p>
          <p class="text-xs text-gray-400 mt-1">For emergencies, call us directly.</p>
        </div>

        <!-- Email Card -->
        <div class="hr-card">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(43,139,117,0.1)">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--hr-teal)">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="font-bold" style="color: var(--hr-navy)">Email</h3>
          </div>
          <p class="text-sm text-gray-500">
            <a href="mailto:<%= current_hospital.email.presence || 'info@healthroom.ng' %>" class="transition-colors" style="color: var(--hr-teal)">
              <%= current_hospital.email.presence || "info@healthroom.ng" %>
            </a>
          </p>
          <p class="text-xs text-gray-400 mt-1">We respond within 24 hours on business days.</p>
        </div>

        <!-- Working Hours Card -->
        <div class="hr-card">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(43,139,117,0.1)">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--hr-teal)">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-bold" style="color: var(--hr-navy)">Working Hours</h3>
          </div>
          <div class="text-sm space-y-2 text-gray-500">
            <div class="flex justify-between">
              <span>Monday - Friday</span>
              <span class="font-medium" style="color: var(--hr-navy)">8:00 AM - 6:00 PM</span>
            </div>
            <div class="flex justify-between">
              <span>Saturday</span>
              <span class="font-medium" style="color: var(--hr-navy)">9:00 AM - 4:00 PM</span>
            </div>
            <div class="flex justify-between">
              <span>Sunday</span>
              <span class="font-medium text-gray-400">Closed</span>
            </div>
            <div class="my-2" style="border-top: 1px solid #f0f0f0"></div>
            <div class="flex justify-between">
              <span>Emergency</span>
              <span class="font-bold" style="color: var(--hr-teal)">24/7</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
