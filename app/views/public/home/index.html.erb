<% content_for(:title) { "Expert Kidney Care in Nigeria" } %>
<% content_for(:meta_description) { "Healthroom Renal Centre - Nigeria's premier renal hospital offering expert kidney care, dialysis services, and compassionate treatment." } %>

<%
  doctor_photos = [
    "https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=400&h=480&fit=crop&q=80&face",
    "https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=400&h=480&fit=crop&q=80&face",
    "https://images.unsplash.com/photo-1622253694242-abeb37a33e97?w=400&h=480&fit=crop&q=80&face",
    "https://images.unsplash.com/photo-1594824476967-48c8b964ac31?w=400&h=480&fit=crop&q=80&face"
  ]

  blog_images = {
    "kidney_health" => "https://images.unsplash.com/photo-1559757175-5700dde675bc?w=600&h=380&fit=crop&q=80",
    "dialysis"      => "https://images.unsplash.com/photo-1530497610245-94d3c16cda28?w=600&h=380&fit=crop&q=80",
    "nutrition"     => "https://images.unsplash.com/photo-1490645935967-10de6ba17061?w=600&h=380&fit=crop&q=80",
    "lifestyle"     => "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=600&h=380&fit=crop&q=80",
    "news"          => "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=600&h=380&fit=crop&q=80",
    "default"       => "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=600&h=380&fit=crop&q=80"
  }
%>

<!-- ═══════════════════════════════════════════════════════
     HERO SECTION — Full-width Background Image Slider
═══════════════════════════════════════════════════════ -->
<section class="hr-hero-slider-section" data-controller="hero-slider" data-hero-slider-interval-value="6000">
  <!-- Background Slides -->
  <div class="hr-hero-slides">
    <div class="hr-hero-slide active" data-hero-slider-target="slide">
      <img src="https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?w=1920&h=900&fit=crop&q=85" alt="Modern medical facility" />
    </div>
    <div class="hr-hero-slide" data-hero-slider-target="slide">
      <img src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1920&h=900&fit=crop&q=85" alt="Healthcare professionals at work" />
    </div>
    <div class="hr-hero-slide" data-hero-slider-target="slide">
      <img src="https://images.unsplash.com/photo-1551076805-e1869033e561?w=1920&h=900&fit=crop&q=85" alt="Advanced medical equipment" />
    </div>
  </div>

  <!-- Gradient overlay -->
  <div class="hr-hero-overlay"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2" style="min-height: 700px">

      <!-- Left: Text content -->
      <div class="flex flex-col justify-center py-16 lg:py-20 pr-0 lg:pr-12">
        <div class="inline-flex items-center gap-2 mb-6 w-fit" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2); border-radius: 9999px; padding: 0.4rem 1rem;">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          <span class="text-white text-xs font-semibold tracking-wide uppercase">Nigeria's Premier Renal Hospital</span>
        </div>

        <h1 class="font-extrabold text-white" style="font-size: clamp(2.5rem, 5vw, 4.2rem); line-height: 1.08; letter-spacing: -0.03em">
          Expert <span class="hr-hero-orange-text">Kidney</span><br>
          <span class="hr-hero-orange-text">Care,</span>
          <span class="hr-hero-orange-text">Compassionate</span><br>
          Healing
        </h1>

        <p class="mt-6 leading-relaxed" style="color: rgba(255,255,255,0.6); font-size: 1.05rem; max-width: 520px">
          Comprehensive nephrology services from diagnosis to treatment. Board-certified specialists delivering personalised care with advanced technology and a deeply human approach.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 mt-9">
          <%= link_to contact_path, class: "btn btn-lg hr-btn-orange gap-2 rounded-xl font-semibold text-base shadow-lg" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            Book Appointment
          <% end %>
          <%= link_to about_path, class: "btn btn-lg hr-btn-ghost-white gap-2 rounded-xl font-semibold text-base" do %>
            Learn More
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          <% end %>
        </div>

        <!-- Slide dots -->
        <div class="flex gap-2 mt-10">
          <button class="hr-slide-dot active" data-hero-slider-target="dot" data-action="click->hero-slider#goToSlide" data-index="0"></button>
          <button class="hr-slide-dot" data-hero-slider-target="dot" data-action="click->hero-slider#goToSlide" data-index="1"></button>
          <button class="hr-slide-dot" data-hero-slider-target="dot" data-action="click->hero-slider#goToSlide" data-index="2"></button>
        </div>
      </div>

      <!-- Right: Floating stat cards over the slider -->
      <div class="hidden lg:flex items-center justify-center py-16 pl-8">
        <div class="relative w-full max-w-sm">
          <!-- Glassmorphism vitals card -->
          <div class="rounded-2xl p-6 relative overflow-hidden" style="background: rgba(255,255,255,0.08); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.15); min-height: 320px;">
            <div class="flex items-center justify-between mb-4">
              <div>
                <p class="text-white/50 text-xs uppercase tracking-widest">Live Monitoring</p>
                <p class="text-white font-semibold text-sm mt-0.5">Patient Vitals</p>
              </div>
              <span class="flex items-center gap-1.5 bg-green-500/20 text-green-400 text-xs font-semibold px-3 py-1 rounded-full">
                <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>
                Active
              </span>
            </div>

            <!-- ECG SVG visualization -->
            <div class="my-4">
              <svg viewBox="0 0 340 100" class="w-full" fill="none">
                <path class="ecg-line" d="M0,50 L30,50 L40,50 L50,20 L60,80 L70,50 L85,50 L95,50 L105,10 L115,90 L125,50 L140,50 L150,50 L160,25 L170,75 L180,50 L195,50 L205,50 L215,15 L225,85 L235,50 L250,50 L260,50 L270,22 L280,78 L290,50 L305,50 L320,50 L340,50"
                  stroke="#3aaa91" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <!-- Vitals row -->
            <div class="grid grid-cols-3 gap-3 mt-2">
              <div class="text-center rounded-xl py-3" style="background: rgba(255,255,255,0.08)">
                <p class="text-white text-lg font-bold">72</p>
                <p class="text-white/40 text-xs mt-0.5">BPM</p>
              </div>
              <div class="text-center rounded-xl py-3" style="background: rgba(255,255,255,0.08)">
                <p class="text-white text-lg font-bold">120/80</p>
                <p class="text-white/40 text-xs mt-0.5">BP</p>
              </div>
              <div class="text-center rounded-xl py-3" style="background: rgba(255,255,255,0.08)">
                <p class="text-white text-lg font-bold">98%</p>
                <p class="text-white/40 text-xs mt-0.5">SpO₂</p>
              </div>
            </div>
          </div>

          <!-- Floating stat card — satisfaction -->
          <div class="absolute -bottom-4 -right-4 bg-white rounded-2xl shadow-xl px-5 py-4 float-animation" style="min-width: 150px;">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: rgba(43,139,117,0.12)">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--hr-teal)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div>
                <p class="text-2xl font-extrabold text-gray-900">98%</p>
                <p class="text-xs text-gray-400 mt-0.5">Satisfaction Rate</p>
              </div>
            </div>
          </div>

          <!-- Floating years badge -->
          <div class="absolute -top-4 -left-4 bg-white rounded-2xl shadow-xl px-5 py-4 float-animation" style="animation-delay: 1.5s;">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: rgba(232,119,63,0.12)">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--hr-orange)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div>
                <p class="text-2xl font-extrabold text-gray-900">15+</p>
                <p class="text-xs text-gray-400 mt-0.5">Years of Care</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     STATS BAR
═══════════════════════════════════════════════════════ -->
<section class="bg-white py-10 border-b border-gray-100">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      <% [
        { value: "15+", label: "Years in Service" },
        { value: "10,000+", label: "Patients Treated" },
        { value: "50+", label: "Specialists Available" },
        { value: "24/7", label: "Emergency Care" }
      ].each_with_index do |stat, i| %>
        <div class="text-center <%= i < 3 ? 'lg:border-r border-gray-100' : '' %>">
          <div class="text-3xl lg:text-4xl font-extrabold" style="color: var(--hr-navy)"><%= stat[:value] %></div>
          <div class="text-sm text-gray-400 mt-1.5 font-medium"><%= stat[:label] %></div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     WHY CHOOSE US
═══════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Left: image with stat badge -->
      <div class="relative">
        <div class="rounded-2xl overflow-hidden shadow-lg" style="height: 460px; background: #e5e7eb;">
          <img src="https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?w=800&h=600&fit=crop&q=80"
               alt="Healthcare professionals" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <!-- Stat badge -->
        <div class="absolute bottom-6 left-6 bg-white rounded-2xl shadow-xl px-5 py-4">
          <p class="text-3xl font-extrabold" style="color: var(--hr-navy)">15+</p>
          <p class="text-sm text-gray-400 mt-0.5">Years of Medical Excellence</p>
        </div>
      </div>

      <!-- Right: features -->
      <div>
        <span class="hr-section-label">— Why Choose Us</span>
        <h2 class="text-3xl lg:text-4xl hr-section-title mt-3 leading-tight">
          Nigeria's Most Trusted<br>Renal Care Centre
        </h2>
        <p class="text-gray-500 mt-4 text-base leading-relaxed">
          We combine advanced medical technology with a deeply human approach to kidney care.
        </p>

        <div class="space-y-4 mt-8">
          <% [
            { icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z", title: "Board-Certified Nephrologists", desc: "Trained at top institutions in Nigeria, the UK, and the US with decades of experience.", bg: "rgba(43,139,117,0.1)", color: "var(--hr-teal)" },
            { icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z", title: "Modern Dialysis Facility", desc: "State-of-the-art haemodialysis and peritoneal dialysis rooms with comfortable, private stations.", bg: "rgba(59,130,246,0.1)", color: "#3b82f6" },
            { icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01", title: "Comprehensive Lab Services", desc: "On-site laboratory for quick, accurate kidney function tests and specialised diagnostics.", bg: "rgba(168,85,247,0.1)", color: "#a855f7" },
            { icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z", title: "Patient-First Approach", desc: "Personalised treatment plans, nutrition counselling, and continuous ongoing support for every patient.", bg: "rgba(232,119,63,0.1)", color: "var(--hr-orange)" }
          ].each do |item| %>
            <div class="flex gap-4 p-4 rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors group">
              <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background: <%= item[:bg] %>">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: <%= item[:color] %>">
                  <path stroke-linecap="round" stroke-linejoin="round" d="<%= item[:icon] %>" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-900 text-sm"><%= item[:title] %></h3>
                <p class="text-gray-500 text-sm mt-0.5 leading-relaxed"><%= item[:desc] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     SERVICES — Image-topped card style (matches mockup)
═══════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-28" style="background-color: var(--hr-cream)">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="hr-section-label">— Our Services</span>
      <h2 class="text-3xl lg:text-4xl hr-section-title mt-3">Comprehensive Kidney Care</h2>
      <p class="text-gray-500 mt-4 text-base">
        From routine screenings to advanced treatments, we offer a full spectrum of renal care services.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <%
        all_services = if @services.any?
          @services.map { |s|
            { name: s.name, desc: s.description.presence || "Expert care delivered by our specialists.", link: public_services_path }
          }
        else
          [
            { name: "Nephrology Consultation", desc: "Expert evaluation and management of all kidney diseases by board-certified nephrologists.", link: public_services_path },
            { name: "Haemodialysis", desc: "State-of-the-art dialysis treatment in a comfortable, modern facility with experienced nurses.", link: public_services_path },
            { name: "Kidney Biopsy", desc: "Diagnostic biopsies performed by our expert team for accurate diagnosis and optimal care.", link: public_services_path },
            { name: "Kidney Transplant Evaluation", desc: "Thorough pre-transplant workup and coordination with transplant centres across Nigeria.", link: public_services_path },
            { name: "Laboratory Services", desc: "Full-service renal lab for kidney function tests, urinalysis, and specialised diagnostics.", link: public_services_path },
            { name: "Nutrition Counselling", desc: "Personalised dietary guidance from renal dietitians to support kidney health and outcomes.", link: public_services_path }
          ]
        end

        service_styles = [
          { bg: "#E8F5EF", icon_bg: "rgba(43,139,117,0.15)", icon_color: "var(--hr-teal)", tag_color: "rgba(43,139,117,0.15)", tag_text: "var(--hr-teal)", tag: "Consultation" },
          { bg: "#EDF2FB", icon_bg: "rgba(59,130,246,0.15)", icon_color: "#3b82f6", tag_color: "rgba(59,130,246,0.15)", tag_text: "#3b82f6", tag: "Treatment" },
          { bg: "#F3EFFC", icon_bg: "rgba(168,85,247,0.15)", icon_color: "#a855f7", tag_color: "rgba(168,85,247,0.15)", tag_text: "#a855f7", tag: "Diagnostic" },
          { bg: "#FDF3EC", icon_bg: "rgba(232,119,63,0.15)", icon_color: "var(--hr-orange)", tag_color: "rgba(232,119,63,0.15)", tag_text: "var(--hr-orange)", tag: "Surgery" },
          { bg: "#EDF6FB", icon_bg: "rgba(20,184,166,0.15)", icon_color: "#14b8a6", tag_color: "rgba(20,184,166,0.15)", tag_text: "#14b8a6", tag: "Laboratory" },
          { bg: "#FEF9EC", icon_bg: "rgba(234,179,8,0.15)", icon_color: "#ca8a04", tag_color: "rgba(234,179,8,0.15)", tag_text: "#ca8a04", tag: "Support" }
        ]

        service_icons = [
          "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
          "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
          "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
          "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
          "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01",
          "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
        ]
      %>

      <% all_services.first(6).each_with_index do |svc, idx| %>
        <% style = service_styles[idx % service_styles.length] %>
        <%= link_to svc[:link], class: "hr-service-card-img group block no-underline" do %>
          <%# Image thumbnail area with large icon overlay — matches mockup %>
          <div class="card-thumb relative flex items-center justify-center" style="background: <%= style[:bg] %>">
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center" style="background: <%= style[:icon_bg] %>">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: <%= style[:icon_color] %>">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= service_icons[idx % service_icons.length] %>" />
              </svg>
            </div>
          </div>
          <div class="card-body">
            <div class="mb-2">
              <span class="hr-blog-chip text-xs" style="background: <%= style[:tag_color] %>; color: <%= style[:tag_text] %>"><%= style[:tag] %></span>
            </div>
            <h3 class="font-bold text-gray-900 text-base mt-1"><%= svc[:name] %></h3>
            <p class="text-gray-500 text-sm mt-1.5 leading-relaxed line-clamp-2"><%= svc[:desc] %></p>
            <div class="mt-4 flex items-center gap-1 text-sm font-semibold transition-all group-hover:gap-2" style="color: var(--hr-teal)">
              Learn More
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     DOCTORS — Dark navy background
═══════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-28 hr-hero-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-14">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--hr-teal-light)">— Our Team</span>
        <h2 class="text-3xl lg:text-4xl font-extrabold text-white mt-3" style="letter-spacing: -0.02em">Meet Our Specialists</h2>
        <p class="mt-3 text-base max-w-xl" style="color: rgba(255,255,255,0.55)">
          Experienced nephrologists and kidney specialists committed to your health and well-being.
        </p>
      </div>
      <%= link_to doctors_path, class: "mt-6 md:mt-0 text-sm font-semibold flex items-center gap-1.5 transition-colors", style: "color: var(--hr-teal-light)" do %>
        View All Doctors
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      <% end %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% if @doctors.any? %>
        <% @doctors.first(4).each_with_index do |doctor, idx| %>
          <%= link_to doctor_path(doctor), class: "hr-doctor-card block no-underline" do %>
            <% if doctor.avatar.attached? %>
              <%= image_tag doctor.avatar.variant(resize_to_limit: [400, 480]), class: "w-full", style: "height: 240px; object-fit: cover; object-position: top", alt: doctor.full_name %>
            <% else %>
              <img src="<%= doctor_photos[idx % doctor_photos.length] %>" alt="Dr. <%= doctor.full_name %>" style="width: 100%; height: 240px; object-fit: cover; object-position: top" loading="lazy" />
            <% end %>
            <div class="hr-doctor-info">
              <h3>Dr. <%= doctor.full_name %></h3>
              <p><%= doctor.staff_profile&.specialization.presence || "Nephrology" %></p>
              <div class="hr-stars mt-2">
                <% 5.times do %><svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg><% end %>
                <span class="text-white/40 text-xs ml-1.5">5.0</span>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <%
          fallback_doctors = [
            { name: "Adaeze Obi-Ajayi", spec: "Nephrology", photo: doctor_photos[0] },
            { name: "Chukwudera Owusu", spec: "Dialysis Medicine", photo: doctor_photos[1] },
            { name: "Fatima Bakhouti", spec: "Transplant Nephrology", photo: doctor_photos[2] },
            { name: "Olasukanmi Adekile", spec: "Paediatric Nephrology", photo: doctor_photos[3] }
          ]
        %>
        <% fallback_doctors.each do |doc| %>
          <%= link_to doctors_path, class: "hr-doctor-card block no-underline" do %>
            <img src="<%= doc[:photo] %>" alt="Dr. <%= doc[:name] %>" style="width: 100%; height: 240px; object-fit: cover; object-position: top" loading="lazy" />
            <div class="hr-doctor-info">
              <h3>Dr. <%= doc[:name] %></h3>
              <p><%= doc[:spec] %></p>
              <div class="hr-stars mt-2">
                <% 5.times do %><svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg><% end %>
                <span class="text-white/40 text-xs ml-1.5">5.0</span>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     TESTIMONIALS
═══════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-28" style="background-color: var(--hr-cream)">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="hr-section-label">— What Our Patients Say</span>
      <h2 class="text-3xl lg:text-4xl hr-section-title mt-3">Real Stories, Real Healing</h2>
      <p class="text-gray-500 mt-4 text-base">Real stories from patients whose lives have been transformed by our care.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
      <% testimonials_to_show = @testimonials.any? ? @testimonials.first(3) : [
        { name: "Mr. T. Adebisi", content: "I have been a patient at Healthroom for over a year. The staff treats me like family. My kidney function has improved significantly, and I feel so much more hopeful about my future.", rating: 5 },
        { name: "Alhaji Ibrahim Qasim", content: "After being diagnosed with Stage 5 CKD, I was devastated. But the team of nephrologists gave me renewed hope. Their comprehensive approach has significantly improved my quality of life.", rating: 5 },
        { name: "Mrs. A. Okafor", content: "My experience at Healthroom Renal Centre was exceptional. In 20 days the time in system for routine and treatment options. The doctors put us at ease, comfortable and the doctors are extremely helpful.", rating: 5 }
      ] %>

      <% testimonials_to_show.each_with_index do |t, i| %>
        <% is_model = t.respond_to?(:patient_name) %>
        <div class="hr-testimonial-card">
          <div class="flex gap-0.5 mb-4">
            <% 5.times do |j| %>
              <svg class="w-4 h-4" style="color: #f59e0b; fill: #f59e0b" viewBox="0 0 24 24">
                <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
              </svg>
            <% end %>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed flex-1"><%= is_model ? t.content : t[:content] %></p>
          <div class="flex items-center gap-3 mt-6 pt-5 border-t border-gray-100">
            <% name = is_model ? t.patient_name : t[:name] %>
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0" style="background: var(--hr-teal)">
              <%= name.split.map { |n| n[0] }.join.upcase %>
            </div>
            <div>
              <p class="font-bold text-gray-900 text-sm"><%= name %></p>
              <p class="text-gray-400 text-xs">Verified Patient</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     BLOG POSTS
═══════════════════════════════════════════════════════ -->
<% blog_data = defined?(@blog_posts) && @blog_posts&.any? ? @blog_posts.first(3) : nil %>
<section class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-14">
      <div>
        <span class="hr-section-label">— From Our Blog</span>
        <h2 class="text-3xl lg:text-4xl hr-section-title mt-3">Health & Wellness Insights</h2>
        <p class="text-gray-500 mt-3 text-base max-w-xl">Expert advice from our medical team on kidney health, dialysis, and living well.</p>
      </div>
      <%= link_to blog_posts_path, class: "mt-6 md:mt-0 btn btn-sm rounded-full border font-semibold text-sm", style: "border-color: var(--hr-teal); color: var(--hr-teal); background: transparent" do %>
        View All Posts
      <% end %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
      <% posts_to_show = blog_data || [
        { title: "Nutrition for Dialysis Patients: What to Eat and What to Avoid", category: "nutrition", img: blog_images["nutrition"], excerpt: "Proper nutrition is crucial for patients undergoing dialysis. Here is a guide to the right foods, the nutrients you need, and the minerals to limit for better kidney health.", date: "Feb 12, 2026", mins: 5 },
        { title: "What to Expect During Your First Dialysis Session", category: "dialysis", img: blog_images["dialysis"], excerpt: "A beginner's guide for first-time dialysis patients — what happens before, during, and after your session, and what questions to ask your care team.", date: "Feb 8, 2026", mins: 4 },
        { title: "Understanding Chronic Kidney Disease: Stages and Treatment Options", category: "kidney_health", img: blog_images["kidney_health"], excerpt: "CKD affects millions of Nigerians. Understanding the five stages of kidney disease can help you take control of your health and slow its progression.", date: "Feb 3, 2026", mins: 6 }
      ] %>

      <% chip_colors = { "nutrition" => ["#FDF6EC", "#E8773F"], "dialysis" => ["#EDF2FB", "#3b82f6"], "kidney_health" => ["#E8F5EF", "#2B8B75"], "lifestyle" => ["#F3EFFC", "#a855f7"], "news" => ["#FEF9EC", "#ca8a04"], "default" => ["#f3f4f6", "#6b7280"] } %>

      <% posts_to_show.each_with_index do |post, i| %>
        <% is_model = post.respond_to?(:title) %>
        <% category = is_model ? post.category : post[:category] %>
        <% chip = chip_colors[category] || chip_colors["default"] %>
        <article class="blog-card group rounded-2xl overflow-hidden bg-white border border-gray-100 hover:shadow-lg transition-all duration-300">
          <figure class="relative overflow-hidden h-48">
            <% if is_model && post.featured_image.attached? %>
              <%= image_tag post.featured_image.variant(resize_to_limit: [600, 380]), class: "w-full h-full object-cover", alt: post.title %>
            <% else %>
              <img src="<%= is_model ? (blog_images[post.category] || blog_images['default']) : post[:img] %>" alt="<%= is_model ? post.title : post[:title] %>" class="w-full h-full object-cover" loading="lazy" />
            <% end %>
            <div class="absolute top-3 left-3">
              <span class="hr-blog-chip" style="background: <%= chip[0] %>; color: <%= chip[1] %>"><%= category.to_s.humanize %></span>
            </div>
          </figure>
          <div class="p-5">
            <div class="flex items-center gap-2 text-xs text-gray-400 mb-3">
              <span><%= is_model ? (post.published_at&.strftime("%b %d, %Y") || post.created_at.strftime("%b %d, %Y")) : post[:date] %></span>
              <span class="w-1 h-1 rounded-full bg-gray-200"></span>
              <span><%= is_model ? "#{post.reading_time} min read" : "#{post[:mins]} min read" %></span>
            </div>
            <h3 class="font-bold text-gray-900 text-sm leading-snug line-clamp-2 group-hover:text-primary transition-colors">
              <% if is_model %>
                <%= link_to post.title, blog_post_path(post), class: "hover:no-underline" %>
              <% else %>
                <%= post[:title] %>
              <% end %>
            </h3>
            <p class="text-gray-500 text-xs mt-2 line-clamp-2 leading-relaxed">
              <%= is_model ? (post.excerpt.presence || truncate(strip_tags(post.body.to_s), length: 120)) : post[:excerpt] %>
            </p>
            <div class="mt-4">
              <% if is_model %>
                <%= link_to blog_post_path(post), class: "text-xs font-bold flex items-center gap-1 group-hover:gap-2 transition-all", style: "color: var(--hr-teal)" do %>
                  Read Article <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                <% end %>
              <% else %>
                <span class="text-xs font-bold flex items-center gap-1" style="color: var(--hr-teal)">
                  Read Article <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                </span>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     CTA SECTION — Dark navy card
═══════════════════════════════════════════════════════ -->
<section class="py-12 lg:py-20 bg-white">
