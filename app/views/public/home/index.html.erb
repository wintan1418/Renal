<% content_for(:title) { "Expert Kidney Care" } %>
<% content_for(:meta_description) { "Healthroom Renal Centre — A premier renal hospital offering expert kidney care, dialysis services, and compassionate treatment." } %>

<div class="mk-pg">
  <!-- ===================== HERO ===================== -->
  <section class="mk-section--cream" style="border-top:none">
    <div class="mk-wrap mk-hero-grid" style="display:grid;grid-template-columns:1.05fr 0.95fr;gap:40px;align-items:center;min-height:560px">
      <div style="padding:64px 0">
        <div style="display:inline-flex;align-items:center;gap:8px;background:var(--mk-teal-soft);color:var(--mk-teal-ink);font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:8px 15px;border-radius:999px;margin-bottom:26px">
          <span style="width:7px;height:7px;border-radius:50%;background:var(--mk-teal);display:inline-block"></span>A premier renal centre
        </div>
        <h1 class="mk-h1">Expert <span class="mk-serif-em">kidney care,</span><br>compassionate healing.</h1>
        <p class="mk-lead" style="margin-top:24px;max-width:440px">Comprehensive nephrology — from early diagnosis to advanced dialysis — delivered by board-certified specialists with modern technology and a deeply human touch.</p>
        <div style="display:flex;gap:14px;margin-top:34px;flex-wrap:wrap">
          <button class="mk-btn mk-btn--cta mk-btn--lg" data-action="marketing-booking#open">Book Appointment →</button>
          <%= link_to "Our Services", public_services_path, class: "mk-btn mk-btn--outline mk-btn--lg" %>
        </div>
        <div style="display:flex;gap:40px;margin-top:48px">
          <div><div class="mk-stat__num" style="font-size:32px">15+</div><div class="mk-stat__label">Years of care</div></div>
          <div style="width:1px;background:var(--mk-line-2)"></div>
          <div><div class="mk-stat__num" style="font-size:32px">10k+</div><div class="mk-stat__label">Patients treated</div></div>
          <div style="width:1px;background:var(--mk-line-2)"></div>
          <div><div class="mk-stat__num" style="font-size:32px">98%</div><div class="mk-stat__label">Satisfaction</div></div>
        </div>
      </div>
      <div class="mk-hero-media" style="position:relative;padding:40px 0">
        <%= image_tag "marketing/hero-consult.jpg", alt: "Nephrologist consulting a patient", loading: "eager", style: "width:100%;height:440px;object-fit:cover;border-radius:24px" %>
        <div class="mk-glass-card mk-floaty" style="position:absolute;top:64px;left:-22px;padding:14px 18px;display:flex;align-items:center;gap:12px">
          <span class="mk-icchip mk-icchip--md mk-t-green"><%= mk_icon :pulse, size: 20 %></span>
          <div><div style="font-weight:800;font-size:16px;color:var(--mk-navy);font-family:var(--mk-display)">Active</div><div style="font-size:11px;color:var(--mk-muted-2)">Live monitoring</div></div>
        </div>
        <div class="mk-glass-card mk-floaty mk-floaty--delay" style="position:absolute;bottom:64px;right:-14px;padding:14px 20px">
          <div style="display:flex;gap:20px">
            <div><div style="font-size:11px;color:var(--mk-muted-2)">BPM</div><div style="font-weight:800;font-size:18px;color:var(--mk-navy);font-family:var(--mk-display)">72</div></div>
            <div><div style="font-size:11px;color:var(--mk-muted-2)">BP</div><div style="font-weight:800;font-size:18px;color:var(--mk-navy);font-family:var(--mk-display)">120/80</div></div>
            <div><div style="font-size:11px;color:var(--mk-muted-2)">eGFR</div><div style="font-weight:800;font-size:18px;color:var(--mk-teal);font-family:var(--mk-display)">98%</div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WHY CHOOSE ===================== -->
  <section class="mk-section">
    <div class="mk-wrap mk-two-col" style="display:grid;grid-template-columns:0.9fr 1.1fr;gap:64px;align-items:center">
      <div style="position:relative">
        <%= image_tag "marketing/care-team.jpg", alt: "Care team with patient", loading: "lazy", style: "width:100%;height:480px;object-fit:cover;border-radius:24px" %>
        <div class="mk-glass-card" style="position:absolute;bottom:-20px;left:-20px;padding:20px 24px">
          <div class="mk-stat__num" style="font-size:34px">15+</div>
          <div style="font-size:13px;color:var(--mk-muted);font-weight:500">Years of medical excellence</div>
        </div>
      </div>
      <div>
        <div class="mk-eyebrow">— Why choose us</div>
        <h2 class="mk-h2">A trusted renal care centre</h2>
        <p class="mk-lead" style="margin-top:18px;max-width:480px">We combine advanced medical technology with a deeply human approach to kidney care — so every patient feels seen, supported and safe.</p>
        <div style="display:grid;gap:14px;margin-top:32px">
          <% [
            { icon: :shield, tint: "mk-t-green", title: "Board-Certified Nephrologists", desc: "Trained at leading institutions worldwide." },
            { icon: :droplet, tint: "mk-t-blue", title: "Modern Dialysis Facility", desc: "Advanced haemodialysis and peritoneal dialysis suites." },
            { icon: :flask, tint: "mk-t-purple", title: "On-Site Laboratory", desc: "Fast, accurate kidney function tests and diagnostics." },
            { icon: :heart, tint: "mk-t-coral", title: "Patient-First Approach", desc: "Personalised plans, nutrition counselling and ongoing support." }
          ].each do |f| %>
            <div class="mk-feature">
              <span class="mk-icchip mk-icchip--md <%= f[:tint] %>"><%= mk_icon f[:icon], size: 22 %></span>
              <div><div class="mk-feature__title"><%= f[:title] %></div><div class="mk-feature__desc"><%= f[:desc] %></div></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PLATFORM CAPABILITIES ===================== -->
  <section class="mk-section cap">
    <div class="mk-wrap">
      <div style="text-align:center;max-width:640px;margin:0 auto 12px">
        <div class="mk-eyebrow">— One connected platform</div>
        <h2 class="mk-h2">Smarter kidney care, end to end</h2>
        <p class="mk-lead" style="margin-top:14px">From your first appointment to dialysis, labs, prescriptions and billing — powered by clinical AI and real-time monitoring, so nothing falls through the cracks.</p>
      </div>

      <div class="mk-grid mk-grid--3" style="margin-top:40px">
        <% [
          { icon: :pulse,   tint: "mk-t-green",  title: "AI-assisted clinical care", desc: "AI clinical summaries, plain-language lab explanations and a SOAP scribe help your doctors focus on you, not paperwork." },
          { icon: :droplet, tint: "mk-t-blue",   title: "Dialysis adequacy tracking", desc: "Every session measured for Kt/V, URR and fluid removal against best-practice targets, with a live unit board." },
          { icon: :shield,  tint: "mk-t-coral",  title: "Medication safety", desc: "eGFR-adjusted dosing guidance and automatic alerts on critical results keep your treatment safe." },
          { icon: :heart,   tint: "mk-t-purple", title: "Home monitoring", desc: "Log blood pressure, weight and medications from home — your care team sees flagged readings instantly." },
          { icon: :pin,     tint: "mk-t-teal",   title: "Video consultations", desc: "Secure video visits from anywhere — no app to install, just one tap to join." },
          { icon: :flask,   tint: "mk-t-amber",  title: "Your records, always with you", desc: "Lab trends, prescriptions, dialysis history, invoices and an AI health assistant — all in your private portal." }
        ].each_with_index do |f, i| %>
          <div class="mk-card mk-card--pad mk-card--hover cap-card" style="--i:<%= i %>">
            <span class="mk-icchip mk-icchip--lg <%= f[:tint] %>"><%= mk_icon f[:icon], size: 24, width: 2 %></span>
            <h3 class="mk-h3" style="margin:16px 0 8px"><%= f[:title] %></h3>
            <p style="font-size:14.5px;line-height:1.6;color:var(--mk-muted)"><%= f[:desc] %></p>
          </div>
        <% end %>
      </div>

      <!-- stat band -->
      <div class="cap-stats">
        <% [["6", "specialist roles, one system"], ["100%", "of dialysis sessions scored"], ["24/7", "AI health assistant"], ["1-tap", "video visits"]].each do |num, label| %>
          <div class="cap-stat">
            <div class="cap-stat__num"><%= num %></div>
            <div class="cap-stat__label"><%= label %></div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES PREVIEW ===================== -->
  <section class="mk-section--cream mk-section">
    <div class="mk-wrap">
      <div style="text-align:center;max-width:620px;margin:0 auto 56px">
        <div class="mk-eyebrow">— Our services</div>
        <h2 class="mk-h2">Comprehensive kidney care</h2>
        <p class="mk-lead" style="margin-top:16px">From routine screening to advanced treatment, we offer a full spectrum of renal care services under one roof.</p>
      </div>
      <div class="mk-grid mk-grid--3">
        <% @services.first(6).each do |s| %>
          <% v = service_visual(s) %>
          <%= link_to public_services_path, class: "mk-card mk-card--pad mk-card--hover", style: "text-decoration:none;display:block" do %>
            <span class="mk-icchip mk-icchip--lg <%= v[:tint] %>" style="margin-bottom:48px"><%= mk_icon v[:icon], size: 24 %></span>
            <div style="font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;color:var(--mk-teal-ink)"><%= v[:cat] %></div>
            <div class="mk-h3"><%= s.name %></div>
            <div style="font-size:14px;line-height:1.55;color:var(--mk-muted);margin-top:8px"><%= s.description.presence&.truncate(90) || "Expert renal care delivered by our specialist team." %></div>
            <div style="display:flex;align-items:center;gap:6px;margin-top:18px;font-size:14px;font-weight:700;color:var(--mk-teal)">Learn more <span>→</span></div>
          <% end %>
        <% end %>
      </div>
      <div style="text-align:center;margin-top:44px">
        <%= link_to "View all services →", public_services_path, class: "mk-btn mk-btn--teal mk-btn--lg" %>
      </div>
    </div>
  </section>

  <!-- ===================== DOCTORS PREVIEW ===================== -->
  <section class="mk-section">
    <div class="mk-wrap">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:48px;gap:20px;flex-wrap:wrap">
        <div>
          <div class="mk-eyebrow">— Our team</div>
          <h2 class="mk-h2" style="max-width:480px">Meet the specialists behind your care</h2>
        </div>
        <%= link_to "View all doctors →", doctors_path, class: "mk-btn mk-btn--outline" %>
      </div>
      <div class="mk-grid mk-grid--4">
        <% @doctors.each_with_index do |d, i| %>
          <%= link_to doctor_path(d), class: "mk-card mk-card--hover", style: "overflow:hidden;text-decoration:none;display:block" do %>
            <%= image_tag doctor_photo(i), alt: d.full_name, loading: "lazy", class: "mk-card__media", style: "height:240px" %>
            <div style="padding:18px 20px 22px">
              <div class="mk-h3" style="font-size:17px">Dr. <%= d.full_name %></div>
              <div style="font-size:13.5px;color:var(--mk-teal);font-weight:600;margin-top:3px"><%= doctor_specialty(d) %></div>
              <div style="display:flex;align-items:center;gap:6px;margin-top:10px"><span class="mk-stars">★★★★★</span><span style="font-size:12.5px;color:var(--mk-muted-2);font-weight:600"><%= doctor_rating(d) %></span></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <!-- ===================== TESTIMONIALS ===================== -->
  <% if @testimonials.any? %>
  <section class="mk-section--cream mk-section">
    <div class="mk-wrap">
      <div style="text-align:center;max-width:600px;margin:0 auto 56px">
        <div class="mk-eyebrow">— What our patients say</div>
        <h2 class="mk-h2">Real stories, real healing</h2>
      </div>
      <div class="mk-grid mk-grid--3">
        <% @testimonials.first(3).each do |t| %>
          <div class="mk-card mk-card--pad" style="display:flex;flex-direction:column">
            <div class="mk-stars" style="font-size:15px;letter-spacing:2px;margin-bottom:16px">★★★★★</div>
            <p style="font-size:15px;line-height:1.65;color:oklch(0.34 0.02 165);flex:1">“<%= t.content %>”</p>
            <div style="display:flex;align-items:center;gap:13px;margin-top:22px;padding-top:20px;border-top:1px solid var(--mk-line)">
              <div style="width:44px;height:44px;border-radius:50%;background:var(--mk-teal);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px;font-family:var(--mk-display)"><%= t.patient_name.to_s.split.map(&:first).first(2).join.upcase %></div>
              <div><div style="font-weight:700;font-size:15px;color:var(--mk-ink)"><%= t.patient_name %></div><div style="font-size:12.5px;color:var(--mk-muted-2)">Verified patient</div></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
  <% end %>

  <!-- ===================== BLOG PREVIEW ===================== -->
  <% if @blog_posts.any? %>
  <section class="mk-section">
    <div class="mk-wrap">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:48px;gap:20px;flex-wrap:wrap">
        <div>
          <div class="mk-eyebrow">— From our blog</div>
          <h2 class="mk-h2">Health &amp; wellness insights</h2>
        </div>
        <%= link_to "View all posts →", blog_posts_path, class: "mk-btn mk-btn--outline" %>
      </div>
      <div class="mk-grid mk-grid--3" style="gap:24px">
        <% @blog_posts.first(3).each_with_index do |p, i| %>
          <%= link_to blog_post_path(p.slug), class: "mk-card mk-card--hover", style: "overflow:hidden;text-decoration:none;display:block" do %>
            <%= image_tag blog_image_for(p, i), alt: p.title, loading: "lazy", class: "mk-card__media", style: "height:190px" %>
            <div style="padding:22px">
              <span class="mk-cat" style="margin-bottom:12px"><%= blog_category_label(p) %></span>
              <div class="mk-h3" style="font-size:18px;line-height:1.25;margin-top:12px"><%= p.title %></div>
              <div style="font-size:13px;color:var(--mk-muted-3);margin-top:12px"><%= p.published_at&.strftime("%b %d, %Y") %> · <%= blog_read_time(p) %></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
  <% end %>

  <!-- ===================== CTA ===================== -->
  <section style="padding:0 0 96px">
    <div class="mk-wrap">
      <div class="mk-two-col" style="background:var(--mk-navy);border-radius:28px;padding:64px 56px;display:grid;grid-template-columns:1.1fr 0.9fr;gap:48px;align-items:center;position:relative;overflow:hidden">
        <div style="position:absolute;top:-80px;right:-40px;width:300px;height:300px;border-radius:50%;background:oklch(0.42 0.09 162 / .35);filter:blur(20px)"></div>
        <div style="position:relative">
          <h2 class="mk-display" style="font-size:38px;line-height:1.1;color:#fff">Ready to take control of your kidney health?</h2>
          <p style="font-size:16px;line-height:1.65;color:rgba(255,255,255,.7);margin-top:16px;max-width:440px">Schedule a consultation with our expert nephrologists today. Same-day appointments available.</p>
          <div style="display:flex;gap:14px;margin-top:30px;flex-wrap:wrap">
            <button class="mk-btn mk-btn--cta mk-btn--lg" data-action="marketing-booking#open">Book an Appointment</button>
            <%= link_to "Call Us Now", contact_path, class: "mk-btn mk-btn--dark-ghost mk-btn--lg" %>
          </div>
        </div>
        <div style="position:relative;display:flex;flex-direction:column;gap:14px">
          <% [
            { icon: :pin, label: "Visit Us", value: (current_hospital.address.presence || "125 Riverside Medical Drive") },
            { icon: :phone, label: "Call Us", value: (current_hospital.phone.presence || "+1 800 HEALTH") },
            { icon: :mail, label: "Email Us", value: (current_hospital.email.presence || "info@healthroom.health") }
          ].each do |c| %>
            <div style="display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:16px 18px">
              <span style="width:42px;height:42px;border-radius:11px;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0"><%= mk_icon c[:icon], size: 20, stroke: "oklch(0.7 0.1 162)", width: 2 %></span>
              <div><div style="font-size:12px;color:rgba(255,255,255,.55)"><%= c[:label] %></div><div style="font-size:15px;font-weight:600;color:#fff;margin-top:2px"><%= c[:value] %></div></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>
</div>
