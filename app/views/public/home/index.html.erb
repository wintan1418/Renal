              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              Call Us Now
            </a>
          </div>
        </div>

        <!-- Right: Contact info -->
        <div class="grid grid-cols-1 gap-4">
          <% contact_items = [
            { icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z", label: "Visit Us", value: (defined?(current_hospital) && current_hospital&.address.presence) || "15 Medical Drive, Victoria Island, Lagos" },
            { icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z", label: "Call Us", value: (defined?(current_hospital) && current_hospital&.phone.presence) || "+234 800 000 0000" },
            { icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z", label: "Email Us", value: (defined?(current_hospital) && current_hospital&.email.presence) || "info@healthroom.ng" }
          ] %>
          <% contact_items.each do |item| %>
            <div class="flex items-start gap-4 rounded-xl p-4" style="background: rgba(255,255,255,0.07)">
              <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(255,255,255,0.1)">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= item[:icon] %>" /></svg>
              </div>
              <div>
                <p class="text-white/40 text-xs font-medium mb-0.5"><%= item[:label] %></p>
                <p class="text-white text-sm font-medium"><%= item[:value] %></p>
              </div>
