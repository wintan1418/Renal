<% content_for(:title) { "About Us" } %>
<% content_for(:meta_description) { "Learn about Healthroom Renal Centre — our mission and commitment to expert, compassionate kidney care." } %>

<div class="mk-pg">
  <section class="mk-section" style="padding:80px 0 64px">
    <div class="mk-wrap mk-two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
      <div>
        <div class="mk-eyebrow">— About us</div>
        <h1 class="mk-h1" style="font-size:clamp(34px,4.5vw,46px)">Compassionate kidney care, built around you</h1>
        <p class="mk-lead" style="margin-top:20px">Founded over 15 years ago, Healthroom Renal Centre has grown into one of the world's most trusted dedicated kidney hospitals. We pair advanced technology with a genuinely human approach — because behind every chart is a person and a family.</p>
        <p class="mk-lead" style="margin-top:14px">Our mission is simple: make world-class renal care accessible, dignified and affordable for every patient who walks through our doors.</p>
      </div>
      <%= image_tag "marketing/about-hospital.jpg", alt: "Healthroom Renal Centre ward", style: "width:100%;height:440px;object-fit:cover;border-radius:24px" %>
    </div>
  </section>

  <section class="mk-section--cream" style="padding:64px 0">
    <div class="mk-wrap mk-grid mk-grid--4" style="text-align:center">
      <% [["15+","Years in service"],["10,000+","Patients treated"],["50+","Specialists available"],["24/7","Emergency care"]].each do |num, label| %>
        <div><div class="mk-stat__num" style="font-size:44px"><%= num %></div><div style="font-size:14px;color:var(--mk-muted);font-weight:500;margin-top:4px"><%= label %></div></div>
      <% end %>
    </div>
  </section>

  <section class="mk-section" style="max-width:880px;margin:0 auto;padding:88px 28px 96px">
    <div style="text-align:center;margin-bottom:48px"><h2 class="mk-h2">Frequently asked questions</h2></div>
    <div style="display:flex;flex-direction:column;gap:12px">
      <% faqs = [
        ["Do I need a referral to book an appointment?", "No referral is required for an initial nephrology consultation. If you have one from another physician, bring it along so our specialists have your full history."],
        ["Which insurance plans do you accept?", "We work with most major insurance providers and offer self-pay packages. Our front desk will confirm your coverage when you book."],
        ["How long does a dialysis session take?", "A typical haemodialysis session lasts about 4 hours, three times a week. Your nephrologist will tailor a schedule to your needs."],
        ["Do you offer emergency renal care?", "Yes. Our emergency renal service operates 24/7 for acute kidney injury, dialysis emergencies and urgent consultations."],
        ["Can I get a second opinion?", "Absolutely. We welcome second-opinion consultations and will review any prior records, scans and lab results you provide."]
      ] %>
      <% faqs.each do |q, a| %>
        <details class="mk-card" style="overflow:hidden">
          <summary style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 24px;cursor:pointer;list-style:none">
            <span style="font-weight:700;font-size:16px;color:var(--mk-ink)"><%= q %></span>
            <span style="font-size:22px;color:var(--mk-teal);flex-shrink:0">+</span>
          </summary>
          <p style="padding:0 24px 22px;font-size:15px;line-height:1.65;color:var(--mk-muted)"><%= a %></p>
        </details>
      <% end %>
    </div>
  </section>
</div>
<style>details[open] summary span:last-child{transform:rotate(45deg)}details summary span:last-child{transition:transform .2s;display:inline-block}details summary::-webkit-details-marker{display:none}</style>
