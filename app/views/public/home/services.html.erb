<% content_for(:title) { "Our Services" } %>
<% content_for(:meta_description) { "Comprehensive renal care services at Healthroom — nephrology consultation, haemodialysis, peritoneal dialysis, transplant evaluation, lab tests and more." } %>

<div class="mk-pg" data-controller="marketing-filter">
  <section style="background:var(--mk-navy);padding:72px 0 80px">
    <div class="mk-wrap" style="text-align:center">
      <div class="mk-eyebrow mk-eyebrow--light">— Our services</div>
      <h1 class="mk-h1" style="color:#fff;max-width:680px;margin:0 auto">Comprehensive renal care, end to end</h1>
      <p class="mk-lead" style="color:rgba(255,255,255,.65);margin:18px auto 0;max-width:560px">From your first screening to long-term dialysis and transplant support — explore everything we offer.</p>
    </div>
  </section>

  <section class="mk-section" style="padding-top:40px">
    <div class="mk-wrap">
      <% cats = ["All", "Consultation", "Treatment", "Diagnostic", "Surgery", "Laboratory", "Support"] %>
      <div class="mk-chips" style="margin-bottom:44px">
        <% cats.each_with_index do |c, i| %>
          <button class="mk-chip <%= 'is-active' if i.zero? %>" data-filter="<%= c %>" data-action="marketing-filter#filter" data-marketing-filter-target="chip"><%= c %></button>
        <% end %>
      </div>

      <div class="mk-grid mk-grid--3">
        <% @services.each do |s| %>
          <% v = service_visual(s) %>
          <div class="mk-card mk-card--pad" data-category="<%= v[:cat] %>" data-marketing-filter-target="item" style="display:flex;flex-direction:column">
            <span class="mk-icchip mk-icchip--xl <%= v[:tint] %>" style="margin-bottom:20px"><%= mk_icon v[:icon], size: 26 %></span>
            <div style="font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;color:var(--mk-teal-ink)"><%= v[:cat] %></div>
            <div class="mk-h3" style="font-size:20px"><%= s.name %></div>
            <div style="font-size:14.5px;line-height:1.6;color:var(--mk-muted);margin-top:10px;flex:1"><%= s.description.presence || "Expert renal care delivered by our specialist team, using modern technology and evidence-based protocols." %></div>
            <div style="display:flex;align-items:center;gap:14px;margin-top:18px;flex-wrap:wrap">
              <% if s.price_cents.to_i.positive? %>
                <span style="font-weight:800;font-size:18px;color:var(--mk-navy);font-family:var(--mk-display)"><%= format_naira(s.price_cents) %></span>
              <% end %>
              <button class="mk-btn" style="background:var(--mk-teal-soft2);color:var(--mk-teal-ink)" data-action="marketing-booking#open">Book this service →</button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</div>
