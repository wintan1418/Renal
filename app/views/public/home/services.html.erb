<% content_for(:title) { "Our Services" } %>
<% content_for(:meta_description) { "Explore our comprehensive kidney care services including haemodialysis, nephrology consultation, transplant evaluation, and more." } %>

<%
  service_images = {
    "consultation" => "https://images.unsplash.com/photo-1666214280557-091c3f9256e8?w=600&h=400&fit=crop&q=80",
    "procedure"    => "https://images.unsplash.com/photo-1551190822-a9ce113d0d15?w=600&h=400&fit=crop&q=80",
    "lab_test"     => "https://images.unsplash.com/photo-1579165466949-3180a3d056d5?w=600&h=400&fit=crop&q=80",
    "dialysis"     => "https://images.unsplash.com/photo-1530497610245-94d3c16cda28?w=600&h=400&fit=crop&q=80",
    "other"        => "https://images.unsplash.com/photo-1505751172876-fa1923c5c528?w=600&h=400&fit=crop&q=80"
  }

  service_type_styles = {
    "consultation" => { bg: "rgba(43,139,117,0.12)", color: "var(--hr-teal)" },
    "procedure"    => { bg: "rgba(168,85,247,0.12)", color: "#a855f7" },
    "lab_test"     => { bg: "rgba(59,130,246,0.12)", color: "#3b82f6" },
    "dialysis"     => { bg: "rgba(232,119,63,0.12)", color: "var(--hr-orange)" },
    "other"        => { bg: "rgba(20,184,166,0.12)", color: "#14b8a6" }
  }
%>

<!-- Page Header -->
<section class="hr-page-header" style="padding: 5rem 0 4rem">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl">
      <div class="breadcrumbs-text mb-4">
        <%= link_to "Home", root_path %> &nbsp;/&nbsp; <span class="text-white font-medium">Services</span>
      </div>
      <h1>Our Services</h1>
      <p class="text-lg mt-4 leading-relaxed max-w-xl">
        Comprehensive renal care services from preventive screenings to advanced dialysis treatment. Every stage of kidney care covered.
      </p>
    </div>
  </div>
</section>

<!-- Services by Department -->
<section class="py-16 lg:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <% if @departments.any? %>
      <% @departments.each do |department| %>
        <% dept_services = @services.select { |s| s.department_id == department.id } %>
        <% next if dept_services.empty? %>

        <div class="mb-20 last:mb-0">
          <div class="mb-10">
            <span class="hr-section-label">— <%= department.name %></span>
            <h2 class="text-3xl hr-section-title mt-2"><%= department.name %></h2>
            <% if department.description.present? %>
              <p class="text-gray-500 mt-2 text-lg"><%= department.description %></p>
            <% end %>
            <div class="w-20 h-1 rounded-full mt-4" style="background-color: var(--hr-teal)"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% dept_services.each do |service| %>
              <% stype = service_type_styles[service.service_type] || service_type_styles['other'] %>
              <div class="hr-service-card-img group">
                <div class="card-thumb relative">
                  <img src="<%= service_images[service.service_type] || service_images['other'] %>" alt="<%= service.name %>" loading="lazy" />
                  <div class="absolute top-4 right-4">
                    <span class="hr-blog-chip" style="background: <%= stype[:bg] %>; color: <%= stype[:color] %>"><%= service.service_type.humanize %></span>
                  </div>
                </div>
                <div class="card-body">
                  <h3 class="font-bold text-lg" style="color: var(--hr-navy)"><%= service.name %></h3>
                  <p class="text-gray-500 text-sm leading-relaxed mt-2"><%= service.description.presence || "Expert care from our experienced medical team." %></p>
                  <div class="flex items-center justify-between mt-5 pt-4" style="border-top: 1px solid #f0f0f0">
                    <% if service.price_cents > 0 %>
                      <span class="font-bold text-lg" style="color: var(--hr-teal)"><%= format_naira(service.price_cents) %></span>
                    <% else %>
                      <span class="text-gray-400 text-sm">Price on consultation</span>
                    <% end %>
                    <% if service.duration_minutes %>
                      <span class="text-xs text-gray-400 flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <%= service.duration_minutes %> min
                      </span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Services without a department %>
      <% orphan_services = @services.select { |s| s.department_id.nil? } %>
      <% if orphan_services.any? %>
        <div class="mb-20">
          <div class="mb-10">
            <span class="hr-section-label">— General</span>
            <h2 class="text-3xl hr-section-title mt-2">General Services</h2>
            <div class="w-20 h-1 rounded-full mt-4" style="background-color: var(--hr-teal)"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% orphan_services.each do |service| %>
              <% stype = service_type_styles[service.service_type] || service_type_styles['other'] %>
              <div class="hr-service-card-img group">
                <div class="card-thumb relative">
                  <img src="<%= service_images[service.service_type] || service_images['other'] %>" alt="<%= service.name %>" loading="lazy" />
                  <div class="absolute top-4 right-4">
                    <span class="hr-blog-chip" style="background: <%= stype[:bg] %>; color: <%= stype[:color] %>"><%= service.service_type.humanize %></span>
                  </div>
                </div>
                <div class="card-body">
                  <h3 class="font-bold text-lg" style="color: var(--hr-navy)"><%= service.name %></h3>
                  <p class="text-gray-500 text-sm leading-relaxed mt-2"><%= service.description.presence || "Expert care from our experienced medical team." %></p>
                  <div class="flex items-center justify-between mt-5 pt-4" style="border-top: 1px solid #f0f0f0">
                    <% if service.price_cents > 0 %>
                      <span class="font-bold text-lg" style="color: var(--hr-teal)"><%= format_naira(service.price_cents) %></span>
                    <% else %>
                      <span class="text-gray-400 text-sm">Price on consultation</span>
                    <% end %>
                    <% if service.duration_minutes %>
                      <span class="text-xs text-gray-400 flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <%= service.duration_minutes %> min
                      </span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    <% else %>
      <% if @services.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @services.each do |service| %>
            <% stype = service_type_styles[service.service_type] || service_type_styles['other'] %>
            <div class="hr-service-card-img group">
              <div class="card-thumb relative">
                <img src="<%= service_images[service.service_type] || service_images['other'] %>" alt="<%= service.name %>" loading="lazy" />
                <div class="absolute top-4 right-4">
                  <span class="hr-blog-chip" style="background: <%= stype[:bg] %>; color: <%= stype[:color] %>"><%= service.service_type.humanize %></span>
                </div>
              </div>
              <div class="card-body">
                <h3 class="font-bold text-lg" style="color: var(--hr-navy)"><%= service.name %></h3>
                <p class="text-gray-500 text-sm leading-relaxed mt-2"><%= service.description.presence || "Expert care from our experienced medical team." %></p>
                <div class="flex items-center justify-between mt-5 pt-4" style="border-top: 1px solid #f0f0f0">
                  <% if service.price_cents > 0 %>
                    <span class="font-bold text-lg" style="color: var(--hr-teal)"><%= format_naira(service.price_cents) %></span>
                  <% else %>
                    <span class="text-gray-400 text-sm">Price on consultation</span>
                  <% end %>
                  <% if service.duration_minutes %>
                    <span class="text-xs text-gray-400 flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                      <%= service.duration_minutes %> min
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-16">
          <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6" style="background: rgba(43,139,117,0.1)">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--hr-teal)">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-400">Services Coming Soon</h3>
          <p class="text-gray-400 mt-3 max-w-md mx-auto text-lg">Our services catalogue is being updated. Please contact us for more information.</p>
          <%= link_to "Contact Us", contact_path, class: "btn hr-btn-teal mt-6 rounded-xl" %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<!-- CTA -->
<section class="py-12 lg:py-20" style="background-color: var(--hr-cream)">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="hr-cta-section p-10 lg:p-14">
      <div class="text-center">
        <h2 class="text-2xl lg:text-3xl font-extrabold text-white leading-snug">
          Need Help Choosing the Right Service?
        </h2>
        <p class="mt-4 text-gray-300/60 text-lg max-w-xl mx-auto">
          Our medical team can guide you to the right treatment plan. Book a consultation today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
          <%= link_to "Book a Consultation", contact_path, class: "btn btn-lg hr-btn-orange rounded-xl font-semibold gap-2 shadow-lg" %>
          <a href="tel:<%= current_hospital.phone.presence || '+2348000000000' %>" class="btn btn-lg hr-btn-ghost-white rounded-xl font-semibold gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            Call Us
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
