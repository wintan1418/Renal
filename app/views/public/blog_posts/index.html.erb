<% content_for(:title) { "Blog — Kidney Health & Wellness" } %>
<% content_for(:meta_description) { "Read expert articles on kidney health, dialysis tips, nutrition and wellness from the Healthroom Renal Centre medical team." } %>

<div class="mk-pg" data-controller="marketing-filter">
  <section class="mk-section" style="padding:72px 0 40px;text-align:center">
    <div class="mk-wrap">
      <div class="mk-eyebrow">— From our blog</div>
      <h1 class="mk-h1">Health &amp; wellness insights</h1>
      <p class="mk-lead" style="margin:18px auto 0;max-width:560px">Expert advice from our medical team on kidney health, dialysis, nutrition and living well.</p>
    </div>
  </section>

  <section class="mk-section" style="padding-top:0">
    <div class="mk-wrap">
      <% cats = ["All"] + @posts.map { |p| blog_category_label(p) }.uniq %>
      <div class="mk-chips" style="margin-bottom:44px">
        <% cats.each_with_index do |c, i| %>
          <button class="mk-chip <%= 'is-active' if i.zero? %>" data-filter="<%= c %>" data-action="marketing-filter#filter" data-marketing-filter-target="chip"><%= c %></button>
        <% end %>
      </div>

      <% if @posts.any? %>
        <div class="mk-grid mk-grid--3" style="gap:24px">
          <% @posts.each_with_index do |p, i| %>
            <div class="mk-card mk-card--hover" data-category="<%= blog_category_label(p) %>" data-marketing-filter-target="item" style="overflow:hidden;display:flex;flex-direction:column">
              <%= link_to blog_post_path(p.slug), style: "text-decoration:none;display:block" do %>
                <%= image_tag blog_image_for(p, i), alt: p.title, loading: "lazy", class: "mk-card__media", style: "height:200px" %>
              <% end %>
              <div style="padding:24px;display:flex;flex-direction:column;flex:1">
                <span class="mk-cat" style="align-self:flex-start;margin-bottom:14px"><%= blog_category_label(p) %></span>
                <%= link_to blog_post_path(p.slug), style: "text-decoration:none" do %>
                  <div class="mk-h3" style="font-size:19px;line-height:1.25"><%= p.title %></div>
                <% end %>
                <p style="font-size:14px;line-height:1.6;color:var(--mk-muted);margin-top:10px;flex:1"><%= p.excerpt.presence&.truncate(120) || truncate(strip_tags(p.body.to_s), length: 120) %></p>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-top:18px">
                  <span style="font-size:12.5px;color:var(--mk-muted-3)"><%= p.published_at&.strftime("%b %d, %Y") %> · <%= blog_read_time(p) %></span>
                  <%= link_to "Read →", blog_post_path(p.slug), style: "font-size:14px;font-weight:700;color:var(--mk-teal);text-decoration:none" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <% if @pagy && @pagy.pages > 1 %>
          <div style="display:flex;justify-content:center;margin-top:48px"><%== pagy_nav(@pagy) %></div>
        <% end %>
      <% else %>
        <div class="mk-card mk-card--pad" style="text-align:center;padding:64px"><p class="mk-muted">No posts published yet. Check back soon.</p></div>
      <% end %>
    </div>
  </section>
</div>
