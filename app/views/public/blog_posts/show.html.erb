<% content_for(:title) { @post.title } %>
<% content_for(:meta_description) { @post.excerpt.presence || truncate(strip_tags(@post.body.to_s), length: 160) } %>

<div class="mk-pg">
  <section class="mk-section--cream" style="border-top:none;padding:56px 0 48px">
    <div class="mk-wrap" style="max-width:820px">
      <div style="font-size:13px;color:var(--mk-muted-2);margin-bottom:20px">
        <%= link_to "Home", root_path, style: "color:var(--mk-muted-2);text-decoration:none" %> &nbsp;/&nbsp;
        <%= link_to "Blog", blog_posts_path, style: "color:var(--mk-muted-2);text-decoration:none" %> &nbsp;/&nbsp;
        <span style="color:var(--mk-ink);font-weight:600"><%= truncate(@post.title, length: 48) %></span>
      </div>
      <span class="mk-cat" style="margin-bottom:16px"><%= blog_category_label(@post) %></span>
      <h1 class="mk-h1" style="font-size:clamp(30px,4vw,44px);margin-top:14px"><%= @post.title %></h1>
      <div style="display:flex;align-items:center;gap:18px;margin-top:22px;flex-wrap:wrap;font-size:14px;color:var(--mk-muted-2)">
        <span style="display:flex;align-items:center;gap:8px">
          <span class="mk-avatar" style="width:34px;height:34px;font-size:12px"><%= @post.author&.initials || "HR" %></span>
          <strong style="color:var(--mk-ink)"><%= @post.author&.full_name || "Healthroom Team" %></strong>
        </span>
        <span><%= @post.published_at&.strftime("%B %d, %Y") || @post.created_at.strftime("%B %d, %Y") %></span>
        <span><%= blog_read_time(@post) %></span>
        <span><%= @post.views_count %> views</span>
      </div>
    </div>
  </section>

  <section class="mk-section" style="padding:48px 0 80px">
    <div class="mk-wrap" style="max-width:820px">
      <%= image_tag blog_image_for(@post), alt: @post.title, style: "width:100%;height:auto;max-height:440px;object-fit:cover;border-radius:20px;margin-bottom:36px" %>
      <article style="font-size:17px;line-height:1.8;color:oklch(0.35 0.02 165)" class="mk-article">
        <% if @post.respond_to?(:rich_body) && @post.rich_body.present? %>
          <%= @post.rich_body %>
        <% else %>
          <%= simple_format(@post.body) %>
        <% end %>
      </article>

      <div style="margin:40px 0;border-top:1px solid var(--mk-line)"></div>
      <div class="mk-card mk-card--pad" style="background:var(--mk-cream);border:none;display:flex;gap:16px;align-items:flex-start">
        <span class="mk-avatar" style="width:56px;height:56px;font-size:18px"><%= @post.author&.initials || "HR" %></span>
        <div>
          <div style="font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--mk-teal-ink)">Written by</div>
          <div style="font-weight:700;font-size:18px;color:var(--mk-navy)"><%= @post.author&.full_name || "Healthroom Team" %></div>
          <p style="font-size:14px;color:var(--mk-muted);margin-top:4px"><%= @post.author&.staff_profile&.bio.presence&.truncate(160) || "Medical professional at Healthroom Renal Centre, contributing to our health and wellness blog." %></p>
        </div>
      </div>
      <div style="margin-top:32px">
        <%= link_to "← Back to blog", blog_posts_path, style: "color:var(--mk-teal);font-weight:600;text-decoration:none" %>
      </div>
    </div>
  </section>
</div>
<style>.mk-article h2{font-family:var(--mk-display);font-size:26px;font-weight:800;color:var(--mk-navy);margin:28px 0 12px}.mk-article h3{font-family:var(--mk-display);font-size:20px;font-weight:700;color:var(--mk-ink);margin:22px 0 10px}.mk-article p{margin-bottom:16px}.mk-article ul,.mk-article ol{margin:0 0 16px 22px}.mk-article li{margin-bottom:6px}.mk-article a{color:var(--mk-teal);text-decoration:underline}</style>
