<% content_for(:title) { "Patient Testimonials" } %>
<% content_for(:meta_description) { "Read real stories from patients whose lives have been transformed by the expert kidney care at Healthroom Renal Centre." } %>

<div class="mk-pg">
  <section class="mk-section--cream" style="border-top:none;padding:72px 0 64px;text-align:center">
    <div class="mk-wrap">
      <div class="mk-eyebrow">— What our patients say</div>
      <h1 class="mk-h1">Real stories, real healing</h1>
      <p class="mk-lead" style="margin:18px auto 0;max-width:560px">Hear from the patients and families who trust us with their kidney care.</p>
    </div>
  </section>

  <section class="mk-section">
    <div class="mk-wrap">
      <% if @testimonials.any? %>
        <div class="mk-grid mk-grid--3">
          <% @testimonials.each do |t| %>
            <div class="mk-card mk-card--pad" style="display:flex;flex-direction:column">
              <div class="mk-stars" style="font-size:15px;letter-spacing:2px;margin-bottom:16px"><%= "★" * t.rating.to_i %><span style="color:var(--mk-line-2)"><%= "★" * (5 - t.rating.to_i) %></span></div>
              <p style="font-size:15px;line-height:1.65;color:oklch(0.34 0.02 165);flex:1">“<%= t.content %>”</p>
              <div style="display:flex;align-items:center;gap:13px;margin-top:22px;padding-top:20px;border-top:1px solid var(--mk-line)">
                <div style="width:44px;height:44px;border-radius:50%;background:var(--mk-teal);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px;font-family:var(--mk-display)"><%= t.patient_name.to_s.split.map(&:first).first(2).join.upcase %></div>
                <div><div style="font-weight:700;font-size:15px;color:var(--mk-ink)"><%= t.patient_name %></div><div style="font-size:12.5px;color:var(--mk-muted-2)">Verified patient</div></div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="mk-card mk-card--pad" style="text-align:center;padding:64px"><p class="mk-muted">No testimonials yet.</p></div>
      <% end %>
    </div>
  </section>
</div>
