<% content_for(:title) { "Patient Testimonials" } %>
<% content_for(:meta_description) { "Read real stories from patients whose lives have been transformed by the expert kidney care at Healthroom Renal Centre." } %>

<!-- Page Header -->
<section class="hr-page-header">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl">
      <div class="breadcrumbs-text mb-4">
        <%= link_to "Home", root_path %> &nbsp;/&nbsp; <span class="text-white font-medium">Testimonials</span>
      </div>
      <h1>Patient Testimonials</h1>
      <p class="text-lg mt-4 leading-relaxed max-w-xl">
        Hear from patients who have experienced the quality of care at Healthroom Renal Centre.
        Their stories inspire us to keep improving and delivering the best renal care possible.
      </p>
    </div>
  </div>
</section>

<!-- Testimonials Grid -->
<section class="py-16 lg:py-20" style="background-color: var(--hr-cream)">
  <div class="max-w-7xl mx-auto px-4">
    <% if @testimonials.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @testimonials.each do |testimonial| %>
          <div class="hr-testimonial-card">
            <!-- Stars -->
            <% if testimonial.rating %>
              <div class="hr-stars mb-3">
                <% 5.times do |i| %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="color: <%= i < testimonial.rating ? '#fbbf24' : '#e5e7eb' %>; fill: <%= i < testimonial.rating ? '#fbbf24' : '#e5e7eb' %>">
                    <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  </svg>
                <% end %>
              </div>
            <% end %>

            <!-- Quote icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mb-2" fill="currentColor" viewBox="0 0 24 24" style="color: rgba(43,139,117,0.15)">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>

            <!-- Content -->
            <p class="text-gray-600 leading-relaxed flex-1"><%= testimonial.content %></p>

            <!-- Author -->
            <div class="flex items-center gap-3 mt-6 pt-4" style="border-top: 1px solid #f0ede8">
              <% if testimonial.photo.attached? %>
                <%= image_tag testimonial.photo.variant(resize_to_limit: [80, 80]),
                    class: "w-12 h-12 rounded-full object-cover",
                    alt: testimonial.patient_name %>
              <% else %>
                <div class="w-12 h-12 rounded-full flex items-center justify-center font-bold text-sm" style="background: rgba(43,139,117,0.1); color: var(--hr-teal)">
                  <%= testimonial.patient_name.split.map { |n| n[0] }.join.upcase %>
                </div>
              <% end %>
              <div>
                <p class="font-semibold" style="color: var(--hr-navy)"><%= testimonial.patient_name %></p>
                <p class="text-xs text-gray-400">Patient</p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4" fill="currentColor" viewBox="0 0 24 24" style="color: rgba(43,139,117,0.2)">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
        </svg>
        <h3 class="text-xl font-semibold text-gray-400">Testimonials Coming Soon</h3>
        <p class="text-gray-400 mt-2 max-w-md mx-auto">
          We are gathering stories from our patients. Check back soon to read about their experiences.
        </p>
        <%= link_to "Back to Home", root_path, class: "btn hr-btn-teal rounded-xl mt-4" %>
      </div>
    <% end %>
  </div>
</section>

<!-- CTA -->
<section class="py-12 lg:py-20 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="hr-cta-section p-10 lg:p-14 text-center">
      <h2 class="text-2xl lg:text-3xl font-extrabold text-white leading-snug">Experience Our Care Firsthand</h2>
      <p class="mt-4 text-lg max-w-xl mx-auto" style="color: rgba(255,255,255,0.55)">
        Join thousands of satisfied patients. Book your consultation today.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
        <%= link_to "Book an Appointment", contact_path, class: "btn btn-lg hr-btn-orange rounded-xl font-semibold" %>
        <%= link_to "Learn About Our Services", public_services_path, class: "btn btn-lg hr-btn-ghost-white rounded-xl font-semibold" %>
      </div>
    </div>
  </div>
</section>
