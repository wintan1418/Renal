<% content_for(:title, "Create Account") %>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary/5 to-secondary/5 px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <a href="<%= root_path %>" class="text-3xl font-bold text-primary">Healthroom</a>
      <p class="text-base-content/60 mt-2">Create your patient account</p>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
          <% if resource.errors.any? %>
            <div class="alert alert-error">
              <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <div>
                <% resource.errors.full_messages.each do |msg| %>
                  <p class="text-sm"><%= msg %></p>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="grid grid-cols-2 gap-3">
            <div class="form-control">
              <%= f.label :first_name, class: "label" do %>
                <span class="label-text font-medium">First Name</span>
              <% end %>
              <%= f.text_field :first_name, autofocus: true, placeholder: "First name", class: "input input-bordered w-full" %>
            </div>

            <div class="form-control">
              <%= f.label :last_name, class: "label" do %>
                <span class="label-text font-medium">Last Name</span>
              <% end %>
              <%= f.text_field :last_name, placeholder: "Last name", class: "input input-bordered w-full" %>
            </div>
          </div>

          <div class="form-control">
            <%= f.label :email, class: "label" do %>
              <span class="label-text font-medium">Email</span>
            <% end %>
            <%= f.email_field :email, autocomplete: "email", placeholder: "you@example.com", class: "input input-bordered w-full" %>
          </div>

          <div class="form-control">
            <%= f.label :phone, class: "label" do %>
              <span class="label-text font-medium">Phone Number</span>
            <% end %>
            <%= f.telephone_field :phone, placeholder: "+234 800 000 0000", class: "input input-bordered w-full" %>
          </div>

          <div class="form-control">
            <%= f.label :password, class: "label" do %>
              <span class="label-text font-medium">Password</span>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password", placeholder: "Min. 6 characters", class: "input input-bordered w-full" %>
          </div>

          <div class="form-control">
            <%= f.label :password_confirmation, class: "label" do %>
              <span class="label-text font-medium">Confirm Password</span>
            <% end %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm password", class: "input input-bordered w-full" %>
          </div>

          <%= f.hidden_field :role, value: "patient" %>

          <div class="form-control mt-6">
            <%= f.submit "Create Account", class: "btn btn-primary w-full" %>
          </div>
        <% end %>

        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
