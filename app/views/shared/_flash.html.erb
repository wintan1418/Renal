<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <% alert_class = case type.to_s
    when "notice", "success" then "alert-success"
    when "alert", "error"   then "alert-error"
    when "warning"           then "alert-warning"
    else "alert-info"
  end %>

  <div class="alert <%= alert_class %> shadow-sm mb-4" role="alert" data-controller="dismissible">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24">
      <% if type.to_s.in?(%w[notice success]) %>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      <% elsif type.to_s.in?(%w[alert error]) %>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      <% elsif type.to_s == "warning" %>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      <% else %>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      <% end %>
    </svg>
    <span><%= message %></span>
    <button class="btn btn-ghost btn-xs" data-action="click->dismissible#dismiss">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
<% end %>

<script>
  document.addEventListener("turbo:load", function() {
    document.querySelectorAll('[data-controller="dismissible"]').forEach(function(el) {
      setTimeout(function() {
        el.style.transition = "opacity 0.5s ease";
        el.style.opacity = "0";
        setTimeout(function() { el.remove(); }, 500);
      }, 5000);
    });
  });

  document.querySelectorAll('[data-controller="dismissible"]').forEach(function(el) {
    el.querySelector('[data-action]')?.addEventListener("click", function() {
      el.style.transition = "opacity 0.3s ease";
      el.style.opacity = "0";
      setTimeout(function() { el.remove(); }, 300);
    });
  });
</script>
