<%#
  Reusable dashboard stat card.
  locals: label:, value:, desc: (optional), icon: (SVG path d), tone: (primary|secondary|accent|success|error|info|warning), href: (optional)
%>
<% tone = local_assigns.fetch(:tone, "primary") %>
<%# Literal class strings so Tailwind's scanner emits these utilities. %>
<% icon_tone = {
     "primary"   => "bg-primary/10 text-primary",
     "secondary" => "bg-secondary/10 text-secondary",
     "accent"    => "bg-accent/10 text-accent",
     "success"   => "bg-success/10 text-success",
     "error"     => "bg-error/10 text-error",
     "info"      => "bg-info/10 text-info",
     "warning"   => "bg-warning/10 text-warning"
   }.fetch(tone, "bg-primary/10 text-primary") %>
<% href = local_assigns[:href] %>
<% wrapper = href ? :a : :div %>
<%= content_tag wrapper, (href ? { href: href } : {}).merge(class: "card group #{'transition-shadow hover:shadow-card-hover' if href}") do %>
  <div class="card-body gap-0 p-5">
    <div class="flex items-start justify-between gap-3">
      <p class="text-sm font-medium text-base-content/60"><%= label %></p>
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg <%= icon_tone %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>" />
        </svg>
      </span>
    </div>
    <p class="mt-2 text-3xl font-extrabold tracking-tight text-base-content"><%= value %></p>
    <% if local_assigns[:desc].present? %>
      <p class="mt-1 text-xs text-base-content/50"><%= desc %></p>
    <% end %>
  </div>
<% end %>
