<% content_for(:title, "Record Payment") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= receptionist_root_path %>">Dashboard</a></li>
    <li><a href="<%= receptionist_invoices_path %>">Invoices</a></li>
    <li><a href="<%= receptionist_invoice_path(@invoice) %>"><%= @invoice.invoice_number %></a></li>
    <li>Record Payment</li>
  </ul>
</div>

<div class="max-w-lg mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-extrabold">Record Payment</h1>
    <p class="text-base-content/60 text-sm mt-1">For Invoice <%= @invoice.invoice_number %> &mdash; <%= @invoice.patient&.full_name %></p>
  </div>

  <!-- Invoice Summary -->
  <div class="bg-base-200 rounded-2xl p-4 mb-6">
    <div class="flex justify-between text-sm mb-1">
      <span class="text-base-content/60">Invoice Total</span>
      <span class="font-semibold"><%= money_symbol %><%= number_with_delimiter(@invoice.total_cents / 100) %></span>
    </div>
    <div class="flex justify-between text-sm mb-1">
      <span class="text-base-content/60">Amount Paid</span>
      <span class="text-success font-semibold"><%= money_symbol %><%= number_with_delimiter(@invoice.amount_paid_cents / 100) %></span>
    </div>
    <div class="divider my-2"></div>
    <div class="flex justify-between font-bold text-lg text-error">
      <span>Balance Due</span>
      <span><%= money_symbol %><%= number_with_delimiter(@invoice.balance_due_cents / 100) %></span>
    </div>
  </div>

  <%= form_with model: @payment, url: receptionist_payments_path, class: "bg-white rounded-2xl shadow-lg p-6 space-y-4" do |f| %>
    <%= f.hidden_field :invoice_id, value: @invoice.id %>

    <div class="form-control">
      <%= f.label :payment_method, "Payment Method", class: "label label-text font-medium" %>
      <%= f.select :payment_method,
        [["Cash", "cash"], ["Bank Transfer", "bank_transfer"], ["POS/Card", "card"], ["Cheque", "cheque"]],
        { prompt: "Select method..." },
        class: "select select-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :amount_cents, "Amount (cents)", class: "label label-text font-medium" %>
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-base-content/50 text-sm"><%= money_symbol %></span>
        <%= f.number_field :amount_cents, min: 1, step: 100,
          value: @invoice.balance_due_cents,
          class: "input input-bordered w-full pl-7",
          placeholder: "Enter amount in cents (100 cents = 1 unit)" %>
      </div>
      <p class="text-xs text-base-content/50 mt-1">Enter amount in minor units (100 = #{money_symbol}1).</p>
    </div>

    <div class="form-control">
      <%= f.label :notes, "Notes (optional)", class: "label label-text font-medium" %>
      <%= f.text_area :notes, rows: 2, class: "textarea textarea-bordered w-full", placeholder: "Transaction reference, notes..." %>
    </div>

    <div class="flex gap-3 justify-end">
      <%= link_to "Cancel", receptionist_invoice_path(@invoice), class: "btn btn-ghost" %>
      <%= f.submit "Record Payment", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
