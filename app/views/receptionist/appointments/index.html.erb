<% content_for(:title, "Appointments") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= receptionist_root_path %>">Dashboard</a></li>
    <li>Appointments</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-extrabold">Appointments</h1>
  <div class="flex gap-2">
    <%= link_to today_receptionist_appointments_path, class: "btn btn-info btn-sm btn-outline" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      Today
    <% end %>
    <%= link_to new_receptionist_appointment_path, class: "btn btn-primary btn-sm" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      Walk-in
    <% end %>
  </div>
</div>

<!-- Filters -->
<div class="bg-white rounded-2xl shadow-lg p-4 mb-6">
  <%= form_with url: receptionist_appointments_path, method: :get, class: "flex flex-col sm:flex-row gap-3" do |f| %>
    <div class="form-control flex-1">
      <%= f.search_field :q, value: params[:q], class: "input input-bordered input-sm w-full", placeholder: "Search by patient name..." %>
    </div>
    <div class="form-control">
      <%= f.date_field :date, value: params[:date], class: "input input-bordered input-sm", placeholder: "Date" %>
    </div>
    <div class="form-control">
      <%= f.select :status, Appointment.statuses.keys.map { |s| [s.humanize, s] }, { prompt: "All Statuses" }, class: "select select-bordered select-sm", value: params[:status] %>
    </div>
    <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
    <% if params[:q].present? || params[:date].present? || params[:status].present? %>
      <%= link_to "Clear", receptionist_appointments_path, class: "btn btn-ghost btn-sm" %>
    <% end %>
  <% end %>
</div>

<!-- Appointments Table -->
<div class="bg-white rounded-2xl shadow-lg overflow-hidden">
  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Time</th>
          <th>Patient</th>
          <th>Doctor</th>
          <th>Service</th>
          <th>Type</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @appointments.each do |appointment| %>
          <tr class="hover">
            <td class="font-medium"><%= appointment.scheduled_date.strftime("%b %d, %Y") %></td>
            <td><%= appointment.start_time.strftime("%I:%M %p") %></td>
            <td>
              <div class="flex items-center gap-2">
                <%= avatar_for(appointment.patient, size: "w-7 h-7", text_size: "text-xs") %>
                <div>
                  <div class="font-medium text-sm"><%= appointment.patient.full_name %></div>
                  <div class="text-xs text-base-content/50"><%= appointment.patient.patient_profile&.medical_record_number %></div>
                </div>
              </div>
            </td>
            <td class="text-sm">Dr. <%= appointment.doctor.full_name %></td>
            <td class="text-sm"><%= appointment.service.name %></td>
            <td><span class="badge badge-outline badge-xs"><%= appointment.appointment_type.humanize %></span></td>
            <td><%= status_badge(appointment.status, type: :appointment) %></td>
            <td>
              <div class="flex gap-1">
                <%= link_to receptionist_appointment_path(appointment), class: "btn btn-ghost btn-xs" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  </svg>
                <% end %>
                <% if appointment.pending? || appointment.confirmed? %>
                  <%= button_to check_in_receptionist_appointment_path(appointment), method: :patch, class: "btn btn-accent btn-xs" do %>
                    Check In
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @appointments.empty? %>
          <tr>
            <td colspan="8" class="text-center py-8 text-base-content/60">No appointments found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mt-6">
    <div class="join">
      <%== pagy_nav(@pagy) %>
    </div>
  </div>
<% end %>
