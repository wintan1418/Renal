<% content_for(:title) { "My Profile" } %>

<div class="max-w-5xl mx-auto space-y-6">

  <!-- Header card -->
  <div class="card bg-base-100 shadow-xl overflow-hidden">
    <div class="h-24 bg-gradient-to-r from-primary to-secondary"></div>
    <div class="card-body pt-0">
      <div class="flex flex-col sm:flex-row sm:items-end gap-4 -mt-12">
        <div class="ring-4 ring-base-100 rounded-full w-fit">
          <%= avatar_for @user, size: "w-24 h-24", text_size: "text-2xl" %>
        </div>
        <div class="flex-1">
          <h1 class="text-2xl font-bold"><%= @user.full_name %></h1>
          <p class="text-base-content/60"><%= @user.email %></p>
        </div>
        <div class="badge badge-primary badge-lg capitalize"><%= @user.role.humanize %></div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Left: account + role-specific + password -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Account details -->
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-base mb-2">Account details</h2>
          <%= form_with model: @user, url: profile_path, method: :patch, html: { class: "space-y-4", multipart: true } do |f| %>
            <div class="form-control">
              <label class="label"><span class="label-text font-medium">Profile photo</span></label>
              <div class="flex items-center gap-4">
                <%= avatar_for @user, size: "w-14 h-14", text_size: "text-lg" %>
                <%= f.file_field :avatar, accept: "image/png,image/jpeg,image/webp", class: "file-input file-input-bordered file-input-sm w-full max-w-xs" %>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="form-control">
                <label class="label"><span class="label-text font-medium">First name</span></label>
                <%= f.text_field :first_name, class: "input input-bordered w-full" %>
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-medium">Last name</span></label>
                <%= f.text_field :last_name, class: "input input-bordered w-full" %>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="form-control">
                <label class="label"><span class="label-text font-medium">Email</span></label>
                <%= f.email_field :email, class: "input input-bordered w-full" %>
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-medium">Phone</span></label>
                <%= f.telephone_field :phone, placeholder: "+234 ...", class: "input input-bordered w-full" %>
              </div>
            </div>

            <div class="flex justify-end">
              <%= f.submit "Save changes", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Role-specific profile -->
      <% if @profile && @user.patient? %>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-base mb-2">Contact &amp; insurance</h2>
            <%= form_with model: @profile, url: profile_path, method: :patch, scope: :profile, html: { class: "space-y-4" } do |f| %>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="form-control sm:col-span-2">
                  <label class="label"><span class="label-text font-medium">Address</span></label>
                  <%= f.text_field :address, class: "input input-bordered w-full" %>
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">City</span></label>
                  <%= f.text_field :city, class: "input input-bordered w-full" %>
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">State</span></label>
                  <%= f.text_field :state, class: "input input-bordered w-full" %>
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">LGA</span></label>
                  <%= f.text_field :lga, class: "input input-bordered w-full" %>
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">Occupation</span></label>
                  <%= f.text_field :occupation, class: "input input-bordered w-full" %>
                </div>
              </div>

              <div class="divider my-1 text-xs text-base-content/50">Next of kin</div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">Name</span></label>
                  <%= f.text_field :nok_name, class: "input input-bordered w-full" %>
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">Phone</span></label>
                  <%= f.telephone_field :nok_phone, class: "input input-bordered w-full" %>
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">Relationship</span></label>
                  <%= f.text_field :nok_relationship, class: "input input-bordered w-full" %>
                </div>
              </div>

              <div class="divider my-1 text-xs text-base-content/50">Insurance</div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">Provider</span></label>
                  <%= f.text_field :insurance_provider, class: "input input-bordered w-full" %>
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">Policy number</span></label>
                  <%= f.text_field :insurance_policy_number, class: "input input-bordered w-full" %>
                </div>
              </div>

              <div class="flex justify-end">
                <%= f.submit "Save details", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      <% elsif @profile %>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-base mb-2">Professional details</h2>
            <%= form_with model: @profile, url: profile_path, method: :patch, scope: :profile, html: { class: "space-y-4" } do |f| %>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">Specialization</span></label>
                  <%= f.text_field :specialization, class: "input input-bordered w-full" %>
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text font-medium">Qualification</span></label>
                  <%= f.text_field :qualification, class: "input input-bordered w-full" %>
                </div>
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-medium">Bio</span></label>
                <%= f.text_area :bio, rows: 4, class: "textarea textarea-bordered w-full" %>
              </div>
              <div class="form-control">
                <label class="label cursor-pointer justify-start gap-3">
                  <%= f.check_box :available_for_telemedicine, class: "toggle toggle-primary" %>
                  <span class="label-text font-medium">Available for telemedicine</span>
                </label>
              </div>
              <div class="flex justify-end">
                <%= f.submit "Save details", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Change password -->
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-base mb-2">Change password</h2>
          <%= form_with model: @user, url: profile_path, method: :patch, html: { class: "space-y-4" } do |f| %>
            <div class="form-control">
              <label class="label"><span class="label-text font-medium">Current password</span></label>
              <%= f.password_field :current_password, autocomplete: "current-password", class: "input input-bordered w-full" %>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="form-control">
                <label class="label"><span class="label-text font-medium">New password</span></label>
                <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full" %>
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-medium">Confirm new password</span></label>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>
              </div>
            </div>
            <p class="text-xs text-base-content/50">Minimum 6 characters. Leave blank to keep your current password.</p>
            <div class="flex justify-end">
              <%= f.submit "Update password", class: "btn btn-outline" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right: at-a-glance info -->
    <div class="space-y-6">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-base mb-2">Account info</h2>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between gap-3">
              <dt class="text-base-content/60">Role</dt>
              <dd class="font-medium capitalize"><%= @user.role.humanize %></dd>
            </div>
            <% if @user.patient? && @profile&.medical_record_number.present? %>
              <div class="flex justify-between gap-3">
                <dt class="text-base-content/60">MRN</dt>
                <dd class="font-medium"><%= @profile.medical_record_number %></dd>
              </div>
            <% end %>
            <% if @profile.respond_to?(:employee_id) && @profile&.employee_id.present? %>
              <div class="flex justify-between gap-3">
                <dt class="text-base-content/60">Employee ID</dt>
                <dd class="font-medium"><%= @profile.employee_id %></dd>
              </div>
            <% end %>
            <div class="flex justify-between gap-3">
              <dt class="text-base-content/60">Member since</dt>
              <dd class="font-medium"><%= @user.created_at.strftime("%b %d, %Y") %></dd>
            </div>
            <% if @user.last_sign_in_at %>
              <div class="flex justify-between gap-3">
                <dt class="text-base-content/60">Last sign in</dt>
                <dd class="font-medium"><%= @user.last_sign_in_at.strftime("%b %d, %Y") %></dd>
              </div>
            <% end %>
            <div class="flex justify-between gap-3">
              <dt class="text-base-content/60">Status</dt>
              <dd>
                <span class="badge <%= @user.active? ? 'badge-success' : 'badge-ghost' %> badge-sm">
                  <%= @user.active? ? "Active" : "Inactive" %>
                </span>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <% if @user.patient? && @profile %>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-base mb-2">Medical summary</h2>
            <p class="text-xs text-base-content/50 mb-2">Managed by your care team.</p>
            <dl class="space-y-3 text-sm">
              <% {
                "Blood group" => @profile.blood_group&.humanize,
                "Genotype" => @profile.genotype&.humanize&.upcase,
                "CKD stage" => @profile.ckd_stage&.humanize,
                "On dialysis" => (@profile.on_dialysis? ? "Yes" : "No")
              }.each do |label, value| %>
                <% next if value.blank? %>
                <div class="flex justify-between gap-3">
                  <dt class="text-base-content/60"><%= label %></dt>
                  <dd class="font-medium"><%= value %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
