<% content_for(:title, "Enter Result - #{@lab_result.lab_test.name}") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= staff_root_path %>">Dashboard</a></li>
    <li><a href="<%= staff_patients_path %>">Patients</a></li>
    <li><a href="<%= chart_staff_patient_path(@patient) %>"><%= @patient.full_name %></a></li>
    <li><a href="<%= staff_patient_lab_order_path(@patient, @lab_result.lab_order) %>">Lab Order #<%= @lab_result.lab_order_id %></a></li>
    <li>Enter Result</li>
  </ul>
</div>

<h1 class="text-2xl font-extrabold mb-6">Enter Lab Result: <%= @lab_result.lab_test.name %></h1>

<div class="max-w-xl">
  <!-- Test Reference Card -->
  <div class="card bg-base-200 mb-6">
    <div class="card-body py-4">
      <h3 class="font-bold text-sm">Test Reference</h3>
      <div class="grid grid-cols-2 gap-4 mt-2">
        <div>
          <p class="text-xs text-base-content/50">Test Code</p>
          <p class="font-mono text-sm font-medium"><%= @lab_result.lab_test.code %></p>
        </div>
        <div>
          <p class="text-xs text-base-content/50">Unit</p>
          <p class="text-sm font-medium"><%= @lab_result.lab_test.unit.presence || "--" %></p>
        </div>
        <div class="col-span-2">
          <p class="text-xs text-base-content/50">Normal Range</p>
          <p class="text-sm font-medium font-mono">
            <% if @lab_result.lab_test.normal_range_min.present? || @lab_result.lab_test.normal_range_max.present? %>
              <%= @lab_result.lab_test.normal_range_min || "—" %> &ndash; <%= @lab_result.lab_test.normal_range_max || "—" %> <%= @lab_result.lab_test.unit %>
            <% else %>
              Not specified
            <% end %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Result Form -->
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <%= form_with(model: @lab_result, url: staff_lab_result_path(@lab_result), method: :patch, class: "space-y-6") do |f| %>
        <% if @lab_result.errors.any? %>
          <div class="alert alert-error">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <ul class="list-disc list-inside">
                <% @lab_result.errors.full_messages.each do |m| %>
                  <li><%= m %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="form-control w-full">
          <%= f.label :value, class: "label" do %>
            <span class="label-text">Result Value <span class="text-error">*</span></span>
            <% if @lab_result.lab_test.unit.present? %>
              <span class="label-text-alt text-base-content/50">(<%= @lab_result.lab_test.unit %>)</span>
            <% end %>
          <% end %>
          <%= f.text_field :value, class: "input input-bordered w-full", placeholder: "e.g. 5.2", autofocus: true %>
          <label class="label">
            <span class="label-text-alt text-base-content/50">Enter the result as reported (can include &lt;, &gt;, or text values)</span>
          </label>
        </div>

        <div class="form-control w-full">
          <%= f.label :numeric_value, class: "label" do %>
            <span class="label-text">Numeric Value</span>
            <span class="label-text-alt text-base-content/50">Used for flag calculation</span>
          <% end %>
          <%= f.number_field :numeric_value, class: "input input-bordered w-full", step: 0.01, placeholder: "e.g. 5.2" %>
        </div>

        <div class="form-control w-full">
          <%= f.label :notes, class: "label" do %>
            <span class="label-text">Notes / Comments</span>
          <% end %>
          <%= f.text_area :notes, class: "textarea textarea-bordered w-full h-20", placeholder: "Any additional comments about this result..." %>
        </div>

        <div class="flex items-center gap-3 pt-4">
          <%= f.submit "Save Result", class: "btn btn-primary" %>
          <%= link_to "Cancel", staff_patient_lab_order_path(@patient, @lab_result.lab_order), class: "btn btn-ghost" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
