<% content_for(:title, "Renal Dose Calculator") %>
<%
  level_class = { ok: "border-success bg-success/5", caution: "border-warning bg-warning/5", avoid: "border-error bg-error/5" }
  level_badge = { ok: "badge-success", caution: "badge-warning", avoid: "badge-error" }
  level_label = { ok: "Standard", caution: "Adjust dose", avoid: "Avoid" }
%>

<div class="max-w-3xl mx-auto space-y-6">
  <div>
    <h1 class="text-2xl font-bold">Renal dose calculator</h1>
    <p class="text-base-content/60 text-sm mt-1">eGFR-adjusted dosing guidance. Decision support only — confirm against the full prescribing information.</p>
  </div>

  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <%= form_with url: staff_dose_calculator_path, method: :get, class: "grid grid-cols-1 sm:grid-cols-3 gap-3" do %>
        <div class="form-control">
          <label class="label label-text text-xs font-medium">Drug</label>
          <%= select_tag :drug, options_for_select(@drugs, @drug), include_blank: "Select a drug", class: "select select-bordered w-full" %>
        </div>
        <div class="form-control">
          <label class="label label-text text-xs font-medium">Patient (optional — fills eGFR)</label>
          <%= select_tag :patient_id, options_from_collection_for_select(@patients, :id, :full_name, params[:patient_id]), include_blank: "—", class: "select select-bordered w-full" %>
        </div>
        <div class="form-control">
          <label class="label label-text text-xs font-medium">eGFR (mL/min/1.73m²)</label>
          <%= number_field_tag :egfr, @egfr, step: "any", min: 0, placeholder: "e.g. 38", class: "input input-bordered w-full" %>
        </div>
        <div class="sm:col-span-3 flex justify-end">
          <%= submit_tag "Calculate", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @result %>
    <% if !@result[:found] %>
      <div class="alert alert-warning">Drug not found in the reference set.</div>
    <% else %>
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="text-xl font-bold"><%= @result[:drug] %></h2>
              <p class="text-sm text-base-content/60"><%= @result[:info][:klass] %> · usual dose: <%= @result[:info][:normal] %></p>
            </div>
            <% if @result[:nephrotoxic] %><span class="badge badge-error">Nephrotoxic</span><% end %>
          </div>

          <% if @result[:egfr].nil? %>
            <p class="text-sm text-base-content/50 mt-3">Enter an eGFR (or pick a patient) to see the adjusted recommendation.</p>
          <% else %>
            <% b = @result[:band] %>
            <div class="flex items-center gap-3 mt-3 text-sm">
              <span class="badge badge-outline">eGFR <%= @result[:egfr].round(0) %></span>
              <span class="text-base-content/60"><%= @result[:stage] %></span>
            </div>
            <div class="mt-3 rounded-xl border-2 p-4 <%= level_class[b[:level]] %>">
              <div class="flex items-center gap-2 mb-1">
                <span class="badge <%= level_badge[b[:level]] %> badge-sm"><%= level_label[b[:level]] %></span>
              </div>
              <p class="text-sm font-medium"><%= b[:text] %></p>
            </div>
          <% end %>

          <details class="mt-4">
            <summary class="cursor-pointer text-sm text-base-content/60">Full eGFR band reference for <%= @result[:drug] %></summary>
            <table class="table table-sm mt-2">
              <thead><tr><th>eGFR ≥</th><th>Recommendation</th></tr></thead>
              <tbody>
                <% @result[:info][:bands].each do |band| %>
                  <tr>
                    <td class="font-mono"><%= band[:min] %></td>
                    <td><span class="badge <%= level_badge[band[:level]] %> badge-xs mr-1"><%= level_label[band[:level]] %></span><%= band[:text] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </details>
        </div>
      </div>
    <% end %>
  <% end %>

  <p class="text-xs text-base-content/40 text-center">Reference set covers commonly renally-adjusted drugs. Always verify against current prescribing guidance.</p>
</div>
