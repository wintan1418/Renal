<% content_for(:title, "Lab Order ##{@lab_order.id} - #{@patient.full_name}") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= staff_root_path %>">Dashboard</a></li>
    <li><a href="<%= staff_patients_path %>">Patients</a></li>
    <li><a href="<%= chart_staff_patient_path(@patient) %>"><%= @patient.full_name %></a></li>
    <li>Lab Order #<%= @lab_order.id %></li>
  </ul>
</div>

<!-- Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-extrabold">Lab Order #<%= @lab_order.id %></h1>
    <p class="text-base-content/60 text-sm mt-1">
      <%= @lab_order.created_at.strftime("%B %d, %Y at %H:%M") %>
    </p>
  </div>
  <div class="flex gap-2">
    <%= link_to "Back to Chart", chart_staff_patient_path(@patient, tab: "labs"), class: "btn btn-ghost btn-sm" %>
    <% if @lab_order.visit %>
      <%= link_to "View Visit", staff_patient_visit_path(@patient, @lab_order.visit), class: "btn btn-ghost btn-sm" %>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Main: Results Table -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Lab Results Table -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title text-base">Lab Results</h2>
        <div class="divider mt-0"></div>

        <% if @lab_order.lab_results.any? %>
          <div class="overflow-x-auto">
            <table class="table table-zebra">
              <thead>
                <tr>
                  <th>Test Name</th>
                  <th>Unit</th>
                  <th>Normal Range</th>
                  <th>Result</th>
                  <th>Flag</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @lab_order.lab_results.each do |result| %>
                  <tr>
                    <td class="font-medium">
                      <%= result.lab_test.name %>
                      <% if result.lab_test.code.present? %>
                        <span class="text-xs font-mono text-base-content/40 ml-1">(<%= result.lab_test.code %>)</span>
                      <% end %>
                    </td>
                    <td class="text-sm"><%= result.lab_test.unit.presence || "--" %></td>
                    <td class="text-sm font-mono"><%= result.lab_test.normal_range.presence || "--" %></td>
                    <td>
                      <% if result.value.present? %>
                        <span class="font-semibold <%= result.abnormal? ? 'text-error' : 'text-success' %>">
                          <%= result.value %>
                        </span>
                      <% else %>
                        <span class="text-base-content/40 text-sm">Pending</span>
                      <% end %>
                    </td>
                    <td>
                      <% if result.value.present? %>
                        <% case result.flag %>
                        <% when "normal" %>
                          <span class="badge badge-success badge-sm">Normal</span>
                        <% when "low" %>
                          <span class="badge badge-warning badge-sm">Low</span>
                        <% when "high" %>
                          <span class="badge badge-warning badge-sm">High</span>
                        <% when "critical" %>
                          <span class="badge badge-error badge-sm">Critical</span>
                        <% else %>
                          <span class="badge badge-ghost badge-sm">--</span>
                        <% end %>
                      <% else %>
                        <span class="text-base-content/40">--</span>
                      <% end %>
                    </td>
                    <td>
                      <%= link_to "Enter Result", edit_staff_lab_result_path(result), class: "btn btn-primary btn-xs" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="py-6 text-center">
            <p class="text-base-content/60">No lab tests attached to this order.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Sidebar: Order Info -->
  <div class="space-y-6">
    <!-- Order Details -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h3 class="font-bold">Order Information</h3>
        <div class="space-y-3 mt-2">
          <div>
            <p class="text-xs text-base-content/50">Status</p>
            <% case @lab_order.status %>
            <% when "pending" %>
              <span class="badge badge-warning mt-1">Pending</span>
            <% when "collected" %>
              <span class="badge badge-info mt-1">Collected</span>
            <% when "processing" %>
              <span class="badge badge-info mt-1">Processing</span>
            <% when "completed" %>
              <span class="badge badge-success mt-1">Completed</span>
            <% when "cancelled" %>
              <span class="badge badge-ghost mt-1">Cancelled</span>
            <% end %>
          </div>

          <div>
            <p class="text-xs text-base-content/50">Priority</p>
            <% case @lab_order.priority %>
            <% when "routine" %>
              <span class="badge badge-ghost badge-sm mt-1">Routine</span>
            <% when "urgent" %>
              <span class="badge badge-warning badge-sm mt-1">Urgent</span>
            <% when "stat" %>
              <span class="badge badge-error badge-sm mt-1">STAT</span>
            <% end %>
          </div>

          <div>
            <p class="text-xs text-base-content/50">Ordered By</p>
            <div class="flex items-center gap-2 mt-1">
              <%= avatar_for(@lab_order.ordered_by, size: "w-6 h-6", text_size: "text-xs") %>
              <span class="text-sm font-medium"><%= @lab_order.ordered_by.full_name %></span>
            </div>
          </div>

          <div>
            <p class="text-xs text-base-content/50">Date Ordered</p>
            <p class="font-medium text-sm"><%= @lab_order.created_at.strftime("%b %d, %Y %H:%M") %></p>
          </div>

          <% if @lab_order.visit %>
            <div>
              <p class="text-xs text-base-content/50">Visit</p>
              <p class="font-medium text-sm">#<%= @lab_order.visit_id %></p>
            </div>
          <% end %>

          <div>
            <p class="text-xs text-base-content/50">Tests</p>
            <p class="font-medium text-sm"><%= @lab_order.lab_results.count %> test(s)</p>
          </div>
        </div>

        <% if @lab_order.clinical_notes.present? %>
          <div class="divider"></div>
          <div>
            <p class="text-xs text-base-content/50 mb-1">Clinical Notes</p>
            <p class="text-sm"><%= @lab_order.clinical_notes %></p>
          </div>
        <% end %>

        <!-- Status Update -->
        <% unless @lab_order.status_completed? || @lab_order.status_cancelled? %>
          <div class="divider"></div>
          <%= form_with(model: @lab_order, url: staff_patient_lab_order_path(@patient, @lab_order), method: :patch) do |f| %>
            <div class="form-control w-full">
              <label class="label"><span class="label-text text-xs">Update Status</span></label>
              <%= f.select :status, LabOrder.statuses.keys.map { |s| [s.humanize, s] }, { selected: @lab_order.status }, class: "select select-bordered select-sm w-full" %>
            </div>
            <%= f.submit "Update", class: "btn btn-outline btn-sm mt-2 w-full" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Patient -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h3 class="font-bold">Patient</h3>
        <div class="flex items-center gap-3 mt-2">
          <%= avatar_for(@patient, size: "w-10 h-10", text_size: "text-sm") %>
          <div>
            <p class="font-medium"><%= @patient.full_name %></p>
            <p class="text-xs text-base-content/50 font-mono"><%= @patient.patient_profile&.medical_record_number %></p>
          </div>
        </div>
        <div class="mt-3">
          <%= link_to "View Full Chart", chart_staff_patient_path(@patient, tab: "labs"), class: "btn btn-ghost btn-sm btn-block" %>
        </div>
      </div>
    </div>
  </div>
</div>
