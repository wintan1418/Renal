<% content_for(:title, "New Consultation") %>
<div class="max-w-lg mx-auto space-y-4">
  <h1 class="text-2xl font-bold">New video consultation</h1>
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <%= form_with model: @session, url: staff_telemedicine_sessions_path, method: :post, class: "space-y-4" do |f| %>
        <% if @session.errors.any? %>
          <div class="alert alert-error text-sm"><%= @session.errors.full_messages.to_sentence %></div>
        <% end %>
        <div class="form-control">
          <label class="label label-text font-medium">Patient</label>
          <%= f.collection_select :patient_id, @patients, :id, :full_name, { prompt: "Select patient" }, class: "select select-bordered w-full", required: true %>
        </div>
        <p class="text-xs text-base-content/50">A secure video room is created instantly — no app install needed for you or the patient.</p>
        <div class="flex justify-end gap-2">
          <%= link_to "Cancel", staff_telemedicine_sessions_path, class: "btn btn-ghost btn-sm" %>
          <%= f.submit "Create room", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
