<div class="flex items-center justify-between mb-4">
  <h2 class="text-lg font-bold">Visit History</h2>
  <%= link_to new_staff_patient_visit_path(patient), class: "btn btn-primary btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
    New Visit
  <% end %>
</div>

<% if visits.any? %>
  <div class="card bg-base-100 shadow-xl">
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Doctor</th>
            <th>Chief Complaint</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% visits.each do |visit| %>
            <tr class="hover">
              <td><%= visit.visit_date.strftime("%b %d, %Y") %></td>
              <td><span class="badge badge-ghost badge-sm"><%= visit.visit_type.humanize %></span></td>
              <td>
                <div class="flex items-center gap-2">
                  <%= avatar_for(visit.doctor, size: "w-6 h-6", text_size: "text-xs") %>
                  <span class="text-sm">Dr. <%= visit.doctor.last_name %></span>
                </div>
              </td>
              <td class="max-w-xs truncate"><%= visit.chief_complaint || "--" %></td>
              <td><%= status_badge(visit.status, type: :appointment) %></td>
              <td>
                <%= link_to "View", staff_patient_visit_path(patient, visit), class: "btn btn-ghost btn-xs" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body items-center text-center py-12">
      <p class="text-base-content/60">No visits recorded yet.</p>
      <%= link_to "Create First Visit", new_staff_patient_visit_path(patient), class: "btn btn-primary btn-sm mt-2" %>
    </div>
  </div>
<% end %>
