<div class="flex items-center justify-between mb-4">
  <h2 class="text-lg font-bold">Vital Signs</h2>
  <%= link_to new_staff_patient_vital_sign_path(patient), class: "btn btn-primary btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
    Record Vitals
  <% end %>
</div>

<% if vital_signs.any? %>
  <!-- BP and Weight Trend Charts -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <% bp_data = vital_signs.select { |v| v.systolic_bp.present? && v.diastolic_bp.present? }.reverse %>
    <% if bp_data.any? %>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h3 class="card-title text-sm">Blood Pressure Trend</h3>
          <%= line_chart [
            { name: "Systolic", data: bp_data.map { |v| [v.recorded_at.strftime("%b %d"), v.systolic_bp] } },
            { name: "Diastolic", data: bp_data.map { |v| [v.recorded_at.strftime("%b %d"), v.diastolic_bp] } }
          ], xtitle: "Date", ytitle: "mmHg", colors: ["#ef4444", "#3b82f6"] %>
        </div>
      </div>
    <% end %>

    <% weight_data = vital_signs.select { |v| v.weight_kg.present? }.reverse %>
    <% if weight_data.any? %>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h3 class="card-title text-sm">Weight Trend</h3>
          <%= line_chart weight_data.map { |v| [v.recorded_at.strftime("%b %d"), v.weight_kg.to_f] },
            xtitle: "Date", ytitle: "kg", colors: ["#10b981"] %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Vitals Table -->
  <div class="card bg-base-100 shadow-xl">
    <div class="overflow-x-auto">
      <table class="table table-zebra text-sm">
        <thead>
          <tr>
            <th>Date/Time</th>
            <th>Type</th>
            <th>BP</th>
            <th>HR</th>
            <th>Temp</th>
            <th>Weight</th>
            <th>O2 Sat</th>
            <th>RR</th>
            <th>Blood Sugar</th>
            <th>Recorded By</th>
          </tr>
        </thead>
        <tbody>
          <% vital_signs.each do |vs| %>
            <tr>
              <td><%= vs.recorded_at.strftime("%b %d, %Y %H:%M") %></td>
              <td><span class="badge badge-ghost badge-xs"><%= vs.measurement_type.humanize %></span></td>
              <td class="font-medium"><%= vs.blood_pressure || "--" %></td>
              <td><%= vs.heart_rate || "--" %></td>
              <td><%= vs.temperature ? "#{vs.temperature}°C" : "--" %></td>
              <td><%= vs.weight_kg ? "#{vs.weight_kg} kg" : "--" %></td>
              <td><%= vs.oxygen_saturation ? "#{vs.oxygen_saturation}%" : "--" %></td>
              <td><%= vs.respiratory_rate || "--" %></td>
              <td><%= vs.blood_sugar ? "#{vs.blood_sugar} mg/dL" : "--" %></td>
              <td><%= vs.recorded_by.full_name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body items-center text-center py-12">
      <p class="text-base-content/60">No vital signs recorded yet.</p>
      <%= link_to "Record First Vitals", new_staff_patient_vital_sign_path(patient), class: "btn btn-primary btn-sm mt-2" %>
    </div>
  </div>
<% end %>
