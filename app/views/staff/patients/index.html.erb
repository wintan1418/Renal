<% content_for(:title, "Patients") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= staff_root_path %>">Dashboard</a></li>
    <li>Patients</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-extrabold">Patients</h1>

  <!-- Search -->
  <%= form_with url: staff_patients_path, method: :get, class: "flex items-center gap-2" do |f| %>
    <div class="join">
      <%= f.text_field :search, value: params[:search], placeholder: "Search by name, MRN, email, phone...", class: "input input-bordered input-sm join-item w-64" %>
      <%= f.submit "Search", class: "btn btn-primary btn-sm join-item" %>
    </div>
    <% if params[:search].present? %>
      <%= link_to "Clear", staff_patients_path, class: "btn btn-ghost btn-sm" %>
    <% end %>
  <% end %>
</div>

<% if @patients.any? %>
  <div class="card bg-base-100 shadow-xl">
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Patient</th>
            <th>MRN</th>
            <th>Phone</th>
            <th>CKD Stage</th>
            <th>Dialysis</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @patients.each do |patient| %>
            <tr class="hover">
              <td>
                <div class="flex items-center gap-3">
                  <%= avatar_for(patient, size: "w-8 h-8", text_size: "text-xs") %>
                  <div>
                    <div class="font-medium"><%= patient.full_name %></div>
                    <div class="text-xs text-base-content/50"><%= patient.email %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="font-mono text-sm"><%= patient.patient_profile&.medical_record_number || "N/A" %></span>
              </td>
              <td><%= patient.phone || "N/A" %></td>
              <td>
                <% if patient.patient_profile&.ckd_stage.present? %>
                  <span class="badge badge-warning badge-sm"><%= patient.patient_profile.ckd_stage.humanize %></span>
                <% else %>
                  <span class="text-base-content/40">--</span>
                <% end %>
              </td>
              <td>
                <% if patient.patient_profile&.on_dialysis? %>
                  <span class="badge badge-error badge-sm">On Dialysis</span>
                <% else %>
                  <span class="text-base-content/40">No</span>
                <% end %>
              </td>
              <td>
                <%= link_to "View Chart", chart_staff_patient_path(patient), class: "btn btn-primary btn-xs" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="p-4">
      <%== pagy_nav(@pagy) %>
    </div>
  </div>
<% else %>
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body items-center text-center py-12">
      <div class="w-16 h-16 rounded-full bg-base-200 flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <h3 class="font-bold text-lg">No patients found</h3>
      <p class="text-base-content/60">
        <% if params[:search].present? %>
          No patients match your search "<%= params[:search] %>". Try a different search term.
        <% else %>
          No patients have been registered yet.
        <% end %>
      </p>
    </div>
  </div>
<% end %>
