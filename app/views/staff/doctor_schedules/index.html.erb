<% content_for(:title, "My Schedule") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= staff_root_path %>">Dashboard</a></li>
    <li>My Schedule</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-extrabold">My Weekly Schedule</h1>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Weekly Schedule Grid -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>Day</th>
              <th>Hours</th>
              <th>Slot Duration</th>
              <th>Max Patients</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% DoctorSchedule::DAY_NAMES.each do |day_num, day_name| %>
              <% schedule = @schedules.find { |s| s.day_of_week == day_num } %>
              <tr class="hover">
                <td class="font-medium"><%= day_name %></td>
                <% if schedule %>
                  <td>
                    <span class="font-mono text-sm">
                      <%= schedule.start_time.strftime("%I:%M %p") %> - <%= schedule.end_time.strftime("%I:%M %p") %>
                    </span>
                  </td>
                  <td><%= schedule.slot_duration_minutes %> min</td>
                  <td><%= schedule.max_patients %></td>
                  <td>
                    <% if schedule.active? %>
                      <span class="badge badge-success badge-sm">Active</span>
                    <% else %>
                      <span class="badge badge-ghost badge-sm">Inactive</span>
                    <% end %>
                  </td>
                  <td>
                    <div class="flex gap-1">
                      <button onclick="editSchedule(<%= schedule.id %>, <%= schedule.day_of_week %>, '<%= schedule.start_time.strftime("%H:%M") %>', '<%= schedule.end_time.strftime("%H:%M") %>', <%= schedule.slot_duration_minutes %>, <%= schedule.max_patients %>, <%= schedule.active? %>)" class="btn btn-ghost btn-xs">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                        </svg>
                      </button>
                      <%= button_to staff_doctor_schedule_path(schedule), method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: "Remove this schedule slot?" } do %>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg>
                      <% end %>
                    </div>
                  </td>
                <% else %>
                  <td colspan="4" class="text-base-content/40 text-sm">No schedule set</td>
                  <td>
                    <button onclick="addSchedule(<%= day_num %>)" class="btn btn-primary btn-xs btn-outline">Add</button>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add / Edit Schedule Form -->
  <div>
    <div id="schedule-form" class="bg-white rounded-2xl shadow-lg p-6">
      <h3 id="form-title" class="font-bold mb-4">Add Schedule Slot</h3>

      <!-- Create Form -->
      <div id="create-form">
        <%= form_with model: @schedule, url: staff_doctor_schedules_path, class: "space-y-4" do |f| %>
          <div class="form-control w-full">
            <%= f.label :day_of_week, class: "label" do %>
              <span class="label-text">Day of Week <span class="text-error">*</span></span>
            <% end %>
            <%= f.select :day_of_week, DoctorSchedule::DAY_NAMES.map { |k, v| [v, k] }, { prompt: "Select day" }, class: "select select-bordered w-full", id: "create_day_of_week" %>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="form-control w-full">
              <%= f.label :start_time, class: "label" do %>
                <span class="label-text">Start Time <span class="text-error">*</span></span>
              <% end %>
              <%= f.time_field :start_time, class: "input input-bordered w-full", value: "08:00" %>
            </div>
            <div class="form-control w-full">
              <%= f.label :end_time, class: "label" do %>
                <span class="label-text">End Time <span class="text-error">*</span></span>
              <% end %>
              <%= f.time_field :end_time, class: "input input-bordered w-full", value: "17:00" %>
            </div>
          </div>

          <div class="form-control w-full">
            <%= f.label :slot_duration_minutes, class: "label" do %>
              <span class="label-text">Slot Duration (minutes)</span>
            <% end %>
            <%= f.number_field :slot_duration_minutes, class: "input input-bordered w-full", value: 30, min: 5, step: 5 %>
          </div>

          <div class="form-control w-full">
            <%= f.label :max_patients, class: "label" do %>
              <span class="label-text">Max Patients per Slot</span>
            <% end %>
            <%= f.number_field :max_patients, class: "input input-bordered w-full", value: 1, min: 1 %>
          </div>

          <div class="form-control w-full">
            <label class="label cursor-pointer justify-start gap-3">
              <%= f.check_box :active, class: "toggle toggle-primary", checked: true %>
              <span class="label-text">Active</span>
            </label>
          </div>

          <%= f.submit "Add Schedule Slot", class: "btn btn-primary btn-block" %>
        <% end %>
      </div>

      <!-- Edit Form (hidden by default, populated via JS) -->
      <div id="edit-form" class="hidden">
        <form id="edit-schedule-form" method="post" class="space-y-4" data-turbo="true">
          <input type="hidden" name="_method" value="patch">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

          <div class="form-control w-full">
            <label class="label"><span class="label-text">Day of Week</span></label>
            <select name="doctor_schedule[day_of_week]" id="edit_day_of_week" class="select select-bordered w-full" disabled>
              <% DoctorSchedule::DAY_NAMES.each do |k, v| %>
                <option value="<%= k %>"><%= v %></option>
              <% end %>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="form-control w-full">
              <label class="label"><span class="label-text">Start Time</span></label>
              <input type="time" name="doctor_schedule[start_time]" id="edit_start_time" class="input input-bordered w-full">
            </div>
            <div class="form-control w-full">
              <label class="label"><span class="label-text">End Time</span></label>
              <input type="time" name="doctor_schedule[end_time]" id="edit_end_time" class="input input-bordered w-full">
            </div>
          </div>

          <div class="form-control w-full">
            <label class="label"><span class="label-text">Slot Duration (minutes)</span></label>
            <input type="number" name="doctor_schedule[slot_duration_minutes]" id="edit_slot_duration" class="input input-bordered w-full" min="5" step="5">
          </div>

          <div class="form-control w-full">
            <label class="label"><span class="label-text">Max Patients per Slot</span></label>
            <input type="number" name="doctor_schedule[max_patients]" id="edit_max_patients" class="input input-bordered w-full" min="1">
          </div>

          <div class="form-control w-full">
            <label class="label cursor-pointer justify-start gap-3">
              <input type="checkbox" name="doctor_schedule[active]" id="edit_active" value="1" class="toggle toggle-primary">
              <span class="label-text">Active</span>
            </label>
          </div>

          <div class="flex gap-2">
            <button type="submit" class="btn btn-primary flex-1">Update</button>
            <button type="button" onclick="cancelEdit()" class="btn btn-ghost flex-1">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function addSchedule(dayNum) {
    document.getElementById('form-title').textContent = 'Add Schedule Slot';
    document.getElementById('create-form').classList.remove('hidden');
    document.getElementById('edit-form').classList.add('hidden');
    document.getElementById('create_day_of_week').value = dayNum;
  }

  function editSchedule(id, dayOfWeek, startTime, endTime, slotDuration, maxPatients, active) {
    document.getElementById('form-title').textContent = 'Edit Schedule Slot';
    document.getElementById('create-form').classList.add('hidden');
    document.getElementById('edit-form').classList.remove('hidden');

    document.getElementById('edit-schedule-form').action = '/staff/doctor_schedules/' + id;
    document.getElementById('edit_day_of_week').value = dayOfWeek;
    document.getElementById('edit_start_time').value = startTime;
    document.getElementById('edit_end_time').value = endTime;
    document.getElementById('edit_slot_duration').value = slotDuration;
    document.getElementById('edit_max_patients').value = maxPatients;
    document.getElementById('edit_active').checked = active;
  }

  function cancelEdit() {
    document.getElementById('form-title').textContent = 'Add Schedule Slot';
    document.getElementById('create-form').classList.remove('hidden');
    document.getElementById('edit-form').classList.add('hidden');
  }
</script>
