<% content_for(:title, "Prescription ##{@prescription.id} - #{@patient.full_name}") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= staff_root_path %>">Dashboard</a></li>
    <li><a href="<%= staff_patients_path %>">Patients</a></li>
    <li><a href="<%= chart_staff_patient_path(@patient) %>"><%= @patient.full_name %></a></li>
    <li>Prescription #<%= @prescription.id %></li>
  </ul>
</div>

<!-- Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-extrabold">Prescription #<%= @prescription.id %></h1>
    <p class="text-base-content/60 text-sm mt-1">
      <%= @prescription.created_at.strftime("%B %d, %Y at %H:%M") %>
    </p>
  </div>
  <div class="flex gap-2">
    <button type="button" onclick="window.print()" class="btn btn-outline btn-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
      </svg>
      Print
    </button>
    <%= link_to "Back to Chart", chart_staff_patient_path(@patient, tab: "prescriptions"), class: "btn btn-ghost btn-sm" %>
    <% if @prescription.visit %>
      <%= link_to "View Visit", staff_patient_visit_path(@patient, @prescription.visit), class: "btn btn-ghost btn-sm" %>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Main: Medication Items -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Prescription Items Table -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title text-base">Prescribed Medications</h2>
        <div class="divider mt-0"></div>

        <% if @prescription.prescription_items.any? %>
          <div class="overflow-x-auto">
            <table class="table table-zebra">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Medication</th>
                  <th>Dosage</th>
                  <th>Frequency</th>
                  <th>Route</th>
                  <th>Duration</th>
                  <th>Qty</th>
                  <th>Instructions</th>
                </tr>
              </thead>
              <tbody>
                <% @prescription.prescription_items.each_with_index do |item, index| %>
                  <tr>
                    <td class="text-base-content/50 text-sm"><%= index + 1 %></td>
                    <td class="font-semibold"><%= item.medication_name %></td>
                    <td><%= item.dosage %></td>
                    <td><%= item.frequency %></td>
                    <td>
                      <% if item.route.present? %>
                        <span class="badge badge-ghost badge-sm"><%= item.route.upcase %></span>
                      <% else %>
                        <span class="text-base-content/40">--</span>
                      <% end %>
                    </td>
                    <td><%= item.duration.presence || "--" %></td>
                    <td><%= item.quantity.presence || "--" %></td>
                    <td class="text-sm text-base-content/70"><%= item.instructions.presence || "--" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="py-6 text-center">
            <p class="text-base-content/60">No medications in this prescription.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Notes -->
    <% if @prescription.notes.present? %>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-base">Notes</h2>
          <div class="divider mt-0"></div>
          <p class="text-sm"><%= @prescription.notes %></p>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Sidebar -->
  <div class="space-y-6">
    <!-- Prescription Info -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h3 class="font-bold">Prescription Details</h3>
        <div class="space-y-3 mt-2">
          <div>
            <p class="text-xs text-base-content/50">Status</p>
            <% case @prescription.status %>
            <% when "active" %>
              <span class="badge badge-success mt-1">Active</span>
            <% when "dispensed" %>
              <span class="badge badge-info mt-1">Dispensed</span>
            <% when "partially_dispensed" %>
              <span class="badge badge-warning mt-1">Partially Dispensed</span>
            <% when "cancelled" %>
              <span class="badge badge-ghost mt-1">Cancelled</span>
            <% end %>
          </div>

          <div>
            <p class="text-xs text-base-content/50">Prescribed By</p>
            <div class="flex items-center gap-2 mt-1">
              <%= avatar_for(@prescription.prescribed_by, size: "w-6 h-6", text_size: "text-xs") %>
              <span class="text-sm font-medium"><%= @prescription.prescribed_by.full_name %></span>
            </div>
          </div>

          <div>
            <p class="text-xs text-base-content/50">Date</p>
            <p class="font-medium text-sm"><%= @prescription.created_at.strftime("%b %d, %Y") %></p>
          </div>

          <div>
            <p class="text-xs text-base-content/50">Total Items</p>
            <p class="font-medium text-sm"><%= @prescription.item_count %> medication(s)</p>
          </div>

          <% if @prescription.visit %>
            <div>
              <p class="text-xs text-base-content/50">Visit</p>
              <p class="font-medium text-sm">#<%= @prescription.visit_id %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Patient Info -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h3 class="font-bold">Patient</h3>
        <div class="flex items-center gap-3 mt-2">
          <%= avatar_for(@patient, size: "w-10 h-10", text_size: "text-sm") %>
          <div>
            <p class="font-medium"><%= @patient.full_name %></p>
            <p class="text-xs text-base-content/50 font-mono"><%= @patient.patient_profile&.medical_record_number %></p>
          </div>
        </div>
        <div class="mt-3">
          <%= link_to "View Full Chart", chart_staff_patient_path(@patient, tab: "prescriptions"), class: "btn btn-ghost btn-sm btn-block" %>
        </div>
      </div>
    </div>
  </div>
</div>
