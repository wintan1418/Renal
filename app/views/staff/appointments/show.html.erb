<% content_for(:title, "Appointment Details") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= staff_root_path %>">Dashboard</a></li>
    <li><a href="<%= staff_appointments_path %>">Appointments</a></li>
    <li>Appointment #<%= @appointment.id %></li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-extrabold">Appointment Details</h1>
  <div class="flex gap-2">
    <% if @appointment.checked_in? || @appointment.confirmed? %>
      <%= button_to "Start Appointment", start_staff_appointment_path(@appointment), method: :patch, class: "btn btn-primary btn-sm" %>
    <% end %>
    <% if @appointment.in_progress? %>
      <%= button_to "Complete", complete_staff_appointment_path(@appointment), method: :patch, class: "btn btn-success btn-sm" %>
    <% end %>
    <%= link_to "Back", staff_appointments_path(date: @appointment.scheduled_date), class: "btn btn-ghost btn-sm" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Main Details -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Patient Info -->
    <div class="bg-white rounded-2xl shadow-lg p-6">
      <h2 class="text-lg font-bold mb-4">Patient Information</h2>
      <div class="divider mt-0"></div>

      <div class="flex items-center gap-4 mb-4">
        <%= avatar_for(@appointment.patient, size: "w-14 h-14", text_size: "text-lg") %>
        <div>
          <p class="text-lg font-bold"><%= @appointment.patient.full_name %></p>
          <p class="text-sm text-base-content/60">MRN: <%= @appointment.patient.patient_profile&.medical_record_number || "N/A" %></p>
          <p class="text-sm text-base-content/60"><%= @appointment.patient.email %></p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
        <div>
          <p class="text-xs text-base-content/50">Age</p>
          <p class="font-medium"><%= @appointment.patient.patient_profile&.age || "N/A" %></p>
        </div>
        <div>
          <p class="text-xs text-base-content/50">Gender</p>
          <p class="font-medium"><%= @appointment.patient.patient_profile&.gender&.humanize || "N/A" %></p>
        </div>
        <div>
          <p class="text-xs text-base-content/50">Blood Group</p>
          <p class="font-medium"><%= @appointment.patient.patient_profile&.blood_group_display || "N/A" %></p>
        </div>
        <div>
          <p class="text-xs text-base-content/50">Phone</p>
          <p class="font-medium"><%= @appointment.patient.phone || "N/A" %></p>
        </div>
      </div>
    </div>

    <!-- Appointment Info -->
    <div class="bg-white rounded-2xl shadow-lg p-6">
      <h2 class="text-lg font-bold mb-4">Appointment Details</h2>
      <div class="divider mt-0"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="text-sm text-base-content/60">Date & Time</p>
          <p class="font-medium"><%= @appointment.scheduled_date.strftime("%A, %B %d, %Y") %> at <%= @appointment.start_time.strftime("%I:%M %p") %></p>
        </div>
        <div>
          <p class="text-sm text-base-content/60">Service</p>
          <p class="font-medium"><%= @appointment.service.name %></p>
        </div>
        <div>
          <p class="text-sm text-base-content/60">Duration</p>
          <p class="font-medium"><%= @appointment.duration_minutes %> minutes</p>
        </div>
        <div>
          <p class="text-sm text-base-content/60">Type</p>
          <p class="font-medium"><%= @appointment.appointment_type.humanize %></p>
        </div>
      </div>

      <% if @appointment.reason.present? %>
        <div class="mt-4">
          <p class="text-sm text-base-content/60">Reason for Visit</p>
          <p class="mt-1"><%= @appointment.reason %></p>
        </div>
      <% end %>

      <% if @appointment.notes.present? %>
        <div class="mt-4">
          <p class="text-sm text-base-content/60">Notes</p>
          <p class="mt-1"><%= @appointment.notes %></p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-6">
    <!-- Status -->
    <div class="bg-white rounded-2xl shadow-lg p-6">
      <h3 class="font-bold mb-3">Status</h3>
      <div class="flex items-center gap-3 mb-4">
        <%= status_badge(@appointment.status, type: :appointment) %>
        <span class="text-sm text-base-content/60">Queue #<%= @appointment.queue_number %></span>
      </div>

      <%= render "shared/appointment_status", appointment: @appointment %>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-2xl shadow-lg p-6">
      <h3 class="font-bold mb-3">Quick Actions</h3>
      <div class="space-y-2">
        <% if @appointment.checked_in? || @appointment.confirmed? %>
          <%= button_to "Start Appointment", start_staff_appointment_path(@appointment), method: :patch, class: "btn btn-primary btn-sm btn-block" %>
        <% end %>
        <% if @appointment.in_progress? %>
          <%= button_to "Mark as Complete", complete_staff_appointment_path(@appointment), method: :patch, class: "btn btn-success btn-sm btn-block" %>
        <% end %>
        <%= link_to "Back to List", staff_appointments_path(date: @appointment.scheduled_date), class: "btn btn-ghost btn-sm btn-block" %>
      </div>
    </div>
  </div>
</div>
