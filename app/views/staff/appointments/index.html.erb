<% content_for(:title, "My Appointments") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= staff_root_path %>">Dashboard</a></li>
    <li>Appointments</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-extrabold">Appointments</h1>
  <!-- Date Picker -->
  <div class="flex items-center gap-2">
    <%= form_with url: staff_appointments_path, method: :get, class: "flex items-center gap-2" do |f| %>
      <%= f.date_field :date, value: @date, class: "input input-bordered input-sm", onchange: "this.form.requestSubmit()" %>
    <% end %>
    <% if @date != Date.current %>
      <%= link_to "Today", staff_appointments_path, class: "btn btn-primary btn-sm btn-outline" %>
    <% end %>
  </div>
</div>

<!-- Date Header -->
<div class="mb-4">
  <p class="text-lg font-semibold">
    <%= @date.strftime("%A, %B %d, %Y") %>
    <% if @date == Date.current %>
      <span class="badge badge-primary badge-sm ml-2">Today</span>
    <% end %>
  </p>
  <p class="text-sm text-base-content/60"><%= @appointments.count %> appointment(s)</p>
</div>

<!-- Appointments List -->
<% if @appointments.any? %>
  <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Queue</th>
            <th>Time</th>
            <th>Patient</th>
            <th>Service</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @appointments.each do |appointment| %>
            <tr class="hover">
              <td>
                <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center font-bold text-sm text-primary">
                  <%= appointment.queue_number %>
                </div>
              </td>
              <td>
                <div class="font-medium"><%= appointment.start_time.strftime("%I:%M %p") %></div>
                <div class="text-xs text-base-content/50"><%= appointment.duration_minutes %> min</div>
              </td>
              <td>
                <div class="flex items-center gap-3">
                  <%= avatar_for(appointment.patient, size: "w-8 h-8", text_size: "text-xs") %>
                  <div>
                    <div class="font-medium"><%= appointment.patient.full_name %></div>
                    <div class="text-xs text-base-content/50"><%= appointment.patient.patient_profile&.medical_record_number %></div>
                  </div>
                </div>
              </td>
              <td><%= appointment.service.name %></td>
              <td><%= status_badge(appointment.status, type: :appointment) %></td>
              <td>
                <div class="flex gap-1">
                  <%= link_to "View", staff_appointment_path(appointment), class: "btn btn-ghost btn-xs" %>
                  <% if appointment.checked_in? || appointment.confirmed? %>
                    <%= button_to "Start", start_staff_appointment_path(appointment), method: :patch, class: "btn btn-primary btn-xs" %>
                  <% end %>
                  <% if appointment.in_progress? %>
                    <%= button_to "Complete", complete_staff_appointment_path(appointment), method: :patch, class: "btn btn-success btn-xs" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="bg-white rounded-2xl shadow-lg p-12 text-center">
    <div class="w-16 h-16 rounded-full bg-base-200 flex items-center justify-center mx-auto mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>
    <h3 class="font-bold text-lg mb-2">No appointments</h3>
    <p class="text-base-content/60">You have no appointments scheduled for this date.</p>
  </div>
<% end %>
