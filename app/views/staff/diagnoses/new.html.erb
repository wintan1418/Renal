<% content_for(:title, "New Diagnosis - #{@patient.full_name}") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= staff_root_path %>">Dashboard</a></li>
    <li><a href="<%= staff_patients_path %>">Patients</a></li>
    <li><a href="<%= chart_staff_patient_path(@patient) %>"><%= @patient.full_name %></a></li>
    <li>New Diagnosis</li>
  </ul>
</div>

<h1 class="text-2xl font-extrabold mb-6">Add Diagnosis</h1>

<div class="card bg-base-100 shadow-xl max-w-2xl">
  <div class="card-body">
    <%= form_with(model: @diagnosis, url: staff_patient_diagnoses_path(@patient), class: "space-y-6") do |f| %>
      <% if @diagnosis.errors.any? %>
        <div class="alert alert-error">
          <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <ul class="list-disc list-inside">
              <% @diagnosis.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <% if @visit %>
        <%= f.hidden_field :visit_id, value: @visit.id %>
      <% end %>

      <div class="form-control w-full">
        <%= f.label :description, class: "label" do %>
          <span class="label-text">Diagnosis Description <span class="text-error">*</span></span>
        <% end %>
        <%= f.text_field :description, class: "input input-bordered w-full", placeholder: "e.g. Chronic Kidney Disease Stage 5", required: true %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="form-control w-full">
          <%= f.label :icd_code, class: "label" do %>
            <span class="label-text">ICD-10 Code</span>
          <% end %>
          <%= f.text_field :icd_code, class: "input input-bordered w-full", placeholder: "e.g. N18.5" %>
        </div>

        <div class="form-control w-full">
          <%= f.label :diagnosis_type, class: "label" do %>
            <span class="label-text">Type</span>
          <% end %>
          <%= f.select :diagnosis_type, Diagnosis.diagnosis_types.keys.map { |t| [t.humanize, t] }, {}, class: "select select-bordered w-full" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="form-control w-full">
          <%= f.label :status, class: "label" do %>
            <span class="label-text">Status</span>
          <% end %>
          <%= f.select :status, Diagnosis.statuses.keys.map { |t| [t.humanize, t] }, {}, class: "select select-bordered w-full" %>
        </div>

        <div class="form-control w-full">
          <%= f.label :onset_date, class: "label" do %>
            <span class="label-text">Onset Date</span>
          <% end %>
          <%= f.date_field :onset_date, class: "input input-bordered w-full" %>
        </div>
      </div>

      <div class="form-control w-full">
        <%= f.label :notes, class: "label" do %>
          <span class="label-text">Notes</span>
        <% end %>
        <%= f.text_area :notes, class: "textarea textarea-bordered w-full h-24", placeholder: "Additional notes..." %>
      </div>

      <div class="flex items-center gap-3 pt-4">
        <%= f.submit "Save Diagnosis", class: "btn btn-primary" %>
        <% if @visit %>
          <%= link_to "Cancel", staff_patient_visit_path(@patient, @visit), class: "btn btn-ghost" %>
        <% else %>
          <%= link_to "Cancel", chart_staff_patient_path(@patient, tab: "diagnoses"), class: "btn btn-ghost" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
