<%= turbo_frame_tag "lab_explanation" do %>
  <% if @explanation.present? %>
    <div class="card bg-gradient-to-br from-primary/5 to-secondary/5 border border-primary/10 shadow-xl mb-6">
      <div class="card-body">
        <h2 class="card-title text-base flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          What your results mean
        </h2>
        <p class="text-sm leading-relaxed text-base-content/80 whitespace-pre-line"><%= @explanation %></p>
        <p class="text-xs text-base-content/50 mt-2">This is a general explanation to help you understand your results — it is not medical advice. Please discuss any concerns with your doctor.</p>
      </div>
    </div>
  <% end %>
<% end %>
