<% content_for(:title, "Lab Results - #{@lab_order.created_at.strftime('%b %d, %Y')}") %>

<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= patient_portal_root_path %>">Dashboard</a></li>
    <li><a href="<%= patient_portal_lab_results_path %>">Lab Results</a></li>
    <li><%= @lab_order.created_at.strftime("%b %d, %Y") %></li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-extrabold">Lab Results</h1>
    <p class="text-base-content/60 text-sm mt-1">
      Ordered on <%= @lab_order.created_at.strftime("%B %d, %Y") %>
      by Dr. <%= @lab_order.ordered_by.full_name %>
    </p>
  </div>
  <% status_class = case @lab_order.status
       when "completed" then "badge-success"
       when "processing" then "badge-warning"
       when "collected" then "badge-info"
       when "pending" then "badge-ghost"
       when "cancelled" then "badge-error"
       else "badge-ghost"
     end %>
  <span class="badge <%= status_class %> badge-lg"><%= @lab_order.status.humanize %></span>
</div>

<!-- Results Table -->
<div class="card bg-base-100 shadow-xl mb-6">
  <div class="card-body">
    <h2 class="card-title mb-2">Test Results</h2>
    <% if @lab_order.lab_results.any? %>
      <div class="overflow-x-auto">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>Test Name</th>
              <th>Result</th>
              <th>Unit</th>
              <th>Normal Range</th>
              <th>Flag</th>
            </tr>
          </thead>
          <tbody>
            <% @lab_order.lab_results.each do |result| %>
              <tr class="<%= result.critical? ? 'bg-error/5' : '' %>">
                <td class="font-medium"><%= result.lab_test.name %></td>
                <td>
                  <span class="font-bold <%= result.abnormal? ? 'text-error' : 'text-base-content' %>">
                    <%= result.value.present? ? result.value : '—' %>
                  </span>
                </td>
                <td class="text-base-content/60 text-sm"><%= result.lab_test.unit.presence || '—' %></td>
                <td class="text-base-content/60 text-sm"><%= result.lab_test.normal_range.presence || '—' %></td>
                <td>
                  <% if result.flag %>
                    <% flag_class = case result.flag
                         when "normal" then "badge-success"
                         when "low" then "badge-warning"
                         when "high" then "badge-warning"
                         when "critical" then "badge-error"
                         else "badge-ghost"
                       end %>
                    <span class="badge <%= flag_class %> badge-sm"><%= result.flag.humanize %></span>
                  <% else %>
                    <span class="text-base-content/40 text-sm">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="py-8 text-center">
        <p class="text-base-content/60">Results have not been entered yet. Please check back later.</p>
      </div>
    <% end %>
  </div>
</div>

<!-- Trend Charts -->
<% if @trend_data.present? %>
  <div class="card bg-base-100 shadow-xl mb-6">
    <div class="card-body">
      <h2 class="card-title mb-2">Result Trends</h2>
      <p class="text-sm text-base-content/60 mb-4">Historical trend for tests with multiple recorded values.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% @trend_data.each do |test_name, data| %>
          <div class="card bg-base-100 shadow mt-4">
            <div class="card-body">
              <h3 class="font-bold"><%= test_name %> Trend</h3>
              <%= line_chart data, height: "200px", colors: ["#2563eb"] %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<!-- Critical Result Notice -->
<% if @lab_order.lab_results.any?(&:critical?) %>
  <div role="alert" class="alert alert-error mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div>
      <h3 class="font-bold">Critical Values Detected</h3>
      <p class="text-sm">One or more of your results are at critical levels. Please contact your doctor immediately.</p>
    </div>
  </div>
<% end %>

<div class="flex justify-start mt-2">
  <%= link_to patient_portal_lab_results_path, class: "btn btn-ghost btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Back to Lab Results
  <% end %>
</div>
