<% content_for(:title, "My Lab Results") %>

<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= patient_portal_root_path %>">Dashboard</a></li>
    <li>Lab Results</li>
  </ul>
</div>

<h1 class="text-2xl font-extrabold mb-6">My Lab Results</h1>

<% if @lab_orders.any? %>
  <div class="space-y-4">
    <% @lab_orders.each do |order| %>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <div class="flex items-center gap-3 mb-1">
                <h2 class="font-bold text-base">
                  <%= order.created_at.strftime("%B %d, %Y") %>
                </h2>
                <% status_class = case order.status
                     when "completed" then "badge-success"
                     when "processing" then "badge-warning"
                     when "collected" then "badge-info"
                     when "pending" then "badge-ghost"
                     when "cancelled" then "badge-error"
                     else "badge-ghost"
                   end %>
                <span class="badge <%= status_class %> badge-sm"><%= order.status.humanize %></span>
                <% if order.urgent? || order.stat? %>
                  <span class="badge badge-error badge-sm"><%= order.priority.upcase %></span>
                <% end %>
              </div>
              <div class="text-sm text-base-content/60 space-y-0.5">
                <p>Ordered by: <span class="font-medium text-base-content">Dr. <%= order.ordered_by.full_name %></span></p>
                <p>
                  <span class="font-medium text-base-content"><%= order.lab_results.size %></span>
                  <%= "test".pluralize(order.lab_results.size) %>
                  <% abnormal_count = order.lab_results.count(&:abnormal?) %>
                  <% if abnormal_count > 0 %>
                    &bull; <span class="text-error font-medium"><%= abnormal_count %> abnormal</span>
                  <% end %>
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= link_to patient_portal_lab_result_path(order), class: "btn btn-primary btn-sm" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>
                View Results
              <% end %>
            </div>
          </div>
          <% if order.lab_results.any? %>
            <div class="flex flex-wrap gap-2 mt-2">
              <% order.lab_results.each do |result| %>
                <% pill_class = result.abnormal? ? "badge-error badge-outline" : "badge-ghost" %>
                <span class="badge <%= pill_class %> badge-sm"><%= result.lab_test.name %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <% if @pagy.pages > 1 %>
    <div class="flex justify-center mt-6">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>

<% else %>
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body items-center text-center py-16">
      <div class="w-16 h-16 rounded-full bg-base-200 flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
      </div>
      <h3 class="font-bold text-lg mb-2">No Lab Results Yet</h3>
      <p class="text-base-content/60">Your lab results will appear here once tests have been ordered and processed.</p>
    </div>
  </div>
<% end %>
