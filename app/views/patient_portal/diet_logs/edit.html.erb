<% content_for :title, "Edit Meal Entry" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Edit Meal Entry</h1>
    <p class="text-base-content/60 text-sm"><%= @log.log_date.strftime("%d %B %Y") %> &mdash; <%= @log.meal_type.capitalize %></p>
  </div>

  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <%= render "form", log: @log %>
    </div>
  </div>
</div>
