<% content_for(:title, "Dialysis History") %>

<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= patient_portal_root_path %>">Dashboard</a></li>
    <li>Dialysis History</li>
  </ul>
</div>

<h1 class="text-2xl font-extrabold mb-6">My Dialysis History</h1>

<%
  total_sessions = current_user.dialysis_sessions_as_patient.count
  last_session = current_user.dialysis_sessions_as_patient.order(session_date: :desc).first
  completed_sessions = current_user.dialysis_sessions_as_patient.status_completed
  avg_fluid = completed_sessions.where.not(fluid_removed_ml: nil).average(:fluid_removed_ml)
%>

<!-- Summary Stats -->
<div class="stats shadow-xl bg-base-100 w-full mb-6">
  <div class="stat">
    <div class="stat-title">Total Sessions</div>
    <div class="stat-value text-primary"><%= total_sessions %></div>
    <div class="stat-desc">All time</div>
  </div>
  <div class="stat">
    <div class="stat-title">Last Session</div>
    <div class="stat-value text-base text-base-content">
      <%= last_session ? last_session.session_date.strftime("%b %d, %Y") : "N/A" %>
    </div>
    <div class="stat-desc"><%= last_session ? last_session.status&.humanize : "No sessions yet" %></div>
  </div>
  <div class="stat">
    <div class="stat-title">Avg. Fluid Removed</div>
    <div class="stat-value text-base text-base-content">
      <%= avg_fluid ? "#{avg_fluid.round(0)} mL" : "N/A" %>
    </div>
    <div class="stat-desc">Per completed session</div>
  </div>
</div>

<!-- Trend Charts -->
<% if @weight_trend.any? || @fluid_trend.any? %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <% if @weight_trend.any? %>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-base">Pre-Weight Trend (kg)</h2>
          <div class="text-sm text-base-content/60 mt-2">
            <% @weight_trend.each_with_index do |(date, val), i| %>
              <div class="flex justify-between py-1 border-b border-base-200">
                <span><%= date %></span>
                <span class="font-mono font-medium"><%= val %> kg</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if @fluid_trend.any? %>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-base">Fluid Removed Trend (mL)</h2>
          <div class="text-sm text-base-content/60 mt-2">
            <% @fluid_trend.each_with_index do |(date, val), i| %>
              <div class="flex justify-between py-1 border-b border-base-200">
                <span><%= date %></span>
                <span class="font-mono font-medium"><%= val.to_i %> mL</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<!-- Sessions Table -->
<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-0">
    <div class="p-4 border-b border-base-200">
      <h2 class="font-bold">All Sessions</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Date</th>
            <th>Doctor</th>
            <th>Type</th>
            <th>Duration</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @sessions.each do |session| %>
            <tr class="hover">
              <td>
                <div class="font-medium"><%= session.session_date.strftime("%b %d, %Y") %></div>
                <div class="text-xs text-base-content/50"><%= session.start_time&.strftime("%H:%M") || "TBD" %></div>
              </td>
              <td class="text-sm">Dr. <%= session.doctor&.last_name || "N/A" %></td>
              <td>
                <span class="badge badge-primary badge-sm"><%= session.session_type&.humanize %></span>
              </td>
              <td class="text-sm">
                <% if session.start_time && session.end_time %>
                  <%
                    duration_minutes = ((session.end_time - session.start_time) / 60).round
                    hours = duration_minutes / 60
                    mins = duration_minutes % 60
                  %>
                  <%= "#{hours}h #{mins}m" %>
                <% else %>
                  <span class="text-base-content/40">--</span>
                <% end %>
              </td>
              <td>
                <%
                  status_class = case session.status
                  when "scheduled" then "badge-info"
                  when "in_progress" then "badge-warning"
                  when "completed" then "badge-success"
                  when "cancelled" then "badge-ghost"
                  when "aborted" then "badge-error"
                  else "badge-ghost"
                  end
                %>
                <span class="badge <%= status_class %> badge-sm"><%= session.status&.humanize %></span>
              </td>
              <td>
                <%= link_to patient_portal_dialysis_history_path(session), class: "btn btn-ghost btn-xs" do %>
                  View
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @sessions.empty? %>
            <tr>
              <td colspan="6" class="text-center py-10 text-base-content/60">
                No dialysis sessions on record.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mt-6">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>
