<% content_for :title, "Submit Feedback" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6 text-center">
    <div class="mx-auto w-16 h-16 rounded-full bg-warning/10 flex items-center justify-center mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
      </svg>
    </div>
    <h1 class="text-2xl font-bold">Share Your Feedback</h1>
    <p class="text-base-content/60 text-sm">Your feedback helps us improve our care. Thank you for taking the time.</p>
    <% if @visit.present? %>
      <p class="text-sm text-base-content/60 mt-1">Visit on <%= @visit.visit_date.strftime("%d %B %Y") rescue "your visit" %></p>
    <% end %>
  </div>

  <div class="card bg-base-100 shadow">
    <div class="card-body space-y-6">
      <%= form_with model: [:patient_portal, @survey], url: patient_portal_surveys_path, local: true do |f| %>
        <% if @survey.errors.any? %>
          <div class="alert alert-error">
            <ul class="list-disc list-inside">
              <% @survey.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if @visit.present? %>
          <%= f.hidden_field :visit_id, value: @visit.id %>
        <% end %>

        <!-- Overall Rating -->
        <div class="form-control">
          <label class="label">
            <span class="label-text font-semibold text-base">Overall Experience <span class="text-error">*</span></span>
          </label>
          <p class="text-sm text-base-content/60 mb-3">How would you rate your overall experience at our hospital?</p>
          <div class="flex gap-2" id="overall-rating">
            <% [1, 2, 3, 4, 5].each do |rating| %>
              <label class="cursor-pointer flex flex-col items-center gap-1">
                <%= f.radio_button :overall_rating, rating, class: "hidden peer", id: "overall_#{rating}" %>
                <label for="overall_<%= rating %>" class="text-3xl transition-all cursor-pointer peer-checked:text-warning hover:text-warning text-base-content/20">
                  &#9733;
                </label>
                <span class="text-xs text-base-content/60"><%= rating %></span>
              </label>
            <% end %>
          </div>
          <% if @survey.errors[:overall_rating].any? %>
            <span class="text-error text-xs mt-1"><%= @survey.errors[:overall_rating].first %></span>
          <% end %>
        </div>

        <div class="divider"></div>

        <!-- Doctor Rating -->
        <div class="form-control">
          <label class="label">
            <span class="label-text font-semibold text-base">Doctor Care <span class="text-base-content/40 text-sm font-normal">(optional)</span></span>
          </label>
          <p class="text-sm text-base-content/60 mb-3">How would you rate the care provided by your doctor?</p>
          <div class="flex gap-2">
            <% [1, 2, 3, 4, 5].each do |rating| %>
              <label class="cursor-pointer flex flex-col items-center gap-1">
                <%= f.radio_button :doctor_rating, rating, class: "hidden peer", id: "doctor_#{rating}" %>
                <label for="doctor_<%= rating %>" class="text-3xl transition-all cursor-pointer peer-checked:text-info hover:text-info text-base-content/20">
                  &#9733;
                </label>
                <span class="text-xs text-base-content/60"><%= rating %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Staff Rating -->
        <div class="form-control">
          <label class="label">
            <span class="label-text font-semibold text-base">Nursing & Support Staff <span class="text-base-content/40 text-sm font-normal">(optional)</span></span>
          </label>
          <p class="text-sm text-base-content/60 mb-3">How would you rate the nursing and support staff?</p>
          <div class="flex gap-2">
            <% [1, 2, 3, 4, 5].each do |rating| %>
              <label class="cursor-pointer flex flex-col items-center gap-1">
                <%= f.radio_button :staff_rating, rating, class: "hidden peer", id: "staff_#{rating}" %>
                <label for="staff_<%= rating %>" class="text-3xl transition-all cursor-pointer peer-checked:text-success hover:text-success text-base-content/20">
                  &#9733;
                </label>
                <span class="text-xs text-base-content/60"><%= rating %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Comments -->
        <div class="form-control">
          <label class="label">
            <span class="label-text font-semibold text-base">Additional Comments <span class="text-base-content/40 text-sm font-normal">(optional)</span></span>
          </label>
          <%= f.text_area :comments, class: "textarea textarea-bordered w-full", rows: 4,
                placeholder: "Tell us about your experience — what went well, what could be improved..." %>
        </div>

        <div class="flex gap-3 pt-2">
          <%= f.submit "Submit Feedback", class: "btn btn-primary btn-block" %>
        </div>

        <p class="text-xs text-center text-base-content/40">
          Your feedback is confidential and used only to improve our services.
        </p>
      <% end %>
    </div>
  </div>
</div>
