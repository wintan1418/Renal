<% content_for(:title, "Prescription - #{@prescription.created_at.strftime('%b %d, %Y')}") %>

<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= patient_portal_root_path %>">Dashboard</a></li>
    <li><a href="<%= patient_portal_prescriptions_path %>">Prescriptions</a></li>
    <li><%= @prescription.created_at.strftime("%b %d, %Y") %></li>
  </ul>
</div>

<!-- Header -->
<div class="card bg-base-100 shadow-xl mb-6">
  <div class="card-body">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-extrabold mb-1">Prescription</h1>
        <div class="text-base-content/60 text-sm space-y-0.5">
          <p>
            Prescribed by
            <span class="font-semibold text-base-content">Dr. <%= @prescription.prescribed_by.full_name %></span>
          </p>
          <p>Date: <span class="font-semibold text-base-content"><%= @prescription.created_at.strftime("%B %d, %Y") %></span></p>
        </div>
      </div>
      <% status_class = case @prescription.status
           when "active" then "badge-success"
           when "dispensed" then "badge-info"
           when "partially_dispensed" then "badge-warning"
           when "cancelled" then "badge-error"
           else "badge-ghost"
         end %>
      <span class="badge <%= status_class %> badge-lg"><%= @prescription.status.humanize %></span>
    </div>
    <% if @prescription.notes.present? %>
      <div class="mt-4 p-3 bg-base-200 rounded-lg text-sm">
        <p class="font-semibold mb-1">Doctor's Notes:</p>
        <p class="text-base-content/80"><%= @prescription.notes %></p>
      </div>
    <% end %>
  </div>
</div>

<!-- Prescription Items -->
<div class="card bg-base-100 shadow-xl mb-6">
  <div class="card-body">
    <h2 class="card-title mb-2">Prescribed Medications</h2>
    <% if @prescription.prescription_items.any? %>
      <div class="overflow-x-auto">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>Medication</th>
              <th>Dosage</th>
              <th>Frequency</th>
              <th>Route</th>
              <th>Duration</th>
              <th>Quantity</th>
              <th>Instructions</th>
            </tr>
          </thead>
          <tbody>
            <% @prescription.prescription_items.each do |item| %>
              <tr>
                <td class="font-medium"><%= item.medication_name %></td>
                <td><%= item.dosage.presence || '—' %></td>
                <td><%= item.frequency.presence || '—' %></td>
                <td><%= item.route.presence || '—' %></td>
                <td><%= item.duration.presence || '—' %></td>
                <td><%= item.quantity.presence || '—' %></td>
                <td class="text-sm text-base-content/70 max-w-xs">
                  <%= item.instructions.presence || '—' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="py-6 text-center">
        <p class="text-base-content/60">No items in this prescription.</p>
      </div>
    <% end %>
  </div>
</div>

<div class="flex justify-start">
  <%= link_to patient_portal_prescriptions_path, class: "btn btn-ghost btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Back to Prescriptions
  <% end %>
</div>
