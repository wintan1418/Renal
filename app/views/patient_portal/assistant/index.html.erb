<% content_for(:title) { "Health Assistant" } %>

<div class="max-w-2xl mx-auto">
  <div class="mb-4">
    <h1 class="text-2xl font-bold flex items-center gap-2">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 4v-4z"/></svg>
      </span>
      Health Assistant
    </h1>
    <p class="text-base-content/60 text-sm mt-1">Ask general questions about kidney health and your care. Not a substitute for your doctor — for emergencies, call the centre.</p>
  </div>

  <div class="card bg-base-100 shadow-xl" data-controller="chat-assistant" data-chat-assistant-url-value="<%= patient_portal_assistant_message_path %>">
    <div class="card-body p-0">
      <div data-chat-assistant-target="messages" class="p-4 h-[55vh] overflow-y-auto space-y-1">
        <div class="chat chat-start">
          <div class="chat-bubble text-sm">Hello <%= current_user.first_name %>! I'm the Healthroom assistant. Ask me about kidney health, your care, or whether you should book a visit. I'm not a substitute for your doctor.</div>
        </div>
      </div>

      <form class="border-t border-base-200 p-3 flex gap-2" data-action="chat-assistant#submit">
        <input type="text" data-chat-assistant-target="input" autocomplete="off"
               class="input input-bordered flex-1" placeholder="Type your question…">
        <button type="submit" data-chat-assistant-target="send" class="btn btn-primary">Send</button>
      </form>
    </div>
  </div>

  <div class="flex flex-wrap gap-2 mt-3">
    <% ["What does my eGFR mean?", "Foods to avoid with kidney disease", "Should I book an appointment?", "How does dialysis work?"].each do |q| %>
      <button type="button" class="btn btn-xs btn-outline" onclick="const i=document.querySelector('[data-chat-assistant-target=input]'); i.value=this.textContent; i.focus();"><%= q %></button>
    <% end %>
  </div>
</div>
