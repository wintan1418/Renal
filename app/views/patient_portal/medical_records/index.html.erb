<% content_for(:title, "My Medical Records") %>

<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= patient_portal_root_path %>">Dashboard</a></li>
    <li>Medical Records</li>
  </ul>
</div>

<h1 class="text-2xl font-extrabold mb-6">My Medical Records</h1>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Left column: Recent Visits + Diagnoses -->
  <div class="lg:col-span-2 space-y-6">

    <!-- Recent Visits card -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Recent Visits</h2>
        <% if @recent_visits.any? %>
          <div class="overflow-x-auto">
            <table class="table table-zebra">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Doctor</th>
                  <th>Type</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_visits.each do |visit| %>
                  <tr>
                    <td class="font-medium"><%= visit.visit_date.strftime("%b %d, %Y") %></td>
                    <td>Dr. <%= visit.doctor.full_name %></td>
                    <td>
                      <span class="badge badge-outline badge-sm"><%= visit.visit_type.humanize %></span>
                    </td>
                    <td>
                      <% badge_class = case visit.status
                           when "completed" then "badge-success"
                           when "in_progress" then "badge-warning"
                           when "cancelled" then "badge-error"
                           else "badge-ghost"
                         end %>
                      <span class="badge <%= badge_class %> badge-sm"><%= visit.status.humanize %></span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="py-8 text-center">
            <div class="w-14 h-14 rounded-full bg-base-200 flex items-center justify-center mx-auto mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <p class="text-base-content/60">No visits recorded yet.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Diagnoses card -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Active Diagnoses</h2>
        <% if @active_diagnoses.any? %>
          <ul class="divide-y divide-base-200">
            <% @active_diagnoses.each do |diagnosis| %>
              <li class="py-3 flex items-start gap-3">
                <div class="w-2 h-2 rounded-full bg-primary mt-2 shrink-0"></div>
                <div class="flex-1">
                  <p class="font-medium"><%= diagnosis.description %></p>
                  <div class="flex flex-wrap items-center gap-2 mt-1 text-xs text-base-content/60">
                    <% type_class = diagnosis.primary? ? "badge-primary" : diagnosis.secondary? ? "badge-secondary" : "badge-ghost" %>
                    <span class="badge <%= type_class %> badge-xs"><%= diagnosis.diagnosis_type.humanize %></span>
                    <% status_class = diagnosis.status_chronic? ? "badge-warning" : "badge-success" %>
                    <span class="badge <%= status_class %> badge-xs"><%= diagnosis.status.humanize %></span>
                    <% if diagnosis.icd_code.present? %>
                      <span class="font-mono opacity-70">ICD: <%= diagnosis.icd_code %></span>
                    <% end %>
                    <% if diagnosis.diagnosed_by %>
                      <span>by Dr. <%= diagnosis.diagnosed_by.full_name %></span>
                    <% end %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="py-8 text-center">
            <p class="text-base-content/60">No active diagnoses on record.</p>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <!-- Right column: Profile + Allergies + Medications -->
  <div class="space-y-6">

    <!-- Profile Summary card -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Profile Summary</h2>
        <% if @profile %>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between items-center py-2 border-b border-base-200">
              <dt class="text-base-content/60 font-medium">MRN</dt>
              <dd class="font-mono font-bold text-primary"><%= @profile.medical_record_number %></dd>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-base-200">
              <dt class="text-base-content/60 font-medium">Date of Birth</dt>
              <dd class="font-medium">
                <% if @profile.date_of_birth %>
                  <%= @profile.date_of_birth.strftime("%b %d, %Y") %>
                  <span class="text-base-content/50 text-xs">(Age <%= @profile.age %>)</span>
                <% else %>
                  <span class="text-base-content/40">—</span>
                <% end %>
              </dd>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-base-200">
              <dt class="text-base-content/60 font-medium">Blood Group</dt>
              <dd>
                <% if @profile.blood_group %>
                  <span class="badge badge-error badge-sm font-bold"><%= @profile.blood_group_display %></span>
                <% else %>
                  <span class="text-base-content/40">—</span>
                <% end %>
              </dd>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-base-200">
              <dt class="text-base-content/60 font-medium">Genotype</dt>
              <dd>
                <% if @profile.genotype %>
                  <span class="badge badge-outline badge-sm"><%= @profile.genotype_display %></span>
                <% else %>
                  <span class="text-base-content/40">—</span>
                <% end %>
              </dd>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-base-200">
              <dt class="text-base-content/60 font-medium">CKD Stage</dt>
              <dd>
                <% if @profile.ckd_stage %>
                  <span class="badge badge-warning badge-sm"><%= @profile.ckd_stage.to_s.humanize %></span>
                <% else %>
                  <span class="text-base-content/40">—</span>
                <% end %>
              </dd>
            </div>
            <div class="flex justify-between items-center py-2">
              <dt class="text-base-content/60 font-medium">On Dialysis</dt>
              <dd>
                <% if @profile.on_dialysis %>
                  <span class="badge badge-info badge-sm">Yes</span>
                <% else %>
                  <span class="badge badge-ghost badge-sm">No</span>
                <% end %>
              </dd>
            </div>
          </dl>
        <% else %>
          <p class="text-base-content/60 text-sm">Profile not yet set up.</p>
        <% end %>
      </div>
    </div>

    <!-- Allergies card -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Allergies</h2>
        <% if @allergies.any? %>
          <ul class="space-y-2">
            <% @allergies.each do |allergy| %>
              <li class="flex items-center justify-between gap-2">
                <div>
                  <p class="font-medium text-sm"><%= allergy.allergen %></p>
                  <% if allergy.reaction.present? %>
                    <p class="text-xs text-base-content/60"><%= allergy.reaction %></p>
                  <% end %>
                </div>
                <% severity_class = case allergy.severity
                     when "mild" then "badge-info"
                     when "moderate" then "badge-warning"
                     when "severe" then "badge-error"
                     when "life_threatening" then "badge-error"
                     else "badge-ghost"
                   end %>
                <span class="badge <%= severity_class %> badge-sm shrink-0"><%= allergy.severity&.humanize %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-base-content/60 text-sm">No known allergies on record.</p>
        <% end %>
      </div>
    </div>

    <!-- Current Medications card -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Current Medications</h2>
        <% if @medications.any? %>
          <ul class="space-y-3">
            <% @medications.each do |med| %>
              <li class="flex items-start gap-2 pb-2 border-b border-base-200 last:border-0">
                <div class="w-2 h-2 rounded-full bg-secondary mt-2 shrink-0"></div>
                <div>
                  <p class="font-medium text-sm"><%= med.name %></p>
                  <div class="text-xs text-base-content/60 space-y-0.5">
                    <% if med.dosage.present? %>
                      <p>Dose: <%= med.dosage %></p>
                    <% end %>
                    <% if med.frequency.present? %>
                      <p>Frequency: <%= med.frequency %></p>
                    <% end %>
                    <% if med.route.present? %>
                      <p>Route: <%= med.route %></p>
                    <% end %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-base-content/60 text-sm">No active medications on record.</p>
        <% end %>
      </div>
    </div>

  </div>
</div>
