<% content_for(:title, @conversation.subject.presence || "Conversation") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-4">
  <ul>
    <li><a href="<%= patient_portal_root_path %>">Dashboard</a></li>
    <li><a href="<%= patient_portal_conversations_path %>">Messages</a></li>
    <li class="truncate max-w-xs"><%= @conversation.subject.presence || "Conversation" %></li>
  </ul>
</div>

<div class="max-w-2xl mx-auto" data-controller="message">
  <div class="bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col" style="height: calc(100vh - 220px); min-height: 500px;">
    <!-- Header -->
    <div class="p-4 border-b border-base-200 bg-base-50">
      <h1 class="font-bold text-lg"><%= @conversation.subject.presence || "Conversation" %></h1>
      <p class="text-xs text-base-content/50">Care Team</p>
    </div>

    <!-- Messages -->
    <div class="flex-1 overflow-y-auto p-4 space-y-4" data-message-target="messages">
      <% if @messages.empty? %>
        <div class="text-center py-8 text-base-content/40 text-sm">
          No messages yet. Start the conversation below.
        </div>
      <% end %>
      <% @messages.each do |message| %>
        <% is_mine = message.sender == current_user %>
        <div class="flex <%= is_mine ? 'justify-end' : 'justify-start' %> gap-3">
          <% unless is_mine %>
            <div class="shrink-0 mt-1">
              <%= avatar_for(message.sender, size: "w-8 h-8", text_size: "text-xs") %>
            </div>
          <% end %>
          <div class="max-w-xs lg:max-w-sm">
            <% unless is_mine %>
              <p class="text-xs text-base-content/50 mb-1 ml-1"><%= message.sender&.full_name %></p>
            <% end %>
            <div class="px-4 py-2.5 rounded-2xl text-sm
              <%= is_mine ? 'bg-primary text-primary-content rounded-br-sm' : 'bg-base-200 text-base-content rounded-bl-sm' %>">
              <%= simple_format(message.body, class: "leading-relaxed") %>
            </div>
            <p class="text-xs text-base-content/40 mt-1 <%= is_mine ? 'text-right mr-1' : 'ml-1' %>">
              <%= message.created_at.strftime("%H:%M") %>
              <% if is_mine && message.read_at %>
                &middot; Read
              <% end %>
            </p>
          </div>
          <% if is_mine %>
            <div class="shrink-0 mt-1">
              <%= avatar_for(current_user, size: "w-8 h-8", text_size: "text-xs") %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Reply Form -->
    <div class="p-4 border-t border-base-200 bg-base-50">
      <%= form_with url: patient_portal_conversation_messages_path(@conversation),
        method: :post,
        data: { action: "submit->message#clearInput" } do |f| %>
        <div class="flex gap-2">
          <div class="flex-1">
            <%= text_area_tag "message[body]", nil,
              rows: 2,
              class: "textarea textarea-bordered w-full resize-none text-sm",
              placeholder: "Type your reply...",
              data: { message_target: "input" } %>
          </div>
          <button type="submit" class="btn btn-primary self-end">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
            </svg>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
