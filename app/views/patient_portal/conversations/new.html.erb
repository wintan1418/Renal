<% content_for(:title, "New Message") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= patient_portal_root_path %>">Dashboard</a></li>
    <li><a href="<%= patient_portal_conversations_path %>">Messages</a></li>
    <li>New</li>
  </ul>
</div>

<div class="max-w-lg mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-extrabold">New Message</h1>
    <p class="text-base-content/60 text-sm mt-1">Send a message to our care team. We typically respond within 24 hours.</p>
  </div>

  <div class="bg-white rounded-2xl shadow-lg p-6">
    <%= form_with model: [:patient_portal, @conversation], class: "space-y-4" do |f| %>
      <% if @conversation.errors.any? %>
        <div class="alert alert-error">
          <ul class="list-disc list-inside">
            <% @conversation.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-control">
        <%= f.label :subject, "Subject", class: "label label-text font-medium" %>
        <%= f.text_field :subject, class: "input input-bordered w-full", placeholder: "What is this message about?" %>
      </div>

      <div class="form-control">
        <label class="label label-text font-medium">Message</label>
        <%= text_area_tag "message[body]", nil, rows: 5,
          class: "textarea textarea-bordered w-full",
          placeholder: "Type your message here..." %>
      </div>

      <div class="flex gap-3 justify-end">
        <%= link_to "Cancel", patient_portal_conversations_path, class: "btn btn-ghost" %>
        <%= f.submit "Send Message", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
