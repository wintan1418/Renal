<% content_for(:title, "Messages") %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-extrabold">Messages</h1>
  <%= link_to new_patient_portal_conversation_path, class: "btn btn-primary btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    New Message
  <% end %>
</div>

<div class="space-y-3">
  <% @conversations.each do |conversation| %>
    <%= link_to patient_portal_conversation_path(conversation), class: "block bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow p-4" do %>
      <div class="flex items-start justify-between gap-3">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <p class="font-semibold text-sm truncate"><%= conversation.subject.presence || "No subject" %></p>
            <% unread = conversation.messages.where.not(sender: current_user).where(read_at: nil).count %>
            <% if unread > 0 %>
              <span class="badge badge-primary badge-sm"><%= unread %></span>
            <% end %>
          </div>
          <% last_message = conversation.messages.last %>
          <% if last_message %>
            <p class="text-xs text-base-content/60 truncate"><%= last_message.body&.truncate(80) %></p>
          <% else %>
            <p class="text-xs text-base-content/40 italic">No messages yet</p>
          <% end %>
        </div>
        <div class="text-right shrink-0">
          <p class="text-xs text-base-content/40">
            <%= conversation.updated_at > 1.day.ago ? time_ago_in_words(conversation.updated_at) + " ago" : conversation.updated_at.strftime("%b %d") %>
          </p>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-base-content/30 mt-1 ml-auto">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if @conversations.empty? %>
    <div class="bg-white rounded-2xl shadow-lg p-12 text-center">
      <div class="w-16 h-16 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-base-content/30">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
        </svg>
      </div>
      <p class="text-base-content/60 mb-4">No messages yet. Start a conversation with our care team.</p>
      <%= link_to new_patient_portal_conversation_path, class: "btn btn-primary" do %>
        Send a Message
      <% end %>
    </div>
  <% end %>
</div>
