<% content_for(:title, "Dialysis Consumables") %>

<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Dashboard</a></li>
    <li>Dialysis Consumables</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-extrabold">Dialysis Consumables</h1>
    <% if @low_stock_count > 0 %>
      <div class="flex items-center gap-1 mt-1">
        <span class="badge badge-error badge-sm animate-pulse"><%= @low_stock_count %> low stock</span>
        <span class="text-xs text-base-content/60">items need restocking</span>
      </div>
    <% end %>
  </div>
  <%= link_to new_admin_dialysis_consumable_path, class: "btn btn-primary btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    Add Consumable
  <% end %>
</div>

<!-- Category Filter -->
<div class="card bg-base-100 shadow-xl mb-6">
  <div class="card-body py-4">
    <%= form_with url: admin_dialysis_consumables_path, method: :get, class: "flex flex-wrap gap-3" do |f| %>
      <div class="form-control">
        <%= f.select :category,
            DialysisConsumable.categories.keys.map { |c| [c.humanize.titleize, c] },
            { prompt: "All Categories", selected: params[:category] },
            class: "select select-bordered select-sm" %>
      </div>
      <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
      <% if params[:category].present? %>
        <%= link_to "Clear", admin_dialysis_consumables_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-0">
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Stock</th>
            <th>Reorder Level</th>
            <th>Unit</th>
            <th>Unit Cost</th>
            <th>Active</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @consumables.each do |item| %>
            <%
              is_low_stock = item.quantity_in_stock <= item.reorder_level
              is_active = item.active
            %>
            <tr class="hover <%= is_low_stock && is_active ? 'bg-error/5' : '' %>">
              <td class="font-medium">
                <%= item.name %>
                <% if is_low_stock && is_active %>
                  <span class="badge badge-error badge-xs ml-1">Low Stock</span>
                <% end %>
              </td>
              <td>
                <span class="badge badge-outline badge-sm"><%= item.category&.humanize&.titleize %></span>
              </td>
              <td>
                <span class="font-mono font-semibold <%= is_low_stock && is_active ? 'text-error' : '' %>">
                  <%= item.quantity_in_stock %>
                </span>
              </td>
              <td class="font-mono text-sm text-base-content/60"><%= item.reorder_level %></td>
              <td class="text-sm text-base-content/70"><%= item.unit %></td>
              <td class="text-sm">
                <% if item.unit_cost_cents > 0 %>
                  <%= money_symbol %><%= number_with_delimiter((item.unit_cost_cents / 100.0).to_i) %>
                <% else %>
                  <span class="text-base-content/40">—</span>
                <% end %>
              </td>
              <td>
                <% if item.active? %>
                  <span class="badge badge-success badge-sm">Active</span>
                <% else %>
                  <span class="badge badge-ghost badge-sm">Inactive</span>
                <% end %>
              </td>
              <td>
                <div class="flex items-center gap-1">
                  <%= link_to edit_admin_dialysis_consumable_path(item), class: "btn btn-ghost btn-xs" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                    </svg>
                    Edit
                  <% end %>
                  <%= button_to admin_dialysis_consumable_path(item), method: :delete, class: "btn btn-ghost btn-xs text-error",
                      data: { turbo_confirm: "Delete '#{item.name}'?" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                    Delete
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @consumables.empty? %>
            <tr>
              <td colspan="8" class="text-center py-10 text-base-content/60">
                No consumables found.
                <% if params[:category].present? %>
                  <%= link_to "Clear filter", admin_dialysis_consumables_path, class: "link link-primary" %>
                <% else %>
                  <%= link_to "Add first consumable", new_admin_dialysis_consumable_path, class: "link link-primary" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mt-6">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>
