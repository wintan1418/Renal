<% content_for(:title, "Manage Pages") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Admin</a></li>
    <li>Pages</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold">Pages</h1>
  <%= link_to new_admin_page_path, class: "btn btn-primary btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    New Page
  <% end %>
</div>

<!-- Search -->
<div class="card bg-base-100 shadow mb-6">
  <div class="card-body p-4">
    <%= form_with url: admin_pages_path, method: :get, class: "flex flex-col sm:flex-row gap-3" do |f| %>
      <div class="form-control flex-1">
        <%= f.search_field :q, value: params[:q], class: "input input-bordered input-sm w-full", placeholder: "Search pages..." %>
      </div>
      <%= f.submit "Search", class: "btn btn-primary btn-sm" %>
      <% if params[:q].present? %>
        <%= link_to "Clear", admin_pages_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>

<!-- Pages Table -->
<div class="card bg-base-100 shadow">
  <div class="card-body p-0">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Slug</th>
            <th>Author</th>
            <th>Status</th>
            <th>Updated</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @pages.each do |page| %>
            <tr class="hover">
              <td>
                <div class="font-bold"><%= page.title %></div>
              </td>
              <td class="text-sm text-base-content/60">/<%= page.slug %></td>
              <td><%= page.author&.full_name || "-" %></td>
              <td>
                <% if page.published? %>
                  <span class="badge badge-success badge-sm">Published</span>
                <% else %>
                  <span class="badge badge-ghost badge-sm">Draft</span>
                <% end %>
              </td>
              <td><%= page.updated_at.strftime("%b %d, %Y") %></td>
              <td>
                <div class="flex gap-1">
                  <%= link_to edit_admin_page_path(page), class: "btn btn-ghost btn-xs" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                    </svg>
                  <% end %>
                  <%= button_to admin_page_path(page), method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: "Are you sure you want to delete this page?" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @pages.empty? %>
            <tr>
              <td colspan="6" class="text-center py-8 text-base-content/60">No pages found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mt-6">
    <div class="join">
      <%== pagy_nav(@pagy) %>
    </div>
  </div>
<% end %>
