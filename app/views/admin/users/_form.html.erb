<%= form_with(model: [:admin, user], class: "space-y-6") do |f| %>
  <% if user.errors.any? %>
    <div class="alert alert-error">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <h3 class="font-bold"><%= pluralize(user.errors.count, "error") %> prevented this user from being saved:</h3>
        <ul class="list-disc list-inside mt-1">
          <% user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="form-control w-full">
      <%= f.label :first_name, class: "label" do %>
        <span class="label-text">First Name <span class="text-error">*</span></span>
      <% end %>
      <%= f.text_field :first_name, class: "input input-bordered w-full", placeholder: "Enter first name", required: true %>
    </div>

    <div class="form-control w-full">
      <%= f.label :last_name, class: "label" do %>
        <span class="label-text">Last Name <span class="text-error">*</span></span>
      <% end %>
      <%= f.text_field :last_name, class: "input input-bordered w-full", placeholder: "Enter last name", required: true %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="form-control w-full">
      <%= f.label :email, class: "label" do %>
        <span class="label-text">Email Address <span class="text-error">*</span></span>
      <% end %>
      <%= f.email_field :email, class: "input input-bordered w-full", placeholder: "user@example.com", required: true %>
    </div>

    <div class="form-control w-full">
      <%= f.label :phone, class: "label" do %>
        <span class="label-text">Phone Number</span>
      <% end %>
      <%= f.phone_field :phone, class: "input input-bordered w-full", placeholder: "+234..." %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="form-control w-full">
      <%= f.label :role, class: "label" do %>
        <span class="label-text">Role <span class="text-error">*</span></span>
      <% end %>
      <%= f.select :role, User.roles.keys.map { |r| [r.humanize, r] }, { prompt: "Select a role" }, class: "select select-bordered w-full" %>
    </div>

    <div class="form-control w-full">
      <%= f.label :active, class: "label" do %>
        <span class="label-text">Status</span>
      <% end %>
      <label class="label cursor-pointer justify-start gap-3">
        <%= f.check_box :active, class: "toggle toggle-primary" %>
        <span class="label-text">Active</span>
      </label>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="form-control w-full">
      <%= f.label :password, class: "label" do %>
        <span class="label-text">Password <%= user.new_record? ? content_tag(:span, "*", class: "text-error") : "(leave blank to keep current)" %></span>
      <% end %>
      <%= f.password_field :password, class: "input input-bordered w-full", placeholder: "Enter password", required: user.new_record?, autocomplete: "new-password" %>
    </div>

    <div class="form-control w-full">
      <%= f.label :password_confirmation, class: "label" do %>
        <span class="label-text">Confirm Password</span>
      <% end %>
      <%= f.password_field :password_confirmation, class: "input input-bordered w-full", placeholder: "Confirm password", autocomplete: "new-password" %>
    </div>
  </div>

  <div class="form-control w-full">
    <%= f.label :avatar, class: "label" do %>
      <span class="label-text">Profile Photo</span>
    <% end %>
    <%= f.file_field :avatar, class: "file-input file-input-bordered w-full", accept: "image/*" %>
    <% if user.persisted? && user.avatar.attached? %>
      <div class="mt-2 flex items-center gap-2">
        <%= avatar_for(user, size: "w-12 h-12") %>
        <span class="text-sm text-base-content/60">Current photo</span>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-3 pt-4">
    <%= f.submit user.new_record? ? "Create User" : "Update User", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_users_path, class: "btn btn-ghost" %>
  </div>
<% end %>
