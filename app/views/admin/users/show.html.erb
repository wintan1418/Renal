<% content_for(:title, @user.full_name) %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Admin</a></li>
    <li><a href="<%= admin_users_path %>">Users</a></li>
    <li><%= @user.full_name %></li>
  </ul>
</div>

<div class="flex flex-col lg:flex-row gap-6">
  <!-- User Profile Card -->
  <div class="card bg-base-100 shadow lg:w-1/3">
    <div class="card-body items-center text-center">
      <%= avatar_for(@user, size: "w-24 h-24", text_size: "text-3xl") %>
      <h2 class="card-title mt-4"><%= @user.full_name %></h2>
      <div class="flex gap-2 mt-1">
        <%= role_badge(@user.role) %>
        <% if @user.active? %>
          <span class="badge badge-success badge-sm">Active</span>
        <% else %>
          <span class="badge badge-ghost badge-sm">Inactive</span>
        <% end %>
      </div>
      <div class="divider"></div>
      <div class="w-full space-y-3 text-left">
        <div class="flex justify-between">
          <span class="text-base-content/60">Email</span>
          <span class="font-medium"><%= @user.email %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/60">Phone</span>
          <span class="font-medium"><%= @user.phone || "Not provided" %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/60">Joined</span>
          <span class="font-medium"><%= @user.created_at.strftime("%b %d, %Y") %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/60">Last Sign In</span>
          <span class="font-medium"><%= @user.last_sign_in_at&.strftime("%b %d, %Y %H:%M") || "Never" %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/60">Sign In Count</span>
          <span class="font-medium"><%= @user.sign_in_count %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/60">Confirmed</span>
          <span class="font-medium"><%= @user.confirmed_at ? @user.confirmed_at.strftime("%b %d, %Y") : "Unconfirmed" %></span>
        </div>
      </div>
      <div class="card-actions mt-4 w-full">
        <%= link_to "Edit User", edit_admin_user_path(@user), class: "btn btn-primary btn-sm flex-1" %>
        <% if @user.active? && @user != current_user %>
          <%= button_to "Deactivate", admin_user_path(@user), method: :delete, class: "btn btn-error btn-sm btn-outline flex-1", data: { turbo_confirm: "Are you sure you want to deactivate this user?" } %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Details -->
  <div class="flex-1 space-y-6">
    <% if @user.staff? && @user.staff_profile.present? %>
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h3 class="card-title text-lg">Staff Profile</h3>
          <div class="divider mt-0"></div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <p class="text-sm text-base-content/60">Employee ID</p>
              <p class="font-medium"><%= @user.staff_profile.employee_id || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Department</p>
              <p class="font-medium"><%= @user.staff_profile.department&.name || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Specialization</p>
              <p class="font-medium"><%= @user.staff_profile.specialization || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">License Number</p>
              <p class="font-medium"><%= @user.staff_profile.license_number || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Qualification</p>
              <p class="font-medium"><%= @user.staff_profile.qualification || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Experience</p>
              <p class="font-medium"><%= @user.staff_profile.years_of_experience ? "#{@user.staff_profile.years_of_experience} years" : "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Consultation Fee</p>
              <p class="font-medium"><%= format_naira(@user.staff_profile.consultation_fee_cents) %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Telemedicine</p>
              <p class="font-medium"><%= @user.staff_profile.available_for_telemedicine? ? "Available" : "Not Available" %></p>
            </div>
          </div>
          <% if @user.staff_profile.bio.present? %>
            <div class="mt-4">
              <p class="text-sm text-base-content/60">Bio</p>
              <p class="mt-1"><%= @user.staff_profile.bio %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @user.patient? && @user.patient_profile.present? %>
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h3 class="card-title text-lg">Patient Profile</h3>
          <div class="divider mt-0"></div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <div>
              <p class="text-sm text-base-content/60">MRN</p>
              <p class="font-medium font-mono"><%= @user.patient_profile.medical_record_number %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Date of Birth</p>
              <p class="font-medium"><%= @user.patient_profile.date_of_birth&.strftime("%b %d, %Y") || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Age</p>
              <p class="font-medium"><%= @user.patient_profile.age || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Gender</p>
              <p class="font-medium"><%= @user.patient_profile.gender&.humanize || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Blood Group</p>
              <p class="font-medium"><%= @user.patient_profile.blood_group_display || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Genotype</p>
              <p class="font-medium"><%= @user.patient_profile.genotype_display || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">CKD Stage</p>
              <p class="font-medium"><%= @user.patient_profile.ckd_stage&.humanize || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">On Dialysis</p>
              <p class="font-medium"><%= @user.patient_profile.on_dialysis? ? "Yes" : "No" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Transplant Status</p>
              <p class="font-medium"><%= @user.patient_profile.transplant_status&.humanize || "-" %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h3 class="card-title text-lg">Next of Kin</h3>
          <div class="divider mt-0"></div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <p class="text-sm text-base-content/60">Name</p>
              <p class="font-medium"><%= @user.patient_profile.nok_name || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Phone</p>
              <p class="font-medium"><%= @user.patient_profile.nok_phone || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Relationship</p>
              <p class="font-medium"><%= @user.patient_profile.nok_relationship || "-" %></p>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Address</p>
              <p class="font-medium"><%= @user.patient_profile.nok_address || "-" %></p>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if !@user.staff? && !@user.patient? %>
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <p class="text-base-content/60">No additional profile information available for this user.</p>
        </div>
      </div>
    <% end %>
  </div>
</div>
