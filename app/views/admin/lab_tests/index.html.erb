<% content_for(:title, "Lab Tests") %>

<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Dashboard</a></li>
    <li>Lab Tests</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-extrabold">Lab Tests</h1>
  <%= link_to new_admin_lab_test_path, class: "btn btn-primary btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    New Lab Test
  <% end %>
</div>

<!-- Filters -->
<div class="card bg-base-100 shadow-xl mb-6">
  <div class="card-body py-4">
    <%= form_with url: admin_lab_tests_path, method: :get, class: "flex flex-col sm:flex-row gap-3 flex-wrap" do |f| %>
      <div class="form-control flex-1 min-w-[200px]">
        <div class="input input-bordered input-sm flex items-center gap-2 bg-base-200 w-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <%= f.text_field :search, value: params[:search], placeholder: "Search by name...", class: "grow bg-transparent border-none outline-none text-sm" %>
        </div>
      </div>
      <div class="form-control">
        <%= f.select :category,
            LabTest.categories.keys.map { |c| [c.humanize.titleize, c] },
            { prompt: "All Categories", selected: params[:category] },
            class: "select select-bordered select-sm" %>
      </div>
      <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
      <% if params[:search].present? || params[:category].present? %>
        <%= link_to "Clear", admin_lab_tests_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>

<!-- Lab Tests Table -->
<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-0">
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Category</th>
            <th>Normal Range</th>
            <th>Unit</th>
            <th>Price</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @lab_tests.each do |lab_test| %>
            <tr class="hover">
              <td class="font-medium"><%= lab_test.name %></td>
              <td>
                <span class="font-mono text-sm badge badge-ghost"><%= lab_test.code %></span>
              </td>
              <td>
                <span class="badge badge-outline badge-sm"><%= lab_test.category&.humanize&.titleize %></span>
              </td>
              <td class="text-sm text-base-content/70">
                <% if lab_test.normal_range_min || lab_test.normal_range_max %>
                  <%= lab_test.normal_range_min || '—' %> – <%= lab_test.normal_range_max || '—' %>
                <% else %>
                  <span class="text-base-content/40">—</span>
                <% end %>
              </td>
              <td class="text-sm text-base-content/70"><%= lab_test.unit.presence || '—' %></td>
              <td class="text-sm">
                <% if lab_test.price_cents > 0 %>
                  <%= money_symbol %><%= number_with_delimiter(lab_test.price_naira.to_i) %>
                <% else %>
                  <span class="text-base-content/40">—</span>
                <% end %>
              </td>
              <td>
                <% if lab_test.active? %>
                  <span class="badge badge-success badge-sm">Active</span>
                <% else %>
                  <span class="badge badge-ghost badge-sm">Inactive</span>
                <% end %>
              </td>
              <td>
                <div class="flex items-center gap-1">
                  <%= link_to edit_admin_lab_test_path(lab_test), class: "btn btn-ghost btn-xs" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                    </svg>
                    Edit
                  <% end %>
                  <%= button_to admin_lab_test_path(lab_test), method: :delete, class: "btn btn-ghost btn-xs text-error",
                      data: { turbo_confirm: "Delete '#{lab_test.name}'? This cannot be undone." } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                    Delete
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @lab_tests.empty? %>
            <tr>
              <td colspan="8" class="text-center py-10 text-base-content/60">
                No lab tests found.
                <% if params[:search].present? || params[:category].present? %>
                  <%= link_to "Clear filters", admin_lab_tests_path, class: "link link-primary" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mt-6">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>
