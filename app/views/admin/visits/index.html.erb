<% content_for(:title, "All Visits") %>

<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Dashboard</a></li>
    <li>Visits</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-extrabold">All Visits</h1>
</div>

<!-- Filters -->
<div class="card bg-base-100 shadow-xl mb-6">
  <div class="card-body py-4">
    <%= form_with url: admin_visits_path, method: :get, class: "flex flex-col sm:flex-row gap-3 flex-wrap" do |f| %>
      <div class="form-control">
        <%= f.date_field :date, value: params[:date], class: "input input-bordered input-sm", placeholder: "Date" %>
      </div>
      <div class="form-control">
        <%= f.select :status,
            Visit.statuses.keys.map { |s| [s.humanize, s] },
            { prompt: "All Statuses", selected: params[:status] },
            class: "select select-bordered select-sm" %>
      </div>
      <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
      <% if params[:date].present? || params[:status].present? %>
        <%= link_to "Clear", admin_visits_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>

<!-- Visits Table -->
<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-0">
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>ID</th>
            <th>Date</th>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Type</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @visits.each do |visit| %>
            <tr class="hover">
              <td class="text-sm text-base-content/60 font-mono">#<%= visit.id %></td>
              <td class="font-medium"><%= visit.visit_date.strftime("%b %d, %Y") %></td>
              <td>
                <div class="flex items-center gap-2">
                  <%= avatar_for(visit.patient, size: "w-7 h-7", text_size: "text-xs") %>
                  <div>
                    <div class="font-medium text-sm"><%= visit.patient.full_name %></div>
                    <div class="text-xs text-base-content/50"><%= visit.patient.patient_profile&.medical_record_number %></div>
                  </div>
                </div>
              </td>
              <td class="text-sm">Dr. <%= visit.doctor.full_name %></td>
              <td>
                <span class="badge badge-outline badge-sm"><%= visit.visit_type.humanize %></span>
              </td>
              <td>
                <% status_class = case visit.status
                     when "completed" then "badge-success"
                     when "in_progress" then "badge-warning"
                     when "cancelled" then "badge-error"
                     else "badge-ghost"
                   end %>
                <span class="badge <%= status_class %> badge-sm"><%= visit.status.humanize %></span>
              </td>
              <td>
                <%= link_to admin_visit_path(visit), class: "btn btn-ghost btn-xs" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  </svg>
                  View
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @visits.empty? %>
            <tr>
              <td colspan="7" class="text-center py-10 text-base-content/60">No visits found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mt-6">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>
