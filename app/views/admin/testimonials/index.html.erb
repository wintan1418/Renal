<% content_for(:title, "Manage Testimonials") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Admin</a></li>
    <li>Testimonials</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold">Testimonials</h1>
  <%= link_to new_admin_testimonial_path, class: "btn btn-primary btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    Add Testimonial
  <% end %>
</div>

<!-- Search & Filter -->
<div class="card bg-base-100 shadow mb-6">
  <div class="card-body p-4">
    <%= form_with url: admin_testimonials_path, method: :get, class: "flex flex-col sm:flex-row gap-3" do |f| %>
      <div class="form-control flex-1">
        <%= f.search_field :q, value: params[:q], class: "input input-bordered input-sm w-full", placeholder: "Search testimonials..." %>
      </div>
      <%= f.submit "Search", class: "btn btn-primary btn-sm" %>
      <% if params[:q].present? || params[:filter].present? %>
        <%= link_to "Clear", admin_testimonials_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>

<!-- Filter Tabs -->
<div class="tabs tabs-boxed mb-6 bg-base-100 p-1">
  <%= link_to "All", admin_testimonials_path(q: params[:q]), class: "tab #{params[:filter].blank? ? 'tab-active' : ''}" %>
  <%= link_to "Approved", admin_testimonials_path(filter: "approved", q: params[:q]), class: "tab #{params[:filter] == 'approved' ? 'tab-active' : ''}" %>
  <%= link_to "Pending", admin_testimonials_path(filter: "pending", q: params[:q]), class: "tab #{params[:filter] == 'pending' ? 'tab-active' : ''}" %>
</div>

<!-- Testimonials Table -->
<div class="card bg-base-100 shadow">
  <div class="card-body p-0">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Patient</th>
            <th>Content</th>
            <th>Rating</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @testimonials.each do |testimonial| %>
            <tr class="hover">
              <td>
                <div class="flex items-center gap-3">
                  <% if testimonial.photo.attached? %>
                    <%= image_tag testimonial.photo.variant(resize_to_limit: [40, 40]), class: "w-10 h-10 rounded-full object-cover" %>
                  <% else %>
                    <div class="w-10 h-10 rounded-full bg-base-300 flex items-center justify-center">
                      <span class="text-sm font-bold"><%= testimonial.patient_name[0].upcase %></span>
                    </div>
                  <% end %>
                  <div class="font-bold"><%= testimonial.patient_name %></div>
                </div>
              </td>
              <td>
                <div class="max-w-xs truncate text-sm"><%= testimonial.content %></div>
              </td>
              <td>
                <% if testimonial.rating %>
                  <div class="flex items-center gap-1">
                    <% testimonial.rating.times do %>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-warning">
                        <path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" />
                      </svg>
                    <% end %>
                    <span class="text-sm text-base-content/60 ml-1"><%= testimonial.rating %>/5</span>
                  </div>
                <% else %>
                  <span class="text-base-content/40">-</span>
                <% end %>
              </td>
              <td>
                <% if testimonial.approved? %>
                  <span class="badge badge-success badge-sm">Approved</span>
                <% else %>
                  <span class="badge badge-warning badge-sm">Pending</span>
                <% end %>
              </td>
              <td><%= testimonial.created_at.strftime("%b %d, %Y") %></td>
              <td>
                <div class="flex gap-1">
                  <% unless testimonial.approved? %>
                    <%= button_to admin_testimonial_path(testimonial), params: { testimonial: { approved: true } }, method: :patch, class: "btn btn-ghost btn-xs text-success", data: { turbo_confirm: "Approve this testimonial?" } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                      </svg>
                    <% end %>
                  <% end %>
                  <%= link_to edit_admin_testimonial_path(testimonial), class: "btn btn-ghost btn-xs" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                    </svg>
                  <% end %>
                  <%= button_to admin_testimonial_path(testimonial), method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: "Are you sure you want to delete this testimonial?" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @testimonials.empty? %>
            <tr>
              <td colspan="6" class="text-center py-8 text-base-content/60">No testimonials found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mt-6">
    <div class="join">
      <%== pagy_nav(@pagy) %>
    </div>
  </div>
<% end %>
