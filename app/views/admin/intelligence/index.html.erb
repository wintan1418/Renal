<% content_for(:title) { "Smart Intelligence" } %>
<% pop = @data[:population]; rev = @data[:revenue]; ops = @data[:operations] %>
<%
  risk_badge = ->(level) {
    map = { critical: "badge-error", elevated: "badge-warning", monitor: "badge-info", stable: "badge-success", unknown: "badge-ghost" }
    "badge #{map[level] || 'badge-ghost'} badge-sm"
  }
%>

<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold flex items-center gap-2">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </span>
        Smart Intelligence
      </h1>
      <p class="text-base-content/60 text-sm mt-1">Predictive insights across clinical risk, revenue and operations — computed live from your data.</p>
    </div>
    <%= link_to admin_analytics_path, class: "btn btn-sm btn-ghost" do %>View classic analytics →<% end %>
  </div>

  <!-- KPI row -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <% [
      { label: "Active patients", value: pop[:total_patients], sub: "#{pop[:on_dialysis]} on dialysis", accent: "text-primary" },
      { label: "Collected revenue", value: format_naira(rev[:collected_cents]), sub: "#{rev[:collection_rate]}% collection rate", accent: "text-success" },
      { label: "Outstanding A/R", value: format_naira(rev[:outstanding_cents]), sub: "awaiting payment", accent: "text-warning" },
      { label: "Overdue labs", value: pop[:overdue_labs], sub: "no panel in 90 days", accent: "text-error" }
    ].each do |kpi| %>
      <div class="card bg-base-100 shadow">
        <div class="card-body p-5">
          <p class="text-xs uppercase tracking-wider text-base-content/50"><%= kpi[:label] %></p>
          <p class="text-2xl font-bold <%= kpi[:accent] %> mt-1"><%= kpi[:value] %></p>
          <p class="text-xs text-base-content/50 mt-1"><%= kpi[:sub] %></p>
        </div>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Revenue trend -->
    <div class="card bg-base-100 shadow lg:col-span-2">
      <div class="card-body">
        <h2 class="card-title text-base">Revenue trend (6 months)</h2>
        <% if rev[:monthly_revenue].present? %>
          <%= area_chart rev[:monthly_revenue], colors: ["#2B8B75"], suffix: "", prefix: money_symbol, thousands: ",", height: "240px", curve: true %>
        <% else %>
          <p class="text-sm text-base-content/50 py-10 text-center">No payment history yet.</p>
        <% end %>
      </div>
    </div>

    <!-- CKD stage distribution -->
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title text-base">CKD stage mix</h2>
        <% if pop[:ckd_stage_distribution].present? %>
          <%= pie_chart pop[:ckd_stage_distribution], colors: ["#2B8B75","#3FA98D","#E8B23F","#E8773F","#D9534F","#8B2B40"], height: "240px", donut: true %>
        <% else %>
          <p class="text-sm text-base-content/50 py-10 text-center">No staged patients yet.</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- At-risk patients -->
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <h2 class="card-title text-base">Patients needing attention</h2>
        <span class="badge badge-ghost"><%= @data[:at_risk].size %> flagged</span>
      </div>
      <p class="text-xs text-base-content/50 mb-2">Ranked by predicted kidney-function risk. Click a patient for the full intelligence profile.</p>
      <% if @data[:at_risk].any? %>
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr><th>Patient</th><th>Risk</th><th>Latest eGFR</th><th>Trend / year</th><th>Projection</th><th></th></tr>
            </thead>
            <tbody>
              <% @data[:at_risk].each do |row| %>
                <% a = row[:analysis] %>
                <tr class="hover">
                  <td class="font-medium"><%= row[:patient].full_name %></td>
                  <td><span class="<%= risk_badge.call(a.risk_level) %> capitalize"><%= a.risk_level %></span></td>
                  <td><%= a.latest_egfr ? "#{a.latest_egfr.round(0)} mL/min" : "—" %></td>
                  <td>
                    <% if a.slope_per_year %>
                      <span class="<%= a.slope_per_year.negative? ? 'text-error' : 'text-success' %>">
                        <%= a.slope_per_year.negative? ? "▼" : "▲" %> <%= a.slope_per_year.abs %>
                      </span>
                    <% else %>—<% end %>
                  </td>
                  <td class="text-sm"><%= a.projected_months_to_esrd&.positive? ? "~#{a.projected_months_to_esrd} mo to ESRD" : "—" %></td>
                  <td class="text-right"><%= link_to "Profile →", admin_intelligence_patient_path(row[:patient]), class: "btn btn-xs btn-ghost text-primary" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-base-content/50 py-6 text-center">No elevated-risk patients detected. 🎉</p>
      <% end %>
    </div>
  </div>

  <!-- Appointment no-show risk -->
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h2 class="card-title text-base">Appointment no-show risk</h2>
      <p class="text-xs text-base-content/50 mb-2">Upcoming appointments most likely to be missed — prioritise confirmation calls.</p>
      <% risks = (@data[:no_show_risks] || []).select { |p| p.risk != :low } %>
      <% if risks.any? %>
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead><tr><th>Patient</th><th>Date</th><th>Risk</th><th>Why</th></tr></thead>
            <tbody>
              <% risks.each do |p| %>
                <tr>
                  <td class="font-medium"><%= p.appointment.patient.full_name %></td>
                  <td class="text-sm"><%= p.appointment.scheduled_date.strftime("%b %d") %> · <%= p.appointment.start_time %></td>
                  <td><span class="badge badge-sm <%= p.risk == :high ? 'badge-error' : 'badge-warning' %>"><%= p.score %>%</span></td>
                  <td class="text-xs text-base-content/60"><%= p.reasons.first(2).join(" · ") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-base-content/50 py-6 text-center">No high-risk upcoming appointments.</p>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Inventory forecast -->
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title text-base">Inventory forecast</h2>
        <p class="text-xs text-base-content/50 mb-2">Days to stock-out from recent consumption.</p>
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead><tr><th>Item</th><th>In stock</th><th>~Days left</th><th>Status</th></tr></thead>
            <tbody>
              <% @data[:inventory].first(8).each do |i| %>
                <tr>
                  <td class="font-medium text-sm"><%= i[:name] %></td>
                  <td><%= i[:in_stock] %></td>
                  <td><%= i[:days_to_stockout] || "—" %></td>
                  <td>
                    <% case i[:status]
                       when :reorder_now %><span class="badge badge-error badge-sm">Reorder now</span>
                    <% when :reorder_soon %><span class="badge badge-warning badge-sm">Soon</span>
                    <% else %><span class="badge badge-success badge-sm">OK</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Operations snapshot -->
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title text-base">Operations snapshot</h2>
        <div class="grid grid-cols-2 gap-3 mt-2">
          <% [
            ["Dialysis sessions today", ops[:sessions_today]],
            ["Sessions this week", ops[:sessions_this_week]],
            ["Stations available", "#{ops[:stations_available]}/#{ops[:stations_total]}"],
            ["Machines operational", ops[:machines_operational]],
            ["Appointments (7 days)", ops[:upcoming_appointments]],
            ["Transplant waitlist", pop[:transplant_waitlisted]]
          ].each do |label, value| %>
            <div class="rounded-xl bg-base-200/60 p-4">
              <p class="text-xl font-bold"><%= value %></p>
              <p class="text-xs text-base-content/60 mt-1"><%= label %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
