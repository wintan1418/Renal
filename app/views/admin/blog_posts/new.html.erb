<% content_for(:title, "New Blog Post") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Admin</a></li>
    <li><a href="<%= admin_blog_posts_path %>">Blog Posts</a></li>
    <li>New Post</li>
  </ul>
</div>

<div class="max-w-4xl">
  <h1 class="text-2xl font-bold mb-6">Create New Blog Post</h1>

  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <%= render "form", blog_post: @blog_post %>
    </div>
  </div>
</div>
