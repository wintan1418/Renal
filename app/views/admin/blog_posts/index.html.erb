<% content_for(:title, "Manage Blog Posts") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Admin</a></li>
    <li>Blog Posts</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold">Blog Posts</h1>
  <%= link_to new_admin_blog_post_path, class: "btn btn-primary btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    New Post
  <% end %>
</div>

<!-- Search & Filters -->
<div class="card bg-base-100 shadow mb-6">
  <div class="card-body p-4">
    <%= form_with url: admin_blog_posts_path, method: :get, class: "flex flex-col sm:flex-row gap-3" do |f| %>
      <div class="form-control flex-1">
        <%= f.search_field :q, value: params[:q], class: "input input-bordered input-sm w-full", placeholder: "Search posts..." %>
      </div>
      <div class="form-control">
        <%= f.select :status, BlogPost.statuses.keys.map { |s| [s.humanize, s] }, { prompt: "All Statuses" }, class: "select select-bordered select-sm", value: params[:status] %>
      </div>
      <div class="form-control">
        <%= f.select :category, BlogPost.categories.keys.map { |c| [c.humanize, c] }, { prompt: "All Categories" }, class: "select select-bordered select-sm", value: params[:category] %>
      </div>
      <%= f.submit "Search", class: "btn btn-primary btn-sm" %>
      <% if params[:q].present? || params[:status].present? || params[:category].present? %>
        <%= link_to "Clear", admin_blog_posts_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>

<!-- Status Filter Tabs -->
<div class="tabs tabs-boxed mb-6 bg-base-100 p-1">
  <%= link_to "All", admin_blog_posts_path(q: params[:q], category: params[:category]), class: "tab #{params[:status].blank? ? 'tab-active' : ''}" %>
  <% BlogPost.statuses.keys.each do |status| %>
    <%= link_to status.humanize, admin_blog_posts_path(status: status, q: params[:q], category: params[:category]), class: "tab #{params[:status] == status ? 'tab-active' : ''}" %>
  <% end %>
</div>

<!-- Blog Posts Table -->
<div class="card bg-base-100 shadow">
  <div class="card-body p-0">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Status</th>
            <th>Views</th>
            <th>Published</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @blog_posts.each do |post| %>
            <tr class="hover">
              <td>
                <div>
                  <div class="font-bold"><%= post.title %></div>
                  <div class="text-sm text-base-content/60">/blog/<%= post.slug %></div>
                </div>
              </td>
              <td>
                <div class="flex items-center gap-2">
                  <%= avatar_for(post.author, size: "w-6 h-6", text_size: "text-xs") %>
                  <span class="text-sm"><%= post.author.full_name %></span>
                </div>
              </td>
              <td><span class="badge badge-outline badge-sm"><%= post.category&.humanize %></span></td>
              <td>
                <% case post.status %>
                <% when "draft" %>
                  <span class="badge badge-ghost badge-sm">Draft</span>
                <% when "published" %>
                  <span class="badge badge-success badge-sm">Published</span>
                <% when "archived" %>
                  <span class="badge badge-warning badge-sm">Archived</span>
                <% end %>
              </td>
              <td><%= post.views_count %></td>
              <td><%= post.published_at&.strftime("%b %d, %Y") || "-" %></td>
              <td>
                <div class="flex gap-1">
                  <%= link_to edit_admin_blog_post_path(post), class: "btn btn-ghost btn-xs" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                    </svg>
                  <% end %>
                  <%= button_to admin_blog_post_path(post), method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: "Are you sure you want to delete this post?" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @blog_posts.empty? %>
            <tr>
              <td colspan="7" class="text-center py-8 text-base-content/60">No blog posts found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mt-6">
    <div class="join">
      <%== pagy_nav(@pagy) %>
    </div>
  </div>
<% end %>
