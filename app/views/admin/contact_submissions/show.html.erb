<% content_for(:title, "Contact Submission from #{@contact_submission.name}") %>

<!-- Breadcrumbs -->
<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Admin</a></li>
    <li><a href="<%= admin_contact_submissions_path %>">Contact Submissions</a></li>
    <li><%= @contact_submission.name %></li>
  </ul>
</div>

<div class="max-w-3xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Contact Submission</h1>
    <%= link_to "Back to List", admin_contact_submissions_path, class: "btn btn-ghost btn-sm" %>
  </div>

  <!-- Submission Details -->
  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body">
      <div class="flex items-center justify-between mb-4">
        <h2 class="card-title text-lg">Message Details</h2>
        <% case @contact_submission.status %>
        <% when "unread" %>
          <span class="badge badge-primary">Unread</span>
        <% when "read" %>
          <span class="badge badge-info">Read</span>
        <% when "responded" %>
          <span class="badge badge-success">Responded</span>
        <% end %>
      </div>

      <div class="divider mt-0"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div>
          <p class="text-sm text-base-content/60">From</p>
          <p class="font-medium"><%= @contact_submission.name %></p>
        </div>
        <div>
          <p class="text-sm text-base-content/60">Email</p>
          <p class="font-medium">
            <a href="mailto:<%= @contact_submission.email %>" class="link link-primary"><%= @contact_submission.email %></a>
          </p>
        </div>
        <div>
          <p class="text-sm text-base-content/60">Phone</p>
          <p class="font-medium"><%= @contact_submission.phone || "Not provided" %></p>
        </div>
        <div>
          <p class="text-sm text-base-content/60">Received</p>
          <p class="font-medium"><%= @contact_submission.created_at.strftime("%B %d, %Y at %H:%M") %></p>
        </div>
      </div>

      <% if @contact_submission.subject.present? %>
        <div class="mb-4">
          <p class="text-sm text-base-content/60">Subject</p>
          <p class="font-medium text-lg"><%= @contact_submission.subject %></p>
        </div>
      <% end %>

      <div>
        <p class="text-sm text-base-content/60 mb-2">Message</p>
        <div class="bg-base-200 rounded-lg p-4">
          <p class="whitespace-pre-wrap"><%= @contact_submission.message %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Response Section -->
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h2 class="card-title text-lg">Response</h2>
      <div class="divider mt-0"></div>

      <%= form_with(model: [:admin, @contact_submission], class: "space-y-4") do |f| %>
        <div class="form-control w-full">
          <%= f.label :status, class: "label" do %>
            <span class="label-text">Status</span>
          <% end %>
          <%= f.select :status, ContactSubmission.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "select select-bordered w-full" %>
        </div>

        <div class="form-control w-full">
          <%= f.label :response_notes, class: "label" do %>
            <span class="label-text">Internal Notes / Response</span>
          <% end %>
          <%= f.text_area :response_notes, class: "textarea textarea-bordered w-full h-32", placeholder: "Add notes about this submission or your response..." %>
        </div>

        <% if @contact_submission.responded_by.present? %>
          <div class="text-sm text-base-content/60">
            Last responded by <span class="font-medium"><%= @contact_submission.responded_by.full_name %></span>
          </div>
        <% end %>

        <div class="flex items-center gap-3 pt-2">
          <%= f.submit "Update Submission", class: "btn btn-primary" %>
          <a href="mailto:<%= @contact_submission.email %>?subject=Re: <%= @contact_submission.subject %>" class="btn btn-outline btn-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            Reply via Email
          </a>
        </div>
      <% end %>
    </div>
  </div>
</div>
