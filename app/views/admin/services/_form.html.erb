<%= form_with(model: [:admin, service], class: "space-y-6") do |f| %>
  <% if service.errors.any? %>
    <div class="alert alert-error">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <h3 class="font-bold"><%= pluralize(service.errors.count, "error") %> prevented this service from being saved:</h3>
        <ul class="list-disc list-inside mt-1">
          <% service.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="form-control w-full">
      <%= f.label :name, class: "label" do %>
        <span class="label-text">Service Name <span class="text-error">*</span></span>
      <% end %>
      <%= f.text_field :name, class: "input input-bordered w-full", placeholder: "e.g. Dialysis Session", required: true %>
    </div>

    <div class="form-control w-full">
      <%= f.label :department_id, class: "label" do %>
        <span class="label-text">Department</span>
      <% end %>
      <%= f.select :department_id, Department.active.order(:name).map { |d| [d.name, d.id] }, { prompt: "Select Department", include_blank: "None" }, class: "select select-bordered w-full" %>
    </div>
  </div>

  <div class="form-control w-full">
    <%= f.label :description, class: "label" do %>
      <span class="label-text">Description</span>
    <% end %>
    <%= f.text_area :description, class: "textarea textarea-bordered w-full h-24", placeholder: "Describe this service..." %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="form-control w-full">
      <%= f.label :price_cents, class: "label" do %>
        <span class="label-text">Price (in cents)</span>
      <% end %>
      <label class="input input-bordered flex items-center gap-2">
        <span class="text-base-content/60"><%= money_symbol %></span>
        <%= f.number_field :price_cents, class: "grow", placeholder: "0", min: 0, step: 100 %>
      </label>
      <label class="label">
        <span class="label-text-alt text-base-content/50">Enter amount in cents (100 cents = 1 unit)</span>
      </label>
    </div>

    <div class="form-control w-full">
      <%= f.label :duration_minutes, class: "label" do %>
        <span class="label-text">Duration (minutes)</span>
      <% end %>
      <%= f.number_field :duration_minutes, class: "input input-bordered w-full", placeholder: "30", min: 1 %>
    </div>

    <div class="form-control w-full">
      <%= f.label :service_type, class: "label" do %>
        <span class="label-text">Service Type</span>
      <% end %>
      <%= f.select :service_type, Service.service_types.keys.map { |t| [t.humanize, t] }, { prompt: "Select Type" }, class: "select select-bordered w-full" %>
    </div>
  </div>

  <div class="form-control w-full">
    <%= f.label :active, class: "label" do %>
      <span class="label-text">Status</span>
    <% end %>
    <label class="label cursor-pointer justify-start gap-3">
      <%= f.check_box :active, class: "toggle toggle-primary" %>
      <span class="label-text">Active</span>
    </label>
  </div>

  <div class="flex items-center gap-3 pt-4">
    <%= f.submit service.new_record? ? "Create Service" : "Update Service", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_services_path, class: "btn btn-ghost" %>
  </div>
<% end %>
