<% content_for(:title) { "CRM · Leads" } %>

<div class="space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">Lead pipeline</h1>
      <p class="text-base-content/60 text-sm mt-1">Track enquiries from first contact to converted patient.</p>
    </div>
  </div>

  <!-- KPIs -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <% [
      ["Open leads", @stats[:open], "text-primary"],
      ["Due for follow-up", @stats[:due], "text-warning"],
      ["Converted", @stats[:converted], "text-success"],
      ["Pipeline value", format_naira(@stats[:pipeline_value]), "text-info"]
    ].each do |label, value, accent| %>
      <div class="card bg-base-100 shadow"><div class="card-body p-5">
        <p class="text-xs uppercase tracking-wider text-base-content/50"><%= label %></p>
        <p class="text-2xl font-bold <%= accent %> mt-1"><%= value %></p>
      </div></div>
    <% end %>
  </div>

  <!-- Kanban board -->
  <div class="overflow-x-auto pb-2">
    <div class="flex gap-4 min-w-max">
      <% @stages.each do |stage| %>
        <% leads = @leads_by_stage[stage] || [] %>
        <% meta = ContactSubmission::STAGE_META[stage] %>
        <div class="w-72 flex-shrink-0">
          <div class="flex items-center justify-between mb-2 px-1">
            <h2 class="font-semibold text-sm"><%= meta[:label] %></h2>
            <span class="badge badge-ghost badge-sm"><%= leads.size %></span>
          </div>
          <div class="space-y-2">
            <% leads.each do |lead| %>
              <div class="card bg-base-100 shadow-sm border-l-4 <%= meta[:color] %>">
                <div class="card-body p-3">
                  <%= link_to admin_lead_path(lead), class: "font-medium text-sm hover:text-primary" do %><%= lead.name %><% end %>
                  <p class="text-xs text-base-content/60 line-clamp-2"><%= lead.subject.presence || lead.message.truncate(60) %></p>
                  <div class="flex items-center justify-between mt-1">
                    <span class="text-xs text-base-content/40"><%= lead.created_at.strftime("%b %d") %></span>
                    <% if lead.assigned_to %>
                      <span class="badge badge-ghost badge-xs"><%= lead.assigned_to.initials %></span>
                    <% end %>
                  </div>
                  <% if lead.follow_up_on && lead.follow_up_on <= Date.current && !lead.converted? && !lead.lost? %>
                    <span class="text-xs text-warning">⏰ follow-up due</span>
                  <% end %>
                  <details class="dropdown dropdown-end">
                    <summary class="btn btn-ghost btn-xs mt-1">Move ▾</summary>
                    <ul class="dropdown-content menu bg-base-100 rounded-box z-10 w-40 p-1 shadow border border-base-300">
                      <% (@stages - [stage]).each do |target| %>
                        <li><%= button_to ContactSubmission::STAGE_META[target][:label], move_admin_lead_path(lead, stage: target), method: :patch, class: "text-sm" %></li>
                      <% end %>
                    </ul>
                  </details>
                </div>
              </div>
            <% end %>
            <% if leads.empty? %>
              <p class="text-xs text-base-content/30 px-1 py-4 text-center">No leads</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
