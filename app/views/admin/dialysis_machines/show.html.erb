<% content_for(:title, @machine.name) %>

<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Dashboard</a></li>
    <li><a href="<%= admin_dialysis_machines_path %>">Dialysis Machines</a></li>
    <li><%= @machine.name %></li>
  </ul>
</div>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-extrabold"><%= @machine.name %></h1>
  <div class="flex gap-2">
    <%= link_to edit_admin_dialysis_machine_path(@machine), class: "btn btn-ghost btn-sm" do %>
      Edit
    <% end %>
    <%= button_to admin_dialysis_machine_path(@machine), method: :delete, class: "btn btn-error btn-sm",
        data: { turbo_confirm: "Delete '#{@machine.name}'?" } do %>
      Delete
    <% end %>
  </div>
</div>

<div class="card bg-base-100 shadow-xl">
  <div class="card-body">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
      <div class="flex justify-between"><span class="text-base-content/60">Serial Number</span><span class="font-mono"><%= @machine.serial_number %></span></div>
      <div class="flex justify-between"><span class="text-base-content/60">Model</span><span><%= @machine.model.presence || "—" %></span></div>
      <div class="flex justify-between"><span class="text-base-content/60">Manufacturer</span><span><%= @machine.manufacturer.presence || "—" %></span></div>
      <div class="flex justify-between"><span class="text-base-content/60">Status</span><span class="badge badge-sm"><%= @machine.status&.humanize %></span></div>
      <div class="flex justify-between"><span class="text-base-content/60">Last Serviced</span><span><%= @machine.last_serviced_on&.strftime("%b %d, %Y") || "—" %></span></div>
      <div class="flex justify-between"><span class="text-base-content/60">Next Service Due</span><span><%= @machine.next_service_due&.strftime("%b %d, %Y") || "—" %></span></div>
      <% if @machine.notes.present? %>
        <div class="col-span-2"><span class="text-base-content/60 block mb-1">Notes</span><p class="bg-base-200 p-3 rounded-lg"><%= @machine.notes %></p></div>
      <% end %>
    </div>
  </div>
</div>
