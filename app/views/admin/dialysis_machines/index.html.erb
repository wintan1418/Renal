<% content_for(:title, "Dialysis Machines") %>

<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><a href="<%= admin_root_path %>">Dashboard</a></li>
    <li>Dialysis Machines</li>
  </ul>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-extrabold">Dialysis Machines</h1>
  <%= link_to new_admin_dialysis_machine_path, class: "btn btn-primary btn-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    Add Machine
  <% end %>
</div>

<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-0">
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Name</th>
            <th>Serial #</th>
            <th>Model</th>
            <th>Manufacturer</th>
            <th>Status</th>
            <th>Last Serviced</th>
            <th>Next Service Due</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @machines.each do |machine| %>
            <tr class="hover">
              <td class="font-medium"><%= machine.name %></td>
              <td><span class="font-mono text-sm badge badge-ghost"><%= machine.serial_number %></span></td>
              <td class="text-sm text-base-content/70"><%= machine.model.presence || "—" %></td>
              <td class="text-sm text-base-content/70"><%= machine.manufacturer.presence || "—" %></td>
              <td>
                <%
                  status_class = case machine.status
                  when "available" then "badge-success"
                  when "in_use" then "badge-warning"
                  when "maintenance" then "badge-error"
                  when "retired" then "badge-ghost"
                  else "badge-ghost"
                  end
                %>
                <span class="badge <%= status_class %> badge-sm"><%= machine.status&.humanize %></span>
              </td>
              <td class="text-sm">
                <%= machine.last_serviced_on ? machine.last_serviced_on.strftime("%b %d, %Y") : %(<span class="text-base-content/40">—</span>).html_safe %>
              </td>
              <td class="text-sm">
                <% if machine.next_service_due %>
                  <% overdue = machine.next_service_due < Date.current %>
                  <span class="<%= overdue ? 'text-error font-semibold' : '' %>">
                    <%= machine.next_service_due.strftime("%b %d, %Y") %>
                    <% if overdue %><span class="badge badge-error badge-xs ml-1">Overdue</span><% end %>
                  </span>
                <% else %>
                  <span class="text-base-content/40">—</span>
                <% end %>
              </td>
              <td>
                <div class="flex items-center gap-1">
                  <%= link_to edit_admin_dialysis_machine_path(machine), class: "btn btn-ghost btn-xs" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                    </svg>
                    Edit
                  <% end %>
                  <%= button_to admin_dialysis_machine_path(machine), method: :delete, class: "btn btn-ghost btn-xs text-error",
                      data: { turbo_confirm: "Delete '#{machine.name}'? This cannot be undone." } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                    Delete
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @machines.empty? %>
            <tr>
              <td colspan="8" class="text-center py-10 text-base-content/60">
                No dialysis machines configured yet.
                <%= link_to "Add first machine", new_admin_dialysis_machine_path, class: "link link-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mt-6">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>
