<% content_for(:title) { "Quality & Compliance" } %>
<% d = @data %>

<div class="space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">Quality & compliance</h1>
      <p class="text-base-content/60 text-sm mt-1">Renal quality indicators across the practice.</p>
    </div>
    <%= link_to admin_quality_export_path, class: "btn btn-sm btn-primary" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Export PDF
    <% end %>
  </div>

  <!-- Headline KPIs -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <% [
      ["Dialysis adequacy", d[:dialysis][:pct_adequate] ? "#{d[:dialysis][:pct_adequate]}%" : "—", "Kt/V≥1.2 or URR≥65%", "text-success"],
      ["Mean Kt/V", d[:dialysis][:mean_kt_v] || "—", "target ≥ 1.2", "text-primary"],
      ["Appt completion", d[:appointments][:completion_rate] ? "#{d[:appointments][:completion_rate]}%" : "—", "last 90 days", "text-info"],
      ["No-show rate", d[:appointments][:no_show_rate] ? "#{d[:appointments][:no_show_rate]}%" : "—", "last 90 days", "text-warning"]
    ].each do |label, value, sub, accent| %>
      <div class="card bg-base-100 shadow"><div class="card-body p-5">
        <p class="text-xs uppercase tracking-wider text-base-content/50"><%= label %></p>
        <p class="text-2xl font-bold <%= accent %> mt-1"><%= value %></p>
        <p class="text-xs text-base-content/50 mt-1"><%= sub %></p>
      </div></div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Dialysis -->
    <div class="card bg-base-100 shadow"><div class="card-body">
      <h2 class="card-title text-base">Dialysis adequacy</h2>
      <dl class="text-sm divide-y divide-base-200">
        <% {
          "Measured sessions" => d[:dialysis][:measured_sessions],
          "Meeting target" => (d[:dialysis][:pct_adequate] ? "#{d[:dialysis][:pct_adequate]}%" : "—"),
          "Mean Kt/V" => (d[:dialysis][:mean_kt_v] || "—"),
          "Mean URR" => (d[:dialysis][:mean_urr] ? "#{d[:dialysis][:mean_urr]}%" : "—"),
          "Total sessions" => d[:dialysis][:sessions_total]
        }.each do |k, v| %>
          <div class="flex justify-between py-2"><dt class="text-base-content/60"><%= k %></dt><dd class="font-medium"><%= v %></dd></div>
        <% end %>
      </dl>
    </div></div>

    <!-- Labs + access -->
    <div class="card bg-base-100 shadow"><div class="card-body">
      <h2 class="card-title text-base">Labs &amp; vascular access</h2>
      <dl class="text-sm divide-y divide-base-200">
        <% {
          "Lab results (90d)" => d[:labs][:results_90d],
          "Abnormal" => d[:labs][:abnormal],
          "Critical" => d[:labs][:critical],
          "Access points" => d[:access][:total],
          "Functioning" => (d[:access][:pct_functioning] ? "#{d[:access][:pct_functioning]}%" : "—"),
          "Infected" => d[:access][:infected]
        }.each do |k, v| %>
          <div class="flex justify-between py-2"><dt class="text-base-content/60"><%= k %></dt><dd class="font-medium"><%= v %></dd></div>
        <% end %>
      </dl>
    </div></div>
  </div>

  <!-- Population -->
  <div class="card bg-base-100 shadow"><div class="card-body">
    <h2 class="card-title text-base">Population</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-2">
      <% [["Patients", d[:population][:patients]], ["On dialysis", d[:population][:on_dialysis]], ["Transplant waitlist", d[:population][:transplant_waitlist]]].each do |label, v| %>
        <div class="rounded-xl bg-base-200/60 p-4"><p class="text-xl font-bold"><%= v %></p><p class="text-xs text-base-content/60"><%= label %></p></div>
      <% end %>
    </div>
    <% if d[:population][:ckd_stages].present? %>
      <div class="flex flex-wrap gap-2 mt-3">
        <% d[:population][:ckd_stages].each do |stage, n| %>
          <span class="badge badge-outline"><%= stage %>: <%= n %></span>
        <% end %>
      </div>
    <% end %>
  </div></div>
</div>
