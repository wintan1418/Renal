<!DOCTYPE html>
<html lang="en" data-theme="corporate">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-screen bg-base-200">
    <% content_for(:title) { "Healthroom Renal Centre" } unless content_for?(:title) %>

    <div class="min-h-screen bg-base-200 flex flex-col">
      <!-- Top brand -->
      <div class="pt-8 pb-4 flex justify-center">
        <%= link_to root_path, class: "flex items-center gap-3 hover:opacity-80 transition-opacity" do %>
          <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-content" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <div>
            <span class="text-2xl font-bold text-base-content tracking-tight">Healthroom</span>
            <p class="text-xs text-base-content/50 -mt-0.5">Renal Centre</p>
          </div>
        <% end %>
      </div>

      <!-- Flash Messages -->
      <div class="max-w-md mx-auto w-full px-4">
        <%= render "shared/flash" %>
      </div>

      <!-- Centered content card -->
      <div class="flex-1 flex items-start justify-center px-4 pb-8">
        <div class="w-full max-w-md">
          <div class="card bg-base-100 shadow-xl border border-base-200">
            <div class="card-body p-6 sm:p-8">
              <%= yield %>
            </div>
          </div>
        </div>
      </div>

      <!-- Minimal footer -->
      <footer class="pb-6 text-center">
        <p class="text-sm text-base-content/40">
          &copy; <%= Date.current.year %> Healthroom Renal Centre. All rights reserved.
        </p>
        <div class="flex justify-center gap-4 mt-2 text-xs text-base-content/30">
          <a href="#" class="link link-hover">Privacy Policy</a>
          <a href="#" class="link link-hover">Terms of Service</a>
          <%= link_to "Back to Home", root_path, class: "link link-hover" %>
        </div>
      </footer>
    </div>
  </body>
</html>
