<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-screen">
    <% content_for(:title) { "Dashboard" } unless content_for?(:title) %>
    <%
      brand_svg = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>'.html_safe
      ico = ->(d) { ('<svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="' + d + '" /></svg>').html_safe }
    %>

    <div class="drawer lg:drawer-open min-h-screen">
      <input id="dashboard-drawer" type="checkbox" class="drawer-toggle" />

      <!-- ══ Main content ══ -->
      <div class="drawer-content flex min-h-screen flex-col">
        <!-- Top bar -->
        <header class="sticky top-0 z-40 border-b border-base-300/70 bg-base-100/85 backdrop-blur-md">
          <div class="flex h-16 items-center justify-between gap-3 px-4 lg:px-6">
            <div class="flex items-center gap-3">
              <label for="dashboard-drawer" class="btn btn-ghost btn-sm btn-square lg:hidden" aria-label="Open sidebar">
                <%= ico.call("M4 6h16M4 12h16M4 18h16") %>
              </label>
              <div class="hidden sm:block">
                <p class="text-base font-bold text-primary leading-tight"><%= content_for(:title) %></p>
                <p class="text-xs text-base-content/45 leading-tight"><%= current_hospital&.name || "Healthroom Renal Centre" %></p>
              </div>
            </div>

            <!-- Center: Search -->
            <div class="hidden md:flex flex-1 max-w-sm">
              <label class="flex w-full items-center gap-2 rounded-xl border border-base-300 bg-base-200/60 px-3.5 py-2 text-sm transition focus-within:border-secondary focus-within:bg-base-100">
                <%= ico.call("M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z") %>
                <input type="text" placeholder="Search patients, invoices…" class="w-full bg-transparent text-sm outline-none placeholder:text-base-content/40" />
              </label>
            </div>

            <!-- Right: Notifications + User -->
            <div class="flex items-center gap-1.5">
              <%= link_to notifications_path, class: "btn btn-ghost btn-sm btn-square relative", aria: { label: "Notifications" } do %>
                <div class="indicator">
                  <%= ico.call("M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9") %>
                  <% unread_count = current_user.respond_to?(:notifications_received) ? current_user.notifications_received.where(read_at: nil).count : 0 %>
                  <% if unread_count > 0 %>
                    <span class="indicator-item badge badge-accent badge-xs"><%= unread_count > 99 ? "99+" : unread_count %></span>
                  <% end %>
                </div>
              <% end %>

              <!-- User dropdown -->
              <div class="dropdown dropdown-end">
                <label tabindex="0" class="flex cursor-pointer items-center gap-2 rounded-xl px-1.5 py-1 transition hover:bg-base-200">
                  <%= avatar_for(current_user, size: "w-9 h-9", text_size: "text-xs") %>
                  <div class="hidden text-left sm:block">
                    <p class="text-xs font-semibold leading-tight text-base-content"><%= current_user.full_name %></p>
                    <p class="text-[0.7rem] capitalize leading-tight text-base-content/45"><%= current_user.role %></p>
                  </div>
                  <%= ico.call("M19 9l-7 7-7-7") %>
                </label>
                <ul tabindex="0" class="dropdown-content menu w-56 rounded-2xl border border-base-300/70 bg-base-100 p-2 shadow-[var(--shadow-pop)]">
                  <li class="px-3 py-2">
                    <p class="text-sm font-semibold text-base-content"><%= current_user.full_name %></p>
                    <p class="truncate text-xs text-base-content/50"><%= current_user.email %></p>
                  </li>
                  <li class="my-1 border-t border-base-300/70"></li>
                  <li><%= link_to profile_path do %><%= ico.call("M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z") %> Profile<% end %></li>
                  <li><%= link_to destroy_user_session_path, data: { turbo_method: :delete } do %><%= ico.call("M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1") %> Sign Out<% end %></li>
                </ul>
              </div>
            </div>
          </div>
        </header>

        <!-- Page content -->
        <main class="flex-1 p-4 lg:p-6 xl:p-8">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>

      <!-- ══ Sidebar ══ -->
      <div class="drawer-side">
        <label for="dashboard-drawer" class="drawer-overlay" aria-label="Close sidebar"></label>
        <aside class="bg-navy-gradient flex min-h-screen w-72 flex-col">
          <!-- Brand -->
          <div class="flex h-16 items-center gap-3 border-b border-white/10 px-5">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 ring-1 ring-white/15">
              <%= brand_svg %>
            </div>
            <div>
              <p class="text-sm font-bold leading-tight text-white">Healthroom</p>
              <p class="text-[0.7rem] leading-tight text-white/45">Renal Centre</p>
            </div>
          </div>

          <!-- Navigation -->
          <nav class="flex-1 overflow-y-auto px-3 py-4">
            <ul class="space-y-1">
              <% section = ->(label) { content_tag(:li, content_tag(:span, label), class: "px-3 pb-1 pt-5 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-white/35 list-none first:pt-0") } %>

              <%# ===== ADMIN ===== %>
              <% if current_user.admin? %>
                <%= section.call("Main") %>
                <%= sidebar_link(admin_root_path, "Dashboard", match: "/admin/dashboard") { ico.call("M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6") } %>
                <%= sidebar_link(admin_users_path, "Users") { ico.call("M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z") } %>

                <%= section.call("Scheduling") %>
                <%= sidebar_link(admin_appointments_path, "Appointments") { ico.call("M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z") } %>
                <%= sidebar_link(admin_doctor_schedules_path, "Doctor Schedules") { ico.call("M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z") } %>

                <%= section.call("Content") %>
                <%= sidebar_link(admin_departments_path, "Departments") { ico.call("M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4") } %>
                <%= sidebar_link(admin_services_path, "Services") { ico.call("M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z") } %>
                <%= sidebar_link(admin_blog_posts_path, "Blog Posts") { ico.call("M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z") } %>
                <%= sidebar_link(admin_pages_path, "Pages") { ico.call("M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z") } %>
                <%= sidebar_link(admin_testimonials_path, "Testimonials") { ico.call("M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z") } %>

                <%= section.call("Clinical") %>
                <%= sidebar_link(admin_lab_tests_path, "Lab Tests") { ico.call("M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01") } %>
                <%= sidebar_link(admin_visits_path, "Visits") { ico.call("M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z") } %>

                <%= section.call("Dialysis") %>
                <%= sidebar_link(admin_dialysis_machines_path, "Machines") { ico.call("M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18") } %>
                <%= sidebar_link(admin_dialysis_stations_path, "Stations") { ico.call("M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z") } %>
                <%= sidebar_link(admin_dialysis_consumables_path, "Consumables") { ico.call("M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4") } %>

                <%= section.call("Analytics") %>
                <%= sidebar_link(admin_analytics_path, "Analytics") { ico.call("M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z") } %>
                <%= sidebar_link(admin_transplant_waitlist_entries_path, "Transplant Waitlist") { ico.call("M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z") } %>
                <%= sidebar_link(admin_patient_surveys_path, "Patient Surveys") { ico.call("M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z") } %>

                <%= section.call("Communication") %>
                <%= sidebar_link(admin_contact_submissions_path, "Messages") { ico.call("M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z") } %>

              <%# ===== DOCTOR / NURSE ===== %>
              <% elsif current_user.doctor? || current_user.nurse? %>
                <%= section.call("Clinical") %>
                <%= sidebar_link(staff_root_path, "Dashboard", match: "/staff/dashboard") { ico.call("M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6") } %>
                <%= sidebar_link(staff_appointments_path, "Appointments") { ico.call("M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z") } %>
                <%= sidebar_link(staff_doctor_schedules_path, "My Schedule") { ico.call("M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z") } %>
                <%= sidebar_link(staff_patients_path, "Patients") { ico.call("M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z") } %>

                <%= section.call("Dialysis") %>
                <%= sidebar_link(board_staff_dialysis_sessions_path, "Dialysis Board") { ico.call("M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2") } %>
                <%= sidebar_link(staff_dialysis_sessions_path, "Dialysis Sessions") { ico.call("M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z") } %>

              <%# ===== RECEPTIONIST ===== %>
              <% elsif current_user.receptionist? %>
                <%= section.call("Front Desk") %>
                <%= sidebar_link(receptionist_root_path, "Dashboard", match: "/receptionist/dashboard") { ico.call("M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6") } %>
                <%= sidebar_link(receptionist_appointments_path, "Appointments", match: "/receptionist/appointments") { ico.call("M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z") } %>
                <%= sidebar_link(today_receptionist_appointments_path, "Today") { ico.call("M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z") } %>
                <%= sidebar_link(queue_receptionist_appointments_path, "Live Queue") { ico.call("M4 6h16M4 10h16M4 14h16M4 18h16") } %>
                <%= sidebar_link(new_receptionist_appointment_path, "Walk-ins") { ico.call("M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z") } %>

                <%= section.call("Billing") %>
                <%= sidebar_link(receptionist_invoices_path, "Invoices") { ico.call("M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z") } %>
                <%= sidebar_link(receptionist_insurance_claims_path, "Insurance Claims") { ico.call("M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z") } %>

              <%# ===== PATIENT ===== %>
              <% elsif current_user.patient? %>
                <%= section.call("My Health") %>
                <%= sidebar_link(patient_portal_root_path, "Dashboard", match: "/patient_portal/dashboard") { ico.call("M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6") } %>
                <%= sidebar_link(patient_portal_appointments_path, "Appointments") { ico.call("M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z") } %>
                <%= sidebar_link(patient_portal_medical_records_path, "Medical Records") { ico.call("M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z") } %>
                <%= sidebar_link(patient_portal_lab_results_path, "Lab Results") { ico.call("M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01") } %>
                <%= sidebar_link(patient_portal_prescriptions_path, "Prescriptions") { ico.call("M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z") } %>
                <%= sidebar_link(patient_portal_dialysis_history_index_path, "Dialysis History") { ico.call("M13 10V3L4 14h7v7l9-11h-7z") } %>
                <%= sidebar_link(patient_portal_conversations_path, "Messages") { ico.call("M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z") } %>

                <%= section.call("Billing") %>
                <%= sidebar_link(patient_portal_invoices_path, "Invoices") { ico.call("M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z") } %>
                <%= sidebar_link(patient_portal_payments_path, "Payments") { ico.call("M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z") } %>

                <%= section.call("Health Tools") %>
                <%= sidebar_link(patient_portal_diet_logs_path, "Diet & Fluid Tracker") { ico.call("M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2") } %>
                <%= sidebar_link(patient_portal_emergency_contacts_path, "Emergency Contacts") { ico.call("M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z") } %>
              <% end %>
            </ul>
          </nav>

          <!-- Sidebar footer -->
          <div class="border-t border-white/10 p-3">
            <%= link_to root_path, class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-white/60 transition hover:bg-white/[0.06] hover:text-white" do %>
              <%= ico.call("M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9") %>
              Visit Website
            <% end %>
          </div>
        </aside>
      </div>
