<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Schibsted+Grotesk:wght@500;600;700;800;900&family=Spectral:ital,wght@0,600;1,500;1,600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "marketing", "data-turbo-track": "reload" %>
  </head>

  <body class="mk">
    <% content_for(:title) { "Healthroom Renal Centre" } unless content_for?(:title) %>
    <% nav = [["Home", root_path], ["Services", public_services_path], ["Our Doctors", doctors_path], ["About", about_path], ["Blog", blog_posts_path], ["Contact", contact_path]] %>
    <% active = ->(path) { request.path == path || (path != "/" && request.path.start_with?(path)) } %>

    <div data-controller="marketing-booking">
      <!-- ===================== NAV ===================== -->
      <header class="mk-nav">
        <div class="mk-nav__inner">
          <%= link_to root_path, class: "mk-brand" do %>
            <span class="mk-brand__mark"><%= mk_icon :droplet, size: 20, stroke: "#fff", width: 2 %></span>
            <span style="display:flex;flex-direction:column;line-height:1">
              <span class="mk-brand__name">Healthroom</span>
              <span class="mk-brand__sub">Renal Centre</span>
            </span>
          <% end %>

          <nav class="mk-navlinks">
            <% nav.each do |label, path| %>
              <%= link_to label, path, class: class_names("mk-navlink", "is-active" => active.call(path)) %>
            <% end %>
          </nav>

          <div class="mk-nav__actions">
            <% if user_signed_in? %>
              <% dashboard = case current_user.role
                   when "admin" then admin_root_path
                   when "doctor", "nurse" then staff_root_path
                   when "receptionist" then receptionist_root_path
                   else patient_portal_root_path end %>
              <details class="mk-usermenu" style="position:relative">
                <summary style="list-style:none;cursor:pointer;display:flex;align-items:center;gap:8px">
                  <span class="mk-avatar"><%= current_user.initials %></span>
                </summary>
                <div class="mk-glass-card" style="position:absolute;right:0;top:48px;width:220px;padding:8px;z-index:60;border:1px solid var(--mk-line)">
                  <div style="padding:10px 12px"><div style="font-weight:700;font-size:14px;color:var(--mk-ink)"><%= current_user.full_name %></div><div style="font-size:12px;color:var(--mk-muted-2);overflow:hidden;text-overflow:ellipsis"><%= current_user.email %></div></div>
                  <div style="border-top:1px solid var(--mk-line);margin:4px 0"></div>
                  <%= link_to "Dashboard", dashboard, style: "display:block;padding:10px 12px;border-radius:9px;font-size:14px;font-weight:600;color:var(--mk-ink);text-decoration:none" %>
                  <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "mk-navlink", style: "width:100%;text-align:left;padding:10px 12px;background:none;border:none;cursor:pointer" %>
                </div>
              </details>
            <% else %>
              <%= link_to "Sign In", new_user_session_path, class: "mk-nav__signin" %>
            <% end %>
            <button class="mk-btn mk-btn--cta" data-action="marketing-booking#open">Book Appointment</button>
            <button class="mk-burger" data-action="marketing-booking#toggleNav" aria-label="Menu">
              <%= mk_icon :menu, size: 20, stroke: "oklch(0.3 0.03 165)", width: 2 %>
            </button>
          </div>
        </div>
        <div class="mk-mobile-nav" data-marketing-booking-target="mobileNav" hidden>
          <% nav.each do |label, path| %>
            <%= link_to label, path %>
          <% end %>
          <% unless user_signed_in? %>
            <%= link_to "Sign In", new_user_session_path %>
          <% end %>
        </div>
      </header>

      <!-- Flash -->
      <% if flash.any? %>
        <div class="mk-wrap" style="padding-top:18px"><%= render "shared/flash" %></div>
      <% end %>

      <main data-controller="reveal"><%= yield %></main>

      <!-- ===================== FOOTER ===================== -->
      <footer class="mk-footer">
        <div class="mk-footer__grid">
          <div>
            <div style="display:flex;align-items:center;gap:11px;margin-bottom:20px">
              <span class="mk-brand__mark"><%= mk_icon :droplet, size: 20, stroke: "#fff", width: 2 %></span>
              <span style="font-family:var(--mk-display);font-weight:800;font-size:19px;color:#fff">Healthroom Renal Centre</span>
            </div>
            <p style="font-size:14px;line-height:1.65;max-width:300px">Providing world-class kidney care and dialysis services in Nigeria. Your health is our priority — compassionate, expert renal treatment.</p>
          </div>
          <div>
            <div class="mk-footer__head">Quick Links</div>
            <div class="mk-footer__links">
              <%= link_to "About Us", about_path %>
              <%= link_to "Our Services", public_services_path %>
              <%= link_to "Our Doctors", doctors_path %>
              <%= link_to "Blog", blog_posts_path %>
              <%= link_to "Contact Us", contact_path %>
            </div>
          </div>
          <div>
            <div class="mk-footer__head">Services</div>
            <div class="mk-footer__links">
              <%= link_to "Haemodialysis", public_services_path %>
              <%= link_to "Peritoneal Dialysis", public_services_path %>
              <%= link_to "Transplant Evaluation", public_services_path %>
              <%= link_to "Nephrology Consultation", public_services_path %>
              <%= link_to "Nutrition Counselling", public_services_path %>
            </div>
          </div>
          <div>
            <div class="mk-footer__head">Contact Us</div>
            <div class="mk-footer__links" style="gap:13px">
              <div style="display:flex;gap:10px;align-items:flex-start"><span style="color:oklch(0.6 0.1 162)">◷</span><%= current_hospital.address.presence || "15 Medical Drive, Victoria Island" %></div>
              <div style="display:flex;gap:10px;align-items:flex-start"><span style="color:oklch(0.6 0.1 162)">✆</span><%= current_hospital.phone.presence || "+234 800 HEALTH" %></div>
              <div style="display:flex;gap:10px;align-items:flex-start"><span style="color:oklch(0.6 0.1 162)">✉</span><%= current_hospital.email.presence || "info@healthroom.ng" %></div>
              <div style="display:flex;gap:10px;align-items:flex-start"><span style="color:oklch(0.6 0.1 162)">◔</span>Mon – Sat: 8:00 AM – 6:00 PM</div>
            </div>
          </div>
        </div>
        <div class="mk-footer__bar">
          <span>© <%= Date.current.year %> Healthroom Renal Centre. All rights reserved.</span>
          <span style="display:flex;gap:20px"><a href="#">Privacy Policy</a><a href="#">Terms of Service</a></span>
        </div>
      </footer>

      <!-- ===================== BOOKING MODAL ===================== -->
      <%= render "shared/booking_modal" %>
    </div>
  </body>
</html>
